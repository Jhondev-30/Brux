---
import MainLayout from "../../layouts/MainLayout.astro";
import { bookingUrl } from "../../data/site";
---

<MainLayout
  title="Speaker Content: Demo Reel, Clips and LinkedIn Posts | Brux"
  description="Demo reel, press kit, LinkedIn posts and edited clips from your talks, so organizers see how you sound on stage before they book you."
>
  <section>
    <h1>Content for speakers: demo reel, clips and posts</h1>
    <p>
      Organizers want to see how you sound on stage before they book you. We turn your talks into
      the material that shows it.
    </p>
    <a href={bookingUrl} target="_blank" rel="noopener">Book a call</a>
  </section>

  <section>
    <h2>Speaker demo reel and press kit</h2>
    <p>Included in every plan. They go with every pitch we send to organizers.</p>
  </section>

  <section>
    <h2>Video editing of your talks</h2>
    <p>We edit your talks into short videos for LinkedIn. Included in the Growth and Complete plans.</p>
  </section>

  <section>
    <h2>LinkedIn posts</h2>
    <p>From 2 posts a month on Founder and Foundation, to 4 on Growth and 8 on Complete.</p>
    <a href="/pricing/">See plans</a>
  </section>
</MainLayout>
