---
import MainLayout from "../../layouts/MainLayout.astro";
import { bookingUrl } from "../../data/site";

// Contenido del PDF de servicios del 20 de octubre de 2026.
// Precio confirmado por Jhon el 14 nov 2026: desde $1,100, pago único; cambia según lo que necesite la web.
---

<MainLayout
  title="Speaker Website Design | Brux"
  description="A speaker website organizers can check in one link: bio, topics, demo reel, past events and a way to book you. From $1,100, one-time."
>
  <section>
    <h1>Speaker website design</h1>
    <p>
      When an organizer is considering you, they need one link that answers their questions quickly.
      For speakers who don't have a website yet.
    </p>
    <a href={bookingUrl} target="_blank" rel="noopener">Book a call</a>
  </section>

  <section>
    <h2>What your speaker website includes</h2>
    <ul>
      <li>Your bio and speaking topics, clearly stated</li>
      <li>Your best clips and video of you on stage</li>
      <li>Events and podcasts you've been on, and what people said</li>
      <li>A downloadable one-sheet or speaker kit</li>
      <li>A simple way for organizers to contact you</li>
    </ul>
  </section>

  <section>
    <h2>The link behind every pitch</h2>
    <p>It's the link we use in every post, message and pitch we send for you.</p>
  </section>

  <section>
    <h2>Pricing</h2>
    <p>
      From <strong>$1,100</strong>, one-time. The final price depends on what your site needs;
      we quote it after a short call.
    </p>
    <a href="/contact/">Get a quote</a>
  </section>
</MainLayout>
