---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import MainLayout from "../../layouts/MainLayout.astro";

// Artículos de src/content/blog/, del más reciente al más antiguo.
// El más reciente va destacado a todo el ancho; los demás, en dos columnas debajo.
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [latest, ...rest] = posts;

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<MainLayout
  title="How Paid Keynotes Get Booked: Blog for Keynote Speakers | Brux"
  description="What event organizers ask for when we pitch keynote speakers, and what gets them booked. A new article every other week."
>
  <section class="blog-top bg-stage-ink pb-24 sm:pb-32" aria-labelledby="blog-title">
    <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
      <h1
        id="blog-title"
        class="max-w-[44rem] text-[clamp(2.25rem,1.6rem+2.8vw,4rem)] font-extrabold leading-[1.04] tracking-[-0.02em] text-balance text-paper"
      >
        How paid keynotes get booked
      </h1>
      <p class="mt-6 max-w-[38rem] text-[clamp(1.0625rem,1rem+0.25vw,1.1875rem)] leading-relaxed text-muted-on-ink">
        What event organizers ask for when we pitch keynote speakers, and what gets them booked. A new article every other week.
      </p>

      {latest && (
        <a
          href={`/blog/${latest.id}/`}
          class="group mt-16 grid gap-8 border-t border-paper/10 pt-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-14"
        >
          <div class="overflow-hidden rounded-md ring-1 ring-paper/10">
            <Image
              src={latest.data.cover}
              alt=""
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              loading="eager"
              class="w-full transition-transform duration-500 ease-out group-hover:scale-[1.02]"
            />
          </div>
          <div>
            <p class="text-sm text-muted-on-ink">
              <time datetime={latest.data.pubDate.toISOString()}>{fmt(latest.data.pubDate)}</time> · {latest.data.author}
            </p>
            <h2 class="mt-3 text-[clamp(1.625rem,1.3rem+1.4vw,2.5rem)] leading-[1.1] font-extrabold tracking-[-0.02em] text-balance text-paper transition-colors duration-150 group-hover:text-stage-glow">
              {latest.data.title}
            </h2>
            <p class="mt-4 max-w-[30rem] leading-relaxed text-muted-on-ink">{latest.data.description}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-paper">
              Read the article
              <svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform duration-150 group-hover:translate-x-1">
                <path d="M2.5 8h10M8.5 4l4 4-4 4" />
              </svg>
            </span>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <ul class="mt-20 grid gap-12 border-t border-paper/10 pt-12 md:grid-cols-2">
          {rest.map((post) => (
            <li>
              <a href={`/blog/${post.id}/`} class="group block">
                <div class="overflow-hidden rounded-md ring-1 ring-paper/10">
                  <Image
                    src={post.data.cover}
                    alt=""
                    widths={[640, 960]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    class="w-full transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                  />
                </div>
                <p class="mt-6 text-sm text-muted-on-ink">
                  <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time> · {post.data.author}
                </p>
                <h2 class="mt-2 text-[clamp(1.375rem,1.15rem+1vw,2rem)] leading-tight font-extrabold tracking-[-0.02em] text-balance text-paper transition-colors duration-150 group-hover:text-stage-glow">
                  {post.data.title}
                </h2>
                <p class="mt-3 max-w-[34rem] leading-relaxed text-muted-on-ink">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</MainLayout>

<style>
  /*
    Espacio para el nav fijo: su alto (3.5rem) + su separación del borde (1rem) + aire.
    Con un valor mínimo en rem para que el título nunca quede debajo de la barra, ni con zoom.
  */
  .blog-top {
    padding-top: max(9rem, calc(4.5rem + 8svh));
  }
</style>
