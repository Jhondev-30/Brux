---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";
import MainLayout from "../../layouts/MainLayout.astro";
import StageFinalCta from "../../components/ui/StageFinalCta.astro";

// Artículos de src/content/blog/, del más reciente al más antiguo.
// El más reciente va destacado a todo el ancho; los demás, en dos columnas debajo.
const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const [latest, ...rest] = posts;

const fmt = (d: Date) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

const siteUrl = Astro.site ? Astro.site.origin : "https://www.brux.site";
const blogTitle = "Paid Keynotes Blog for Keynote Speakers | Brux";
const blogDescription =
  "Learn how event organizers book keynote speakers, why calls for speakers fail, and how direct outreach and LinkedIn win paid stages.";

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${siteUrl}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${siteUrl}/blog` },
  ],
};

const blogCollectionSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "@id": `${siteUrl}/blog#blog`,
  url: `${siteUrl}/blog`,
  name: blogTitle,
  description: blogDescription,
  isPartOf: { "@id": `${siteUrl}/#website` },
  publisher: { "@id": `${siteUrl}/#organization` },
  blogPost: posts.map((p) => ({
    "@type": "BlogPosting",
    headline: p.data.title,
    url: `${siteUrl}/blog/${p.id}/`,
    datePublished: p.data.pubDate.toISOString(),
    author: { "@type": "Person", name: p.data.author },
  })),
};
---

<MainLayout title={blogTitle} description={blogDescription} canonical="/blog">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(blogCollectionSchema)} />
  </Fragment>
  <section
    class="bg-ink pt-[max(9rem,calc(4.5rem+8svh))] pb-24 sm:pb-32"
    aria-labelledby="blog-title"
    data-blog
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
      <h1
        id="blog-title"
        class="max-w-[44rem] text-[clamp(2.25rem,1.6rem+2.8vw,4rem)] leading-[1.04] font-extrabold tracking-[-0.02em] text-balance text-paper"
        data-blog-title
      >
        How paid keynotes get booked
      </h1>
      <p class="mt-6 max-w-[38rem] text-[clamp(1.0625rem,1rem+0.25vw,1.1875rem)] leading-relaxed text-muted-on-ink" data-blog-lead>
        What event organizers ask for when we pitch keynote speakers, and what gets them booked. A new article every other week.
      </p>

      {latest && (
        <a
          href={`/blog/${latest.id}/`}
          class="group mt-16 grid gap-8 border-t border-paper/10 pt-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:items-center lg:gap-14 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
          data-blog-card
        >
          <div class="overflow-hidden rounded-md ring-1 ring-paper/10" data-blog-media>
            <Image
              src={latest.data.cover}
              alt={latest.data.title}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 58vw, 100vw"
              loading="eager"
              class="w-full will-change-transform"
              data-blog-img
            />
          </div>
          <div>
            <p class="text-sm text-muted-on-ink">
              <time datetime={latest.data.pubDate.toISOString()}>{fmt(latest.data.pubDate)}</time> · {latest.data.author}
            </p>
            <h2 class="mt-3 text-[clamp(1.625rem,1.3rem+1.4vw,2.5rem)] leading-[1.1] font-extrabold tracking-[-0.02em] text-balance text-paper transition-colors duration-150 group-hover:text-stage-glow">
              {latest.data.title}
            </h2>
            <p class="mt-4 max-w-[30rem] leading-relaxed text-muted-on-ink">{latest.data.description}</p>
            <span class="mt-6 inline-flex items-center gap-2 font-semibold text-paper">
              <span>Read the article</span>
              <span class="inline-flex shrink-0 will-change-transform" data-blog-arrow-wrap>
                <MorphIcon
                  icon={ArrowRight}
                  size={16}
                  strokeWidth={2}
                  spring="snappy"
                  reducedMotion="user"
                  data-blog-arrow
                />
              </span>
            </span>
          </div>
        </a>
      )}

      {rest.length > 0 && (
        <ul class="mt-20 grid gap-12 border-t border-paper/10 pt-12 md:grid-cols-2" data-blog-rest>
          {rest.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}/`}
                class="group block focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
                data-blog-card
                data-blog-rest-card
              >
                <div class="overflow-hidden rounded-md ring-1 ring-paper/10" data-blog-media>
                  <Image
                    src={post.data.cover}
                    alt={post.data.title}
                    widths={[640, 960]}
                    sizes="(min-width: 768px) 50vw, 100vw"
                    class="w-full will-change-transform"
                    data-blog-img
                  />
                </div>
                <p class="mt-6 text-sm text-muted-on-ink">
                  <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time> · {post.data.author}
                </p>
                <h2 class="mt-2 text-[clamp(1.375rem,1.15rem+1vw,2rem)] leading-tight font-extrabold tracking-[-0.02em] text-balance text-paper transition-colors duration-150 group-hover:text-stage-glow">
                  {post.data.title}
                </h2>
                <p class="mt-3 max-w-[34rem] leading-relaxed text-muted-on-ink">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <!-- CLOSING CTA (bg-stage) -->
  <StageFinalCta
    headingId="blog-cta-title"
    title="Ready to pitch paid stages directly?"
    description="Tell us your keynote topics and recent talks on a 20 minute call, and we will map the organizers in your niche."
    primaryLabel="Book a strategy call"
    secondaryLabel="See plans & pricing"
    secondaryHref="/pricing"
  />
</MainLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { ArrowRight, ArrowUpRight, type IconNode } from "lucide";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  let mm: gsap.MatchMedia | null = null;
  let cleanupCards: (() => void) | null = null;

  function initBlogIndex() {
    const root = document.querySelector<HTMLElement>("[data-blog]");
    if (!root) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    root.querySelectorAll<HTMLElement>("[data-blog-card]").forEach((card) => {
      const img = card.querySelector<HTMLElement>("[data-blog-img]");
      const arrowWrap = card.querySelector<HTMLElement>("[data-blog-arrow-wrap]");
      const arrowIcon = card.querySelector<MorphEl>("[data-blog-arrow]");
      const zoom = img ? gsap.quickTo(img, "scale", { duration: 0.6, ease: "power3.out" }) : null;
      const nudgeX = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.24, ease: "power3.out" }) : null;

      const onEnter = () => {
        arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) {
          zoom?.(1.025);
          nudgeX?.(4);
        }
      };
      const onLeave = () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) {
          zoom?.(1);
          nudgeX?.(0);
        }
      };

      card.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      card.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      card.addEventListener("focus", onEnter, { signal });
      card.addEventListener("blur", onLeave, { signal });
    });

    cleanupCards = () => controller.abort();

    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const title = root.querySelector<HTMLElement>("[data-blog-title]");
        const lead = root.querySelector<HTMLElement>("[data-blog-lead]");
        const cards = root.querySelectorAll<HTMLElement>("[data-blog-card]:not([data-blog-rest-card])");
        const restCards = root.querySelectorAll<HTMLElement>("[data-blog-rest-card]");

        if (title) {
          SplitText.create(title, {
            type: "words",
            mask: "words",
            autoSplit: true,
            onSplit: (self) => {
              const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
              tl.from(self.words, {
                yPercent: 112,
                rotation: 6,
                transformOrigin: "0% 100%",
                duration: 0.95,
                stagger: 0.045,
              });
              if (lead) tl.from(lead, { y: 18, autoAlpha: 0, duration: 0.85 }, 0.22);
              if (cards.length) {
                tl.from(cards, { y: 32, autoAlpha: 0, duration: 0.9, stagger: 0.08, clearProps: "transform,opacity,visibility" }, 0.35);
              }
              return tl;
            },
          });
        }

        if (restCards.length) {
          gsap.from(restCards, {
            y: 28,
            autoAlpha: 0,
            duration: 0.85,
            stagger: 0.1,
            ease: "expo.out",
            clearProps: "transform,opacity,visibility",
            scrollTrigger: { trigger: restCards[0], start: "top 84%", once: true },
          });
        }
      }, root);
      return () => ctx.revert();
    });
  }

  document.addEventListener("astro:page-load", initBlogIndex);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanupCards?.();
    cleanupCards = null;
  });
</script>
