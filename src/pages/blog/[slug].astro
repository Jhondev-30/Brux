---
import { getCollection, render } from "astro:content";
import { ArrowLeft } from "lucide";
import MorphIcon from "morphicons/astro";
import MainLayout from "../../layouts/MainLayout.astro";
import StageFinalCta from "../../components/ui/StageFinalCta.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = new URL(`/blog/${post.id}`, Astro.site);

const fmt = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: `${Astro.site?.origin ?? "https://www.brux.site"}/` },
    { "@type": "ListItem", position: 2, name: "Blog", item: `${Astro.site?.origin ?? "https://www.brux.site"}/blog` },
    { "@type": "ListItem", position: 3, name: d.title, item: url.href },
  ],
};

// BlogPosting: autor, fecha e imagen para Google y los buscadores con IA
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  image: new URL(d.cover.src, Astro.site).href,
  mainEntityOfPage: url.href,
  author: { "@type": "Person", name: d.author, ...(d.authorUrl && { url: d.authorUrl }) },
  publisher: { "@type": "Organization", name: "Brux", url: Astro.site?.href },
};
---

<MainLayout title={`${d.title} | Brux`} description={d.description} ogType="article" canonical={`/blog/${post.id}`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <article class="bg-ink pt-[max(9rem,calc(4.5rem+8svh))] pb-24 sm:pb-32" data-blog-post>
    <header class="mx-auto max-w-[46rem] px-4 sm:px-8">
      <a
        href="/blog"
        class="-ml-1 inline-flex min-h-11 items-center gap-2 rounded-[3px] px-1 text-sm font-semibold text-muted-on-ink transition-colors duration-150 hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stage"
        data-blog-back
      >
        <span class="inline-flex shrink-0 will-change-transform" data-blog-back-arrow-wrap>
          <MorphIcon
            icon={ArrowLeft}
            size={16}
            strokeWidth={2}
            spring="snappy"
            reducedMotion="user"
            data-blog-back-arrow
          />
        </span>
        <span>All articles</span>
      </a>
      <h1 class="mt-8 text-[clamp(2.25rem,1.6rem+2.8vw,3.75rem)] leading-[1.04] font-extrabold tracking-[-0.02em] text-balance text-paper" data-post-title>
        {d.title}
      </h1>
      <p class="mt-6 text-muted-on-ink" data-post-meta>
        By {d.authorUrl ? (
          <a href={d.authorUrl} target="_blank" rel="noopener" class="font-semibold text-paper underline-offset-4 hover:underline">{d.author}</a>
        ) : (
          <span class="font-semibold text-paper">{d.author}</span>
        )}, cofounder of Brux · <time datetime={d.pubDate.toISOString()}>{fmt(d.pubDate)}</time>
      </p>
      <div class="mt-10 h-px origin-left bg-paper/10" aria-hidden="true" data-post-rule></div>
    </header>

    <!-- La portada repite el título, así que aquí no se muestra: va en el índice del blog y en el schema -->
    <div
      class="mx-auto mt-12 max-w-[46rem] px-4 text-[clamp(1.0625rem,1rem+0.3vw,1.1875rem)] leading-[1.75] text-paper/88 sm:px-8 [&_a]:text-paper [&_a]:underline [&_a]:underline-offset-4 [&_h2]:mt-[2.4em] [&_h2]:mb-[0.8em] [&_h2]:text-[clamp(1.5rem,1.3rem+0.8vw,2rem)] [&_h2]:leading-[1.15] [&_h2]:font-extrabold [&_h2]:tracking-[-0.02em] [&_h2]:text-paper [&_p+p]:mt-[1.4em] [&_p:last-child]:font-semibold [&_p:last-child]:text-paper"
      data-post-body
    >
      <Content />
    </div>

    {d.linkedinUrl && (
      <footer class="mx-auto mt-16 max-w-[46rem] px-4 sm:px-8">
        <p class="border-t border-paper/10 pt-8 text-muted-on-ink">
          First published in our LinkedIn newsletter,{" "}
          <a href={d.linkedinUrl} target="_blank" rel="noopener" class="font-semibold text-paper underline decoration-paper/30 underline-offset-4 hover:decoration-paper">
            How Paid Keynotes Get Booked
          </a>.
        </p>
      </footer>
    )}
  </article>

  <!-- CLOSING CTA (bg-stage) -->
  <StageFinalCta
    headingId="post-cta-title"
    title="Want us to pitch you to organizers directly?"
    description="Every month we write to the organizers who book speakers in your niche. Tell us your topic on a short call."
    primaryLabel="Book a call"
    secondaryLabel="See all articles"
    secondaryHref="/blog"
  />
</MainLayout>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { ArrowLeft, ChevronLeft, type IconNode } from "lucide";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  let cleanup: (() => void) | null = null;
  let mm: gsap.MatchMedia | null = null;

  function initBlogPost() {
    mm?.revert();
    mm = null;
    cleanup?.();
    cleanup = null;

    const article = document.querySelector<HTMLElement>("[data-blog-post]");
    const back = document.querySelector<HTMLElement>("[data-blog-back]");
    if (!article || !back) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const arrowWrap = back.querySelector<HTMLElement>("[data-blog-back-arrow-wrap]");
    const arrowIcon = back.querySelector<MorphEl>("[data-blog-back-arrow]");
    const nudgeX = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.22, ease: "power3.out" }) : null;

    const onEnter = () => {
      arrowIcon?.morphTo?.(ChevronLeft);
      if (!reduce.matches) nudgeX?.(-3);
    };
    const onLeave = () => {
      arrowIcon?.morphTo?.(ArrowLeft);
      if (!reduce.matches) nudgeX?.(0);
    };

    back.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
    back.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
    back.addEventListener("focus", onEnter, { signal });
    back.addEventListener("blur", onLeave, { signal });

    cleanup = () => controller.abort();

    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const title = article.querySelector<HTMLElement>("[data-post-title]");
        const meta = article.querySelector<HTMLElement>("[data-post-meta]");
        const rule = article.querySelector<HTMLElement>("[data-post-rule]");
        const body = article.querySelector<HTMLElement>("[data-post-body]");

        if (title) {
          SplitText.create(title, {
            type: "words",
            mask: "words",
            autoSplit: true,
            onSplit: (self) => {
              const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
              tl.from(back, { x: -14, autoAlpha: 0, duration: 0.55, clearProps: "transform,opacity,visibility" }, 0)
                .from(self.words, { yPercent: 112, rotation: 5, transformOrigin: "0% 100%", duration: 0.9, stagger: 0.04 }, 0.06);
              if (meta) tl.from(meta, { y: 12, autoAlpha: 0, duration: 0.7, clearProps: "transform,opacity,visibility" }, 0.25);
              if (rule) tl.from(rule, { scaleX: 0, duration: 0.85, ease: "power3.inOut", clearProps: "transform" }, 0.28);
              return tl;
            },
          });
        }

        if (body) {
          body.querySelectorAll<HTMLElement>("h2").forEach((h2) => {
            gsap.from(h2, {
              x: -18,
              autoAlpha: 0,
              duration: 0.72,
              ease: "expo.out",
              clearProps: "transform,opacity,visibility",
              scrollTrigger: { trigger: h2, start: "top 86%", once: true },
            });
          });
        }
      }, article);

      return () => ctx.revert();
    });
  }

  initBlogPost();
  document.addEventListener("astro:page-load", initBlogPost);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanup?.();
    cleanup = null;
  });
</script>
