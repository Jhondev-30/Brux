---
import { Check as LucideCheck, Minus as LucideMinus } from "@lucide/astro";
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";
import { comparisonCategories, pricingTiers } from "../../data/pricing";

const categoryMeta: Record<string, { summary: string; href: string; linkLabel: string }> = {
  "booking-outreach": {
    summary: "Direct research, bespoke pitches, press kit, demo reel, and live CRM visibility for every stage we target.",
    href: "/services/booking",
    linkLabel: "Explore speaker booking",
  },
  "linkedin-content": {
    summary: "Profile positioning, consistent posts, organizer network growth, talk video clips, and outreach in your name.",
    href: "/services/linkedin",
    linkLabel: "Explore LinkedIn growth",
  },
  "reporting-terms": {
    summary: "Monthly reporting, 0% fee commission across every tier, and clear monthly terms.",
    href: "#faq",
    linkLabel: "Read contract FAQs",
  },
};
---

<section
  id="compare"
  class="scroll-mt-24 bg-paper py-20 text-ink sm:py-28"
  aria-labelledby="compare-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <div class="max-w-[42rem]">
      <h2
        id="compare-title"
        class="text-[clamp(1.75rem,1.4rem+1.5vw,2.625rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-balance"
      >
        Compare our plans by area
      </h2>
      <p class="mt-3 text-base leading-relaxed text-muted">
        Three focused tables covering booking, LinkedIn &amp; content, and terms so you can always see which plan each row belongs to.
      </p>
    </div>

    <div class="mt-12 grid gap-10">
      {comparisonCategories.map((cat) => {
        const meta = categoryMeta[cat.id];
        return (
          <div class="grid gap-6 border-t border-ink/10 pt-8 lg:grid-cols-12 lg:items-start lg:gap-8">
            <!-- Columna izquierda: explica qué cubre este bloque de servicio -->
            <div class="lg:col-span-4">
              <h3 class="text-xl font-extrabold tracking-[-0.02em] text-ink">{cat.title}</h3>
              {meta && (
                <>
                  <p class="mt-2 text-sm leading-relaxed text-muted">{meta.summary}</p>
                  <a
                    href={meta.href}
                    class="group/clink mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-stage-text transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
                  >
                    <span>{meta.linkLabel}</span>
                    <span class="inline-flex shrink-0 transition-transform duration-150 group-hover/clink:translate-x-0.5" aria-hidden="true">
                      <MorphIcon icon={ArrowRight} size={14} strokeWidth={2.2} spring="snappy" reducedMotion="user" />
                    </span>
                  </a>
                </>
              )}
            </div>

            <!-- Columna derecha: mini-tabla compacta (3–6 filas) con su propia cabecera fija en el bloque (sin sticky) -->
            <div class="overflow-x-auto rounded-[16px] border border-ink/12 bg-paper lg:col-span-8">
              <table class="w-full min-w-[540px] border-collapse text-left">
                <caption class="sr-only">
                  {cat.title} comparison across Founder, Growth, and Complete plans
                </caption>
                <thead>
                  <tr class="border-b border-ink/12 bg-paper">
                    <th scope="col" class="w-[46%] px-4 py-3 text-xs font-bold text-muted sm:px-5">
                      Included deliverable
                    </th>
                    {pricingTiers.map((t) => (
                      <th
                        scope="col"
                        class:list={[
                          "w-[18%] px-2.5 py-3 text-center align-bottom",
                          t.featured && "border-t-2 border-t-stage-text bg-stage-text/[0.06]",
                        ]}
                      >
                        <span
                          class:list={[
                            "block text-xs font-extrabold tracking-[-0.01em]",
                            t.featured ? "text-stage-text" : "text-ink",
                          ]}
                        >
                          {t.name}
                        </span>
                        <span
                          class:list={[
                            "block text-[0.75rem] font-semibold tabular-nums",
                            t.featured ? "text-ink" : "text-muted",
                          ]}
                        >
                          {t.price !== null ? `${t.priceLabel}/mo` : t.priceLabel}
                        </span>
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {cat.rows.map((row, idx) => (
                    <tr
                      class:list={[
                        "transition-colors duration-150 hover:bg-mist/55",
                        idx < cat.rows.length - 1 && "border-b border-ink/8",
                      ]}
                    >
                      <th scope="row" class="px-4 py-2.5 text-[0.875rem] leading-snug font-medium text-ink sm:px-5">
                        <span>{row.label}</span>
                        {row.note && (
                          <span class="mt-0.5 block text-xs font-normal text-muted">{row.note}</span>
                        )}
                      </th>
                      {pricingTiers.map((tier) => {
                        const cell = row.values[tier.id];
                        return (
                          <td
                            class:list={[
                              "px-2.5 py-2.5 text-center text-[0.875rem]",
                              tier.featured && "bg-stage-text/[0.06]",
                            ]}
                          >
                            {cell === true ? (
                              <span class="inline-flex items-center justify-center text-ink" aria-label="Included">
                                <LucideCheck class="size-4 text-stage-text" stroke-width={2.5} aria-hidden="true" />
                              </span>
                            ) : cell === false ? (
                              <span class="inline-flex items-center justify-center text-ink/25" aria-label="Not included">
                                <LucideMinus class="size-3.5" stroke-width={2} aria-hidden="true" />
                              </span>
                            ) : (
                              <span class="font-bold text-ink tabular-nums">{cell}</span>
                            )}
                          </td>
                        );
                      })}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
