---
import { ArrowDown as LucideArrowDown } from "@lucide/astro";
import { websiteAddon } from "../../data/pricing";
import { bookingUrl } from "../../data/site";
import WebsiteOfferCard from "../ui/WebsiteOfferCard.astro";
---

<section
  id="website"
  class="scroll-mt-24 bg-mist py-20 text-ink sm:py-28"
  aria-labelledby="website-addon-title"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <WebsiteOfferCard
      headingId="website-addon-title"
      title={websiteAddon.title}
      description={websiteAddon.description}
      items={websiteAddon.includes.map((label) => ({ title: label }))}
      price={websiteAddon.price}
      priceSuffix="flat fee"
      primaryHref={bookingUrl}
      primaryLabel="Get a website quote"
      secondaryHref="/services/web-design"
      secondaryLabel="Explore speaker websites"
    />

    <!-- Puente hacia los ejemplos reales de contenido de los planes más abajo -->
    <div class="mt-10 flex flex-col items-start justify-between gap-4 border-t border-ink/10 pt-8 sm:flex-row sm:items-center">
      <p class="max-w-[42rem] text-base leading-relaxed text-muted">
        Want to see what our team builds inside each plan? Below you'll find real examples of our organizer pitches, press kit, demo reel, and monthly reports.
      </p>
      <a
        href="#included"
        class="inline-flex shrink-0 items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition-colors hover:bg-stage focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stage"
      >
        <span>See plan examples below</span>
        <LucideArrowDown class="size-4" aria-hidden="true" />
      </a>
    </div>
  </div>
</section>
