---
import { Image } from "astro:assets";
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";
import report from "../../assets/plans/monthly-report.webp";
import { deliverableExplainers } from "../../data/pricing";

const toneBadge = {
  all: "bg-paper/10 text-paper/90 border border-paper/15",
  custom: "bg-stage-text text-paper border border-stage-text",
};
---

<section
  id="included"
  class="scroll-mt-24 bg-ink-raised py-24 text-paper sm:py-32"
  aria-labelledby="included-title"
  data-deliverables
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-[44rem]">
        <h2
          id="included-title"
          class="text-[clamp(1.875rem,1.45rem+1.8vw,3rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-balance"
        >
          What's inside every plan
        </h2>
        <p class="mt-4 text-base leading-relaxed text-muted-on-ink sm:text-lg">
          No vague agency retainers. Here is exactly what our team builds, sends, and tracks for you every month.
        </p>
      </div>
      <a
        href="#compare"
        class="inline-flex shrink-0 items-center gap-1.5 text-sm font-semibold text-stage-glow transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
      >
        <span>Compare plans side by side</span>
      </a>
    </div>

    <div class="mt-14 grid gap-x-10 gap-y-14 border-t border-paper/10 pt-12 lg:grid-cols-2 lg:gap-x-14 lg:gap-y-16">
      {deliverableExplainers.map((item) => (
        <article class="flex flex-col scroll-mt-28" id={item.id} data-deliv-card>
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h3 class="text-[clamp(1.25rem,1.1rem+0.6vw,1.625rem)] leading-tight font-extrabold tracking-[-0.02em] text-paper">
              {item.title}
            </h3>
            <span
              class:list={[
                "inline-flex items-center rounded-full px-3 py-1 text-xs font-bold whitespace-nowrap",
                toneBadge[item.availabilityTone],
              ]}
            >
              {item.availability}
            </span>
          </div>

          <p class="mt-4 text-[0.9375rem] leading-relaxed text-paper/85 sm:text-base">
            {item.description}
          </p>

          <ul class="mt-4 grid gap-2 text-sm leading-relaxed text-muted-on-ink">
            {item.details.map((detail) => (
              <li class="flex items-start gap-2.5">
                <span class="mt-2 size-1.5 shrink-0 rounded-full bg-stage-glow" aria-hidden="true" />
                <span>{detail}</span>
              </li>
            ))}
          </ul>

          {item.visual === "pitch" && (
            <div class="mt-6 aspect-video overflow-hidden rounded-[14px] bg-ink ring-1 ring-paper/10" data-deliv-visual>
              <img
                src="/videos/how/step-3-poster.webp"
                alt="Direct personal pitch and outreach workflow to event organizers"
                width="1280"
                height="720"
                loading="lazy"
                class="size-full object-cover will-change-transform"
                data-deliv-img
              />
            </div>
          )}

          {item.visual === "presskit" && (
            <div class="mt-6 aspect-video overflow-hidden rounded-[14px] bg-ink ring-1 ring-paper/10" data-deliv-visual>
              <img
                src="/videos/how/step-2-poster.webp"
                alt="Speaker press kit and demo reel packaged for event organizers"
                width="1280"
                height="720"
                loading="lazy"
                class="size-full object-cover will-change-transform"
                data-deliv-img
              />
            </div>
          )}

          {item.visual === "report" && (
            <div class="mt-6 aspect-video overflow-hidden rounded-[14px] bg-ink ring-1 ring-paper/10" data-deliv-visual>
              <Image
                src={report}
                alt="A Brux monthly report: keynotes booked, LinkedIn followers and post impressions"
                widths={[640, 960]}
                sizes="(min-width: 1024px) 560px, 92vw"
                loading="lazy"
                class="size-full object-cover will-change-transform"
                data-deliv-img
              />
            </div>
          )}

          {item.linkHref && item.linkLabel && (
            <div class="mt-5">
              <a
                href={item.linkHref}
                class="group/dlink inline-flex items-center gap-2 text-sm font-semibold text-stage-glow transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
                data-deliv-link
              >
                <span>{item.linkLabel}</span>
                <span class="inline-flex shrink-0 will-change-transform" data-deliv-arrow-wrap>
                  <MorphIcon
                    icon={ArrowRight}
                    size={15}
                    strokeWidth={2}
                    spring="snappy"
                    reducedMotion="user"
                    data-deliv-arrow
                  />
                </span>
              </a>
            </div>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ArrowRight, ArrowUpRight, type IconNode } from "lucide";

  gsap.registerPlugin(ScrollTrigger);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  let mm: gsap.MatchMedia | null = null;
  let cleanupLinks: (() => void) | null = null;

  function initDeliverables() {
    cleanupLinks?.();
    const root = document.querySelector<HTMLElement>("[data-deliverables]");
    if (!root) return;

    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        root.querySelectorAll<HTMLElement>("[data-deliv-visual]").forEach((frame) => {
          const img = frame.querySelector<HTMLElement>("[data-deliv-img]");
          const tl = gsap.timeline({
            scrollTrigger: { trigger: frame, start: "top 85%", once: true },
          });
          tl.fromTo(
            frame,
            { clipPath: "inset(0% 100% 0% 0%)" },
            { clipPath: "inset(0% 0% 0% 0%)", duration: 0.95, ease: "power4.inOut", clearProps: "clipPath" },
          );
          if (img) {
            tl.from(img, { scale: 1.07, duration: 1.15, ease: "expo.out", clearProps: "scale" }, 0);
          }
        });
      }, root);

      return () => ctx.revert();
    });

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    root.querySelectorAll<HTMLElement>("[data-deliv-visual]").forEach((frame) => {
      const img = frame.querySelector<HTMLElement>("[data-deliv-img]");
      if (!img) return;
      const zoom = gsap.quickTo(img, "scale", { duration: 0.55, ease: "power3.out" });
      frame.addEventListener("pointerenter", (e) => !reduce.matches && e.pointerType === "mouse" && zoom(1.025), { signal });
      frame.addEventListener("pointerleave", (e) => !reduce.matches && e.pointerType === "mouse" && zoom(1), { signal });
    });

    root.querySelectorAll<HTMLAnchorElement>("[data-deliv-link]").forEach((link) => {
      const wrap = link.querySelector<HTMLElement>("[data-deliv-arrow-wrap]");
      const icon = link.querySelector<MorphEl>("[data-deliv-arrow]");
      const nudge = wrap ? gsap.quickTo(wrap, "x", { duration: 0.22, ease: "power3.out" }) : null;
      const enter = () => {
        icon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) nudge?.(3);
      };
      const leave = () => {
        icon?.morphTo?.(ArrowRight);
        if (!reduce.matches) nudge?.(0);
      };
      link.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && enter(), { signal });
      link.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && leave(), { signal });
      link.addEventListener("focus", enter, { signal });
      link.addEventListener("blur", leave, { signal });
    });

    cleanupLinks = () => controller.abort();
  }

  document.addEventListener("astro:page-load", initDeliverables);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanupLinks?.();
    cleanupLinks = null;
  });
</script>
