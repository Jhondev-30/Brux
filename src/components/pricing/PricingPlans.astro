---
import { Check as LucideCheck } from "@lucide/astro";
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";
import { pricingTiers } from "../../data/pricing";
import { bookingUrl } from "../../data/site";
---

<section
  id="plans"
  class="scroll-mt-24 bg-paper py-20 text-ink sm:py-28"
  aria-labelledby="plans-grid-title"
  data-pricing-plans
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2
          id="plans-grid-title"
          class="text-[clamp(1.75rem,1.4rem+1.5vw,2.625rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-balance"
        >
          Four monthly plans, zero commission
        </h2>
        <p class="mt-3 max-w-[38rem] text-base leading-relaxed text-muted">
          Pick the outreach volume and content support that fits where your speaking business is today.
        </p>
      </div>
      <a
        href="#compare"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink underline decoration-ink/30 underline-offset-4 transition-colors hover:text-stage-text hover:decoration-stage-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
      >
        <span>Jump to full feature comparison</span>
      </a>
    </div>

    <ul
      class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[auto_auto_auto_auto_auto] lg:gap-x-5 lg:gap-y-0"
      data-pp-grid
    >
      {pricingTiers.map((t) => (
        <li
          id={t.id}
          class:list={[
            "scroll-mt-28 relative isolate flex lg:row-span-5 lg:grid lg:grid-rows-subgrid",
            "before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rounded-[20px] before:transition-colors before:duration-300 before:ease-out before:content-['']",
            t.featured
              ? "before:translate-y-1.5 before:bg-stage-text/22 has-[[data-pp-card]:hover]:before:bg-stage-text/32 has-[[data-pp-card]:focus-within]:before:bg-stage-text/32"
              : "before:bg-ink/12 has-[[data-pp-card]:hover]:before:bg-ink/20 has-[[data-pp-card]:focus-within]:before:bg-ink/20",
          ]}
          data-pp-item
        >
          <article
            class:list={[
              "group/pp relative flex flex-1 flex-col rounded-[20px] border p-6 text-paper will-change-transform lg:row-span-5 lg:grid lg:grid-rows-subgrid lg:px-6 lg:pt-7 lg:pb-6 xl:px-7",
              t.featured ? "border-stage-text bg-stage-text" : "border-ink bg-ink",
            ]}
            data-pp-card
            data-pp-featured={t.featured ? "true" : undefined}
          >
            <!-- 1. Nombre y badge inline -->
            <div class="flex flex-wrap items-baseline justify-between gap-x-2.5 gap-y-1.5">
              <h3 class="text-[1.375rem] font-extrabold leading-[1.15] tracking-[-0.02em] text-paper" data-pp-name>
                {t.name}
              </h3>
              <span
                class:list={[
                  "inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-[0.75rem] font-bold tracking-[0.01em] whitespace-nowrap text-paper",
                  t.featured ? "bg-ink" : "bg-paper/12",
                ]}
              >
                {t.badge}
              </span>
            </div>

            <!-- 2. Precio tabular + condición de compromiso -->
            <div class="mt-5">
              <div class="flex items-baseline gap-1.5">
                <span class="text-[clamp(2.25rem,1.9rem+1.1vw,2.75rem)] font-extrabold leading-none tracking-[-0.03em] text-paper tabular-nums">
                  {t.priceLabel}
                </span>
                <span class:list={["text-sm font-medium", t.featured ? "text-paper/85" : "text-muted-on-ink"]}>
                  / mo
                </span>
              </div>
              <p
                class:list={[
                  "mt-2 text-[0.8125rem] leading-snug font-medium",
                  t.featured ? "text-paper/90" : "text-muted-on-ink",
                ]}
              >
                {t.commitment}
              </p>
            </div>

            <!-- 3. Resumen de una línea -->
            <p
              class:list={[
                "mt-4 text-[0.9375rem] leading-[1.5]",
                t.featured ? "text-paper/95" : "text-paper/85",
              ]}
            >
              {t.summary}
            </p>

            <!-- 4. Bullets clave con línea animada en hover -->
            <div
              class:list={[
                "relative mt-5 border-t pt-5",
                t.featured ? "border-paper/20" : "border-paper/12",
              ]}
            >
              <span
                class:list={[
                  "pointer-events-none absolute inset-x-0 -top-px h-px origin-left [transform:scaleX(0)]",
                  t.featured ? "bg-paper" : "bg-stage-glow",
                ]}
                aria-hidden="true"
                data-pp-line
              />
              <ul class="grid gap-2.5">
                {t.highlights.map((item) => (
                  <li class="flex items-start gap-2.5 text-[0.875rem] leading-[1.45] text-paper/95">
                    <LucideCheck
                      class:list={[
                        "mt-0.5 size-4 shrink-0",
                        t.featured ? "text-paper" : "text-stage-glow",
                      ]}
                      stroke-width={2.25}
                      aria-hidden="true"
                    />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- 5. CTA único por tarjeta -->
            <div class="mt-auto pt-7 lg:mt-0 lg:self-end">
              <a
                href={bookingUrl}
                target="_blank"
                rel="noopener"
                class:list={[
                  "group/cta flex min-h-12 w-full items-center justify-center gap-2 rounded-[6px] px-4 text-[0.9375rem] font-semibold transition-colors duration-150 ease-out focus-visible:outline-2 focus-visible:outline-offset-2",
                  t.featured
                    ? "bg-ink text-paper hover:bg-ink-raised focus-visible:outline-paper"
                    : "bg-paper/12 text-paper ring-1 ring-paper/15 ring-inset hover:bg-paper hover:text-ink focus-visible:outline-stage-glow",
                ]}
                data-pp-cta
              >
                <span>Book a strategy call</span>
                <span class="inline-flex shrink-0 will-change-transform" data-pp-arrow-wrap>
                  <MorphIcon
                    icon={ArrowRight}
                    size={16}
                    strokeWidth={2}
                    spring="snappy"
                    reducedMotion="user"
                    data-pp-arrow
                  />
                </span>
              </a>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <!-- Franja de aclaración (equivalente al callout del PDF, sin border-left grueso) -->
    <div class="mt-12 grid gap-6 rounded-[20px] border border-ink/10 bg-mist p-6 sm:p-8 lg:grid-cols-2 lg:gap-10">
      <div>
        <h3 class="text-base font-extrabold tracking-[-0.01em] text-ink">How the Founder rate works</h3>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">
          The Founder plan gives you everything in Foundation for <strong class="font-semibold text-ink">$500/mo</strong> on a
          month-to-month contract (3-month minimum). You keep that $500/mo rate until we book your first paid stage, then move to
          Foundation at <strong class="font-semibold text-ink">$1,200/mo</strong>.
        </p>
      </div>
      <div class="border-t border-ink/10 pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
        <h3 class="text-base font-extrabold tracking-[-0.01em] text-ink">Only events in your niche</h3>
        <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">
          We never blast generic call-for-speaker lists. Every pitch is researched and sent directly to organizers running conferences,
          summits, and corporate events that match your topics and fee range.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ArrowRight, ArrowUpRight, type IconNode } from "lucide";

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  let cleanup: (() => void) | null = null;

  function initPricingPlans() {
    cleanup?.();
    const root = document.querySelector<HTMLElement>("[data-pricing-plans]");
    if (!root) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    root.querySelectorAll<HTMLElement>("[data-pp-card]").forEach((card) => {
      const line = card.querySelector<HTMLElement>("[data-pp-line]");
      const name = card.querySelector<HTMLElement>("[data-pp-name]");
      const liftY = gsap.quickTo(card, "y", { duration: 0.34, ease: "power3.out" });

      const onEnter = () => {
        if (reduce.matches) return;
        liftY(-5);
        if (line) {
          gsap.set(line, { transformOrigin: "0% 50%" });
          gsap.to(line, { scaleX: 1, duration: 0.42, ease: "expo.out", overwrite: "auto" });
        }
        if (name) gsap.to(name, { x: 2, duration: 0.32, ease: "expo.out", overwrite: "auto" });
      };

      const onLeave = () => {
        if (reduce.matches) return;
        liftY(0);
        if (line) {
          gsap.set(line, { transformOrigin: "100% 50%" });
          gsap.to(line, { scaleX: 0, duration: 0.24, ease: "power2.inOut", overwrite: "auto" });
        }
        if (name) gsap.to(name, { x: 0, duration: 0.2, ease: "power2.out", overwrite: "auto" });
      };

      card.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      card.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      card.addEventListener("focusin", onEnter, { signal });
      card.addEventListener("focusout", (e) => {
        if (!card.contains(e.relatedTarget as Node | null)) onLeave();
      }, { signal });
    });

    root.querySelectorAll<HTMLAnchorElement>("[data-pp-cta]").forEach((cta) => {
      const arrowWrap = cta.querySelector<HTMLElement>("[data-pp-arrow-wrap]");
      const arrowIcon = cta.querySelector<MorphEl>("[data-pp-arrow]");
      const nudge = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.22, ease: "power3.out" }) : null;

      const onEnter = () => {
        arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) nudge?.(3);
      };
      const onLeave = () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) nudge?.(0);
      };

      cta.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      cta.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      cta.addEventListener("focus", onEnter, { signal });
      cta.addEventListener("blur", onLeave, { signal });
    });

    cleanup = () => controller.abort();
  }

  document.addEventListener("astro:page-load", initPricingPlans);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
