---
import { ArrowDown as LucideArrowDown, Check as LucideCheck } from "@lucide/astro";
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";
import { pricingTiers } from "../../data/pricing";
import { bookingUrl } from "../../data/site";

const words = (s: string) => s.split(" ");
const maskClass =
  "inline-block overflow-clip align-top pt-[0.06em] pb-[0.14em] px-[0.04em] -mt-[0.06em] -mb-[0.14em] -mx-[0.04em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";
---

<section
  id="plans"
  class="scroll-mt-24 bg-mist py-20 text-ink sm:py-28"
  aria-labelledby="plans-grid-title"
  data-pricing-plans
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2
          id="plans-grid-title"
          class="text-[clamp(1.75rem,1.4rem+1.5vw,2.625rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-balance"
          data-pp-title
        >
          {words("Three monthly plans, zero commission").map((w, j, a) => (
            <>
              <span class={maskClass}><span class={wordClass} data-pp-title-word>{w}</span></span>
              {j < a.length - 1 && " "}
            </>
          ))}
        </h2>
        <p class="mt-3 max-w-[38rem] text-base leading-relaxed text-muted" data-pp-lead>
          Choose the monthly pitch and LinkedIn volume that fits where your speaking career is today.
        </p>
      </div>
      <a
        href="#compare"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink underline decoration-ink/30 underline-offset-4 transition-colors hover:text-stage-text hover:decoration-stage-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
      >
        <span>Jump to feature comparison</span>
      </a>
    </div>

    <ul
      class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-[1.35fr_1fr_1fr] lg:items-stretch"
      data-pp-grid
    >
      {pricingTiers.map((t) => {
        const isFounder = t.id === "founder";
        return (
          <li
            id={t.id}
            class:list={[
              "scroll-mt-28 relative isolate flex",
              "before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rounded-[23px] before:transition-colors before:duration-300 before:ease-out before:content-['']",
              t.featured
                ? "before:translate-y-2 before:bg-stage-text/30 has-[[data-pp-card]:hover]:before:bg-stage-text/40 has-[[data-pp-card]:focus-within]:before:bg-stage-text/40"
                : "before:bg-ink/12 has-[[data-pp-card]:hover]:before:bg-ink/20 has-[[data-pp-card]:focus-within]:before:bg-ink/20",
            ]}
            data-pp-item
          >
            <article
              class:list={[
                "group/pp relative flex flex-1 flex-col overflow-hidden rounded-[23px] border p-6 text-paper will-change-transform sm:p-7",
                t.featured
                  ? "border-paper/25 bg-[linear-gradient(155deg,#E50C13_0%,#C20A18_48%,#7E0611_100%)] shadow-[0_28px_68px_-18px_rgba(194,10,24,0.52),inset_0_1px_0_rgba(255,255,255,0.22)]"
                  : "border-[#333338] bg-[linear-gradient(155deg,#161618,#080809_52%)] shadow-[0_24px_64px_-20px_rgba(0,0,0,0.45),inset_0_1px_0_rgba(255,255,255,0.05)]",
              ]}
              data-pp-card
              data-pp-featured={t.featured ? "true" : undefined}
            >
              <!-- Ambient glow replicating BRUX_founder_interactive -->
              <span
                aria-hidden="true"
                class:list={[
                  "pointer-events-none absolute -left-20 rounded-full",
                  t.featured
                    ? "top-6 h-64 w-80 bg-[radial-gradient(ellipse,rgba(255,255,255,0.22)_0%,transparent_68%)]"
                    : "top-10 h-56 w-72 bg-[radial-gradient(ellipse,rgba(220,23,56,0.14)_0%,transparent_68%)]",
                ]}
              />

              <!-- 1. Plan name + pill badge -->
              <div class="relative flex flex-wrap items-center justify-between gap-2.5">
                <h3
                  class:list={[
                    "font-extrabold leading-[1.1] tracking-[-0.03em] text-paper",
                    t.featured ? "text-[1.75rem]" : "text-[1.5rem]",
                  ]}
                  data-pp-name
                >
                  {t.name}
                </h3>
                <span
                  class:list={[
                    "inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1 text-[0.75rem] font-bold tracking-[0.01em] whitespace-nowrap",
                    t.featured
                      ? "bg-paper text-stage-text shadow-xs"
                      : "bg-[#2b2b2f] text-[#e6e6e6]",
                  ]}
                >
                  {t.featured && <span class="size-1.5 rounded-full bg-stage" aria-hidden="true" />}
                  <span data-founder-badge={isFounder ? "" : undefined}>{t.badge}</span>
                </span>
              </div>

              <!-- 2. Price area (fixed height on desktop so every card aligns horizontally) -->
              <div class="relative mt-5 flex min-h-[3.5rem] items-baseline">
                {t.price !== null ? (
                  <div class="flex items-baseline gap-2">
                    <span
                      class="inline-block text-[clamp(2.75rem,3.4vw,3.5rem)] font-extrabold leading-none tracking-[-0.04em] text-paper tabular-nums"
                      data-founder-price={isFounder ? "" : undefined}
                      aria-live={isFounder ? "polite" : undefined}
                    >
                      {t.priceLabel}
                    </span>
                    {t.priceSubLabel && (
                      <span class="text-lg font-semibold text-paper/85">
                        {t.priceSubLabel}
                      </span>
                    )}
                  </div>
                ) : (
                  <span class="text-[clamp(1.75rem,2.1vw,2.25rem)] font-extrabold leading-none tracking-[-0.03em] text-paper">
                    {t.priceLabel}
                  </span>
                )}
              </div>

              <!-- 3. Description + commitment (uniform height on desktop so metrics & deliverables align across all 3 cards) -->
              <div class="relative mt-4 flex flex-col justify-between lg:min-h-[6.25rem]">
                <p
                  class:list={[
                    "text-[0.9375rem] leading-[1.55]",
                    t.featured ? "text-paper/95" : "text-[#e5e5e8]",
                  ]}
                  data-founder-desc={isFounder ? "" : undefined}
                >
                  {t.summary}
                </p>
                <div
                  class:list={[
                    "mt-3 flex items-center gap-2 text-xs font-medium",
                    t.featured ? "text-paper/90" : "text-[#bfc0c5]",
                  ]}
                >
                  <span
                    class:list={[
                      "size-1.5 shrink-0 rounded-full",
                      t.featured
                        ? "bg-paper shadow-[0_0_0_3px_rgba(255,255,255,0.28)]"
                        : "bg-[#c21b37] shadow-[0_0_0_3px_rgba(194,27,55,0.22)]",
                    ]}
                    aria-hidden="true"
                  />
                  <span data-founder-state-text={isFounder ? "" : undefined}>
                    {isFounder ? "3-month minimum · Before 1st paid event" : t.commitment}
                  </span>
                </div>
              </div>

              <!-- 4. Divider + monthly capacity metrics (aligned across all 3 cards) -->
              <div
                class:list={[
                  "relative mt-6 grid gap-2.5 border-t pt-5",
                  t.featured ? "border-paper/25" : "border-[#323236]",
                ]}
              >
                <span
                  class:list={[
                    "pointer-events-none absolute inset-x-0 -top-px h-px origin-left [transform:scaleX(0)]",
                    t.featured ? "bg-paper" : "bg-stage-glow",
                  ]}
                  aria-hidden="true"
                  data-pp-line
                />
                <div class="flex items-baseline gap-3">
                  <span
                    class="min-w-[4.25rem] text-[1.875rem] font-extrabold leading-none tracking-[-0.03em] text-paper tabular-nums"
                    data-pp-num
                  >
                    {t.pitches}
                  </span>
                  <span class:list={["text-sm leading-snug", t.featured ? "text-paper/90" : "text-[#b3b3b9]"]}>
                    organizer pitches / mo
                  </span>
                </div>
                <div class="flex items-baseline gap-3">
                  <span
                    class="min-w-[4.25rem] text-[1.875rem] font-extrabold leading-none tracking-[-0.03em] text-paper tabular-nums"
                    data-pp-num
                  >
                    {t.posts}
                  </span>
                  <span class:list={["text-sm leading-snug", t.featured ? "text-paper/90" : "text-[#b3b3b9]"]}>
                    LinkedIn posts / mo
                  </span>
                </div>
              </div>

              <!-- 5. Included deliverables list (starts at the exact same height across all 3 cards) -->
              <div
                class:list={[
                  "relative mt-6 border-t pt-5",
                  t.featured ? "border-paper/20" : "border-[#2a2a2f]",
                ]}
              >
                <p
                  class:list={[
                    "text-xs font-bold tracking-[0.01em]",
                    t.featured ? "text-paper" : "text-paper/90",
                  ]}
                >
                  {t.highlightsHeading}
                </p>
                <ul class="mt-3.5 space-y-2.5 text-[0.875rem] leading-snug">
                  {t.highlights.map((item) => (
                    <li
                      class:list={[
                        "flex items-start gap-2.5",
                        t.featured
                          ? "text-paper/95"
                          : item.featured
                            ? "font-semibold text-paper"
                            : "text-[#d4d4d8]",
                      ]}
                    >
                      <span
                        class:list={[
                          "mt-0.5 grid size-4 shrink-0 place-items-center rounded-full",
                          t.featured
                            ? "bg-paper/18 text-paper"
                            : item.featured
                              ? "bg-[#ed2443]/20 text-[#ff5a6e]"
                              : "bg-paper/8 text-[#a1a1aa]",
                        ]}
                        aria-hidden="true"
                      >
                        <LucideCheck class="size-2.5" stroke-width={3} />
                      </span>
                      <span>{item.label}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- 6. Bottom actions: Founder rate preview switch (right above CTA) + primary CTA + footer note -->
              <div class="relative mt-auto flex flex-col gap-3 pt-7">
                {isFounder && (
                  <div
                    class="rounded-[12px] bg-ink/28 p-1 ring-1 ring-paper/20"
                    role="group"
                    aria-label="Preview Founder rate before and after your first paid event"
                    data-founder-switch
                  >
                    <div class="grid grid-cols-2 gap-1">
                      <button
                        type="button"
                        aria-pressed="true"
                        data-founder-stage="before"
                        class="cursor-pointer rounded-[9px] bg-paper/22 px-2.5 py-2 text-center text-xs font-bold leading-tight text-paper ring-1 ring-paper/35 transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
                      >
                        Before 1st paid event
                      </button>
                      <button
                        type="button"
                        aria-pressed="false"
                        data-founder-stage="after"
                        class="cursor-pointer rounded-[9px] px-2.5 py-2 text-center text-xs font-semibold leading-tight text-paper/80 transition-colors duration-150 hover:bg-paper/10 hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
                      >
                        After 1st paid event
                      </button>
                    </div>
                  </div>
                )}

                <a
                  href={bookingUrl}
                  target="_blank"
                  rel="noopener"
                  class:list={[
                    "group/cta flex min-h-12 w-full items-center justify-center gap-2 rounded-[10px] px-4 text-[0.9375rem] font-bold transition-all duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2",
                    t.featured
                      ? "bg-paper text-ink shadow-[0_10px_24px_-10px_rgba(0,0,0,0.45)] hover:bg-mist focus-visible:outline-paper"
                      : "border border-paper/20 bg-paper/[0.08] text-paper shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] hover:border-paper hover:bg-paper hover:text-ink focus-visible:outline-stage-glow",
                  ]}
                  data-pp-cta
                >
                  <span>{t.ctaLabel ?? "Book a strategy call"}</span>
                  <span class="inline-flex shrink-0 will-change-transform" data-pp-arrow-wrap>
                    <MorphIcon
                      icon={ArrowRight}
                      size={16}
                      strokeWidth={2.2}
                      spring="snappy"
                      reducedMotion="user"
                      data-pp-arrow
                    />
                  </span>
                </a>
                <a
                  href="#compare"
                  class:list={[
                    "inline-flex items-center justify-center gap-1 text-xs font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2",
                    t.featured
                      ? "text-paper/85 hover:text-paper focus-visible:outline-paper"
                      : "text-[#8f9098] hover:text-paper focus-visible:outline-stage-glow",
                  ]}
                >
                  <span>See full feature comparison</span>
                  <LucideArrowDown class="size-3.5" aria-hidden="true" />
                </a>
              </div>
            </article>
          </li>
        );
      })}
    </ul>

    <!-- Aclaración Founder y nicho -->
    <div
      class="mt-12 grid gap-6 rounded-[20px] border border-ink/10 bg-paper p-6 sm:p-8 lg:grid-cols-2 lg:gap-10"
      data-pp-bridge
    >
      <div>
        <h3 class="text-base font-extrabold tracking-[-0.01em] text-ink">How the Founder rate works</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Includes everything in Foundation for <strong class="font-semibold text-ink">$500/mo</strong> (monthly billing, 3 month minimum).
          You keep $500/mo until we book your first paid stage, then your plan transitions to Foundation at <strong class="font-semibold text-ink">$1,200/mo</strong>.
        </p>
      </div>
      <div class="border-t border-ink/10 pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
        <h3 class="text-base font-extrabold tracking-[-0.01em] text-ink">Only events in your niche</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          We never blast generic speaker listings. Every pitch goes straight to organizers running conferences and corporate events that match your topics.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ArrowRight, ArrowUpRight, type IconNode } from "lucide";

  gsap.registerPlugin(ScrollTrigger);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  let mm: gsap.MatchMedia | null = null;
  let cleanup: (() => void) | null = null;

  function initPricingPlans() {
    cleanup?.();
    mm?.revert();
    mm = null;

    const root = document.querySelector<HTMLElement>("[data-pricing-plans]");
    if (!root) return;

    // Animación de entrada de la sección y tarjetas (una sola vez al llegar)
    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const titleWords = root.querySelectorAll<HTMLElement>("[data-pp-title-word]");
        const lead = root.querySelector<HTMLElement>("[data-pp-lead]");
        const items = root.querySelectorAll<HTMLElement>("[data-pp-item]");
        const bridge = root.querySelector<HTMLElement>("[data-pp-bridge]");

        const tl = gsap.timeline({
          scrollTrigger: { trigger: root, start: "top 82%", once: true },
          defaults: { ease: "expo.out" },
        });

        if (titleWords.length) {
          tl.fromTo(
            titleWords,
            { yPercent: 112, rotate: 5 },
            { yPercent: 0, rotate: 0, duration: 0.95, stagger: 0.045, clearProps: "transform" },
            0,
          );
        }
        if (lead) tl.from(lead, { y: 12, autoAlpha: 0, duration: 0.7, clearProps: "transform,opacity,visibility" }, 0.16);
        if (items.length) {
          tl.from(
            items,
            { y: 36, autoAlpha: 0, duration: 0.85, stagger: 0.06, clearProps: "transform,opacity,visibility" },
            0.22,
          );
        }
        if (bridge) {
          tl.from(bridge, { y: 20, autoAlpha: 0, duration: 0.75, clearProps: "transform,opacity,visibility" }, 0.45);
        }
      }, root);

      return () => ctx.revert();
    });

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    // Switch segmentado de 2 etapas en la tarjeta Founder ($500 ↔ $1,200 Foundation)
    const founderSwitch = root.querySelector<HTMLElement>("[data-founder-switch]");
    if (founderSwitch) {
      const priceEl = root.querySelector<HTMLElement>("[data-founder-price]");
      const badgeEl = root.querySelector<HTMLElement>("[data-founder-badge]");
      const descEl = root.querySelector<HTMLElement>("[data-founder-desc]");
      const stateTextEl = root.querySelector<HTMLElement>("[data-founder-state-text]");
      const buttons = founderSwitch.querySelectorAll<HTMLButtonElement>("[data-founder-stage]");
      const activeClasses = ["bg-paper/22", "font-bold", "text-paper", "ring-1", "ring-paper/35"];
      const inactiveClasses = ["font-semibold", "text-paper/80", "hover:bg-paper/10", "hover:text-paper"];
      let postBooking = false;

      const setStage = (nextPostBooking: boolean) => {
        if (postBooking === nextPostBooking) return;
        postBooking = nextPostBooking;

        if (priceEl) {
          priceEl.classList.remove("founder-price-sweep");
          void priceEl.offsetWidth;
          priceEl.textContent = postBooking ? "$1,200" : "$500";
          priceEl.classList.add("founder-price-sweep");
        }
        if (badgeEl) {
          badgeEl.textContent = postBooking ? "Foundation rate" : "Founder rate";
        }
        if (descEl) {
          descEl.textContent = postBooking
            ? "After your first paid event is booked, your plan moves to Foundation at $1,200/month."
            : "Your Founder rate stays at $500/month until we book your first paid speaking event.";
        }
        if (stateTextEl) {
          stateTextEl.textContent = postBooking
            ? "No minimum commitment · After 1st paid event"
            : "3-month minimum · Before 1st paid event";
        }

        buttons.forEach((btn) => {
          const isSelected = (btn.dataset.founderStage === "after") === postBooking;
          btn.setAttribute("aria-pressed", String(isSelected));
          activeClasses.forEach((cls) => btn.classList.toggle(cls, isSelected));
          inactiveClasses.forEach((cls) => btn.classList.toggle(cls, !isSelected));
        });
      };

      buttons.forEach((btn) => {
        btn.addEventListener(
          "click",
          () => setStage(btn.dataset.founderStage === "after"),
          { signal },
        );
      });
    }

    root.querySelectorAll<HTMLElement>("[data-pp-card]").forEach((card) => {
      const line = card.querySelector<HTMLElement>("[data-pp-line]");
      const name = card.querySelector<HTMLElement>("[data-pp-name]");
      const nums = card.querySelectorAll<HTMLElement>("[data-pp-num]");
      const liftY = gsap.quickTo(card, "y", { duration: 0.34, ease: "power3.out" });

      const onEnter = () => {
        if (reduce.matches) return;
        liftY(-5);
        if (line) {
          gsap.set(line, { transformOrigin: "0% 50%" });
          gsap.to(line, { scaleX: 1, duration: 0.42, ease: "expo.out", overwrite: "auto" });
        }
        if (name) gsap.to(name, { x: 2, duration: 0.32, ease: "expo.out", overwrite: "auto" });
        if (nums.length) {
          gsap.to(nums, { x: 2, scale: 1.03, duration: 0.35, stagger: 0.03, ease: "expo.out", overwrite: "auto" });
        }
      };

      const onLeave = () => {
        if (reduce.matches) return;
        liftY(0);
        if (line) {
          gsap.set(line, { transformOrigin: "100% 50%" });
          gsap.to(line, { scaleX: 0, duration: 0.22, ease: "power2.inOut", overwrite: "auto" });
        }
        if (name) gsap.to(name, { x: 0, duration: 0.2, ease: "power2.out", overwrite: "auto" });
        if (nums.length) {
          gsap.to(nums, { x: 0, scale: 1, duration: 0.2, ease: "power2.out", overwrite: "auto" });
        }
      };

      card.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      card.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      card.addEventListener("focusin", onEnter, { signal });
      card.addEventListener("focusout", (e) => {
        if (!card.contains(e.relatedTarget as Node | null)) onLeave();
      }, { signal });
    });

    root.querySelectorAll<HTMLAnchorElement>("[data-pp-cta]").forEach((cta) => {
      const arrowWrap = cta.querySelector<HTMLElement>("[data-pp-arrow-wrap]");
      const arrowIcon = cta.querySelector<MorphEl>("[data-pp-arrow]");
      const nudge = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.22, ease: "power3.out" }) : null;

      const onEnter = () => {
        arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) nudge?.(3);
      };
      const onLeave = () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) nudge?.(0);
      };

      cta.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      cta.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      cta.addEventListener("focus", onEnter, { signal });
      cta.addEventListener("blur", onLeave, { signal });
    });

    cleanup = () => controller.abort();
  }

  document.addEventListener("astro:page-load", initPricingPlans);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanup?.();
    cleanup = null;
  });
</script>
