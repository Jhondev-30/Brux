---
import { ArrowDown as LucideArrowDown } from "@lucide/astro";
import { ArrowRight, Plus } from "lucide";
import MorphIcon from "morphicons/astro";
import { pricingTiers } from "../../data/pricing";
import { bookingUrl } from "../../data/site";

const words = (s: string) => s.split(" ");
const maskClass =
  "inline-block overflow-clip align-top pt-[0.06em] pb-[0.14em] px-[0.04em] -mt-[0.06em] -mb-[0.14em] -mx-[0.04em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";
---

<section
  id="plans"
  class="scroll-mt-24 bg-mist py-20 text-ink sm:py-28"
  aria-labelledby="plans-grid-title"
  data-pricing-plans
>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <h2
          id="plans-grid-title"
          class="text-[clamp(1.75rem,1.4rem+1.5vw,2.625rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-balance"
          data-pp-title
        >
          {words("Four monthly plans, zero commission").map((w, j, a) => (
            <>
              <span class={maskClass}><span class={wordClass} data-pp-title-word>{w}</span></span>
              {j < a.length - 1 && " "}
            </>
          ))}
        </h2>
        <p class="mt-3 max-w-[38rem] text-base leading-relaxed text-muted" data-pp-lead>
          Choose the monthly pitch and LinkedIn volume that fits where your speaking career is today.
        </p>
      </div>
      <a
        href="#compare"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-ink underline decoration-ink/30 underline-offset-4 transition-colors hover:text-stage-text hover:decoration-stage-text focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
      >
        <span>Jump to feature comparison</span>
      </a>
    </div>

    <ul
      class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:grid-rows-[auto_auto_auto_auto_auto_auto] lg:gap-x-5 lg:gap-y-0"
      data-pp-grid
    >
      {pricingTiers.map((t) => (
        <li
          id={t.id}
          class:list={[
            "scroll-mt-28 relative isolate flex lg:row-span-6 lg:grid lg:grid-rows-subgrid",
            "before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rounded-[20px] before:transition-colors before:duration-300 before:ease-out before:content-['']",
            t.featured
              ? "before:translate-y-1.5 before:bg-stage-text/22 has-[[data-pp-card]:hover]:before:bg-stage-text/32 has-[[data-pp-card]:focus-within]:before:bg-stage-text/32"
              : "before:bg-ink/12 has-[[data-pp-card]:hover]:before:bg-ink/20 has-[[data-pp-card]:focus-within]:before:bg-ink/20",
          ]}
          data-pp-item
        >
          <article
            class:list={[
              "group/pp relative flex flex-1 flex-col rounded-[20px] border p-6 text-paper will-change-transform lg:row-span-6 lg:grid lg:grid-rows-subgrid lg:px-6 lg:pt-7 lg:pb-6 xl:px-7",
              t.featured ? "border-stage-text bg-stage-text" : "border-ink bg-ink",
            ]}
            data-pp-card
            data-pp-featured={t.featured ? "true" : undefined}
          >
            <!-- 1. Nombre y badge inline -->
            <div class="flex flex-wrap items-baseline justify-between gap-x-2.5 gap-y-1.5">
              <h3 class="text-[1.375rem] font-extrabold leading-[1.15] tracking-[-0.02em] text-paper" data-pp-name>
                {t.name}
              </h3>
              <span
                class:list={[
                  "inline-flex shrink-0 items-center rounded-full px-2.5 py-0.5 text-[0.75rem] font-bold tracking-[0.01em] whitespace-nowrap text-paper",
                  t.featured ? "bg-ink" : "bg-paper/12",
                ]}
              >
                {t.badge}
              </span>
            </div>

            <!-- 2. Precio tabular + compromiso -->
            <div class="mt-5">
              <div class="flex items-baseline gap-1.5">
                <span class="text-[clamp(2.25rem,1.9rem+1.1vw,2.75rem)] font-extrabold leading-none tracking-[-0.03em] text-paper tabular-nums">
                  {t.priceLabel}
                </span>
                <span class:list={["text-sm font-medium", t.featured ? "text-paper/85" : "text-muted-on-ink"]}>
                  / mo
                </span>
              </div>
              <p
                class:list={[
                  "mt-2 text-[0.8125rem] leading-snug font-medium",
                  t.featured ? "text-paper/90" : "text-muted-on-ink",
                ]}
              >
                {t.commitment}
              </p>
            </div>

            <!-- 3. Para quién es -->
            <p
              class:list={[
                "mt-4 text-[0.9375rem] leading-[1.5]",
                t.featured ? "text-paper/95" : "text-paper/85",
              ]}
            >
              {t.summary}
            </p>

            <!-- 4. Cifras de capacidad mensual -->
            <div
              class:list={[
                "relative mt-5 grid gap-3 border-t pt-5",
                t.featured ? "border-paper/20" : "border-paper/12",
              ]}
            >
              <span
                class:list={[
                  "pointer-events-none absolute inset-x-0 -top-px h-px origin-left [transform:scaleX(0)]",
                  t.featured ? "bg-paper" : "bg-stage-glow",
                ]}
                aria-hidden="true"
                data-pp-line
              />
              <div class="grid grid-cols-[4rem_1fr] items-baseline gap-x-2.5 xl:grid-cols-[4.5rem_1fr]">
                <span class="text-[1.625rem] font-extrabold leading-none tracking-[-0.03em] text-paper tabular-nums xl:text-[1.875rem]" data-pp-num>
                  {t.pitches}
                </span>
                <span class:list={["text-sm leading-snug", t.featured ? "text-paper/90" : "text-muted-on-ink"]}>
                  organizer pitches / mo
                </span>
              </div>
              <div class="grid grid-cols-[4rem_1fr] items-baseline gap-x-2.5 xl:grid-cols-[4.5rem_1fr]">
                <span class="text-[1.625rem] font-extrabold leading-none tracking-[-0.03em] text-paper tabular-nums xl:text-[1.875rem]" data-pp-num>
                  {t.posts}
                </span>
                <span class:list={["text-sm leading-snug", t.featured ? "text-paper/90" : "text-muted-on-ink"]}>
                  LinkedIn posts / mo
                </span>
              </div>
            </div>

            <!-- 5. Diferencial clave -->
            <div class="mt-5 flex items-start gap-2 text-[0.875rem] font-semibold leading-snug text-paper">
              <span class:list={["mt-0.5 inline-flex shrink-0", t.featured ? "text-paper" : "text-stage-glow"]}>
                <MorphIcon
                  icon={Plus}
                  size={14}
                  strokeWidth={2.25}
                  spring="snappy"
                  reducedMotion="user"
                  data-pp-add-icon
                />
              </span>
              <span>{t.adds}</span>
            </div>

            <!-- 6. CTA único -->
            <div class="mt-auto flex flex-col gap-3 pt-7 lg:mt-0 lg:self-end">
              <a
                href={bookingUrl}
                target="_blank"
                rel="noopener"
                class:list={[
                  "group/cta flex min-h-12 w-full items-center justify-center gap-2 rounded-[6px] px-4 text-[0.9375rem] font-semibold transition-colors duration-150 ease-out focus-visible:outline-2 focus-visible:outline-offset-2",
                  t.featured
                    ? "bg-ink text-paper hover:bg-ink-raised focus-visible:outline-paper"
                    : "bg-paper/12 text-paper ring-1 ring-paper/15 ring-inset hover:bg-paper hover:text-ink focus-visible:outline-stage-glow",
                ]}
                data-pp-cta
              >
                <span>Book a strategy call</span>
                <span class="inline-flex shrink-0 will-change-transform" data-pp-arrow-wrap>
                  <MorphIcon
                    icon={ArrowRight}
                    size={16}
                    strokeWidth={2}
                    spring="snappy"
                    reducedMotion="user"
                    data-pp-arrow
                  />
                </span>
              </a>
              <a
                href="#compare"
                class:list={[
                  "inline-flex items-center justify-center gap-1 text-xs font-semibold transition-colors focus-visible:outline-2 focus-visible:outline-offset-2",
                  t.featured
                    ? "text-paper/90 hover:text-paper focus-visible:outline-paper"
                    : "text-muted-on-ink hover:text-paper focus-visible:outline-stage-glow",
                ]}
              >
                <span>See what's included below</span>
                <LucideArrowDown class="size-3.5" aria-hidden="true" />
              </a>
            </div>
          </article>
        </li>
      ))}
    </ul>

    <!-- Aclaración Founder y nicho -->
    <div
      class="mt-12 grid gap-6 rounded-[20px] border border-ink/10 bg-paper p-6 sm:p-8 lg:grid-cols-2 lg:gap-10"
      data-pp-bridge
    >
      <div>
        <h3 class="text-base font-extrabold tracking-[-0.01em] text-ink">How the Founder rate works</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Includes everything in Foundation for <strong class="font-semibold text-ink">$500/mo</strong> (monthly billing, 3 month minimum).
          You keep $500/mo until we book your first paid stage, then move to <strong class="font-semibold text-ink">$1,200/mo</strong>.
        </p>
      </div>
      <div class="border-t border-ink/10 pt-6 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-10">
        <h3 class="text-base font-extrabold tracking-[-0.01em] text-ink">Only events in your niche</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          We never blast generic speaker listings. Every pitch goes straight to organizers running conferences and corporate events that match your topics.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { ArrowRight, ArrowUpRight, Check, Plus, type IconNode } from "lucide";

  gsap.registerPlugin(ScrollTrigger);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  let mm: gsap.MatchMedia | null = null;
  let cleanup: (() => void) | null = null;

  function initPricingPlans() {
    cleanup?.();
    mm?.revert();
    mm = null;

    const root = document.querySelector<HTMLElement>("[data-pricing-plans]");
    if (!root) return;

    // Animación de entrada de la sección y tarjetas (una sola vez al llegar)
    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const titleWords = root.querySelectorAll<HTMLElement>("[data-pp-title-word]");
        const lead = root.querySelector<HTMLElement>("[data-pp-lead]");
        const items = root.querySelectorAll<HTMLElement>("[data-pp-item]");
        const bridge = root.querySelector<HTMLElement>("[data-pp-bridge]");

        const tl = gsap.timeline({
          scrollTrigger: { trigger: root, start: "top 82%", once: true },
          defaults: { ease: "expo.out" },
        });

        if (titleWords.length) {
          tl.fromTo(
            titleWords,
            { yPercent: 112, rotate: 5 },
            { yPercent: 0, rotate: 0, duration: 0.95, stagger: 0.045, clearProps: "transform" },
            0,
          );
        }
        if (lead) tl.from(lead, { y: 12, autoAlpha: 0, duration: 0.7, clearProps: "transform,opacity,visibility" }, 0.16);
        if (items.length) {
          tl.from(
            items,
            { y: 36, autoAlpha: 0, duration: 0.85, stagger: 0.06, clearProps: "transform,opacity,visibility" },
            0.22,
          );
        }
        if (bridge) {
          tl.from(bridge, { y: 20, autoAlpha: 0, duration: 0.75, clearProps: "transform,opacity,visibility" }, 0.45);
        }
      }, root);

      return () => ctx.revert();
    });

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    root.querySelectorAll<HTMLElement>("[data-pp-card]").forEach((card) => {
      const line = card.querySelector<HTMLElement>("[data-pp-line]");
      const name = card.querySelector<HTMLElement>("[data-pp-name]");
      const nums = card.querySelectorAll<HTMLElement>("[data-pp-num]");
      const addIcon = card.querySelector<MorphEl>("[data-pp-add-icon]");
      const liftY = gsap.quickTo(card, "y", { duration: 0.34, ease: "power3.out" });

      const onEnter = () => {
        addIcon?.morphTo?.(Check);
        if (reduce.matches) return;
        liftY(-5);
        if (line) {
          gsap.set(line, { transformOrigin: "0% 50%" });
          gsap.to(line, { scaleX: 1, duration: 0.42, ease: "expo.out", overwrite: "auto" });
        }
        if (name) gsap.to(name, { x: 2, duration: 0.32, ease: "expo.out", overwrite: "auto" });
        if (nums.length) {
          gsap.to(nums, { x: 2, scale: 1.03, duration: 0.35, stagger: 0.03, ease: "expo.out", overwrite: "auto" });
        }
      };

      const onLeave = () => {
        addIcon?.morphTo?.(Plus);
        if (reduce.matches) return;
        liftY(0);
        if (line) {
          gsap.set(line, { transformOrigin: "100% 50%" });
          gsap.to(line, { scaleX: 0, duration: 0.22, ease: "power2.inOut", overwrite: "auto" });
        }
        if (name) gsap.to(name, { x: 0, duration: 0.2, ease: "power2.out", overwrite: "auto" });
        if (nums.length) {
          gsap.to(nums, { x: 0, scale: 1, duration: 0.2, ease: "power2.out", overwrite: "auto" });
        }
      };

      card.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      card.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      card.addEventListener("focusin", onEnter, { signal });
      card.addEventListener("focusout", (e) => {
        if (!card.contains(e.relatedTarget as Node | null)) onLeave();
      }, { signal });
    });

    root.querySelectorAll<HTMLAnchorElement>("[data-pp-cta]").forEach((cta) => {
      const arrowWrap = cta.querySelector<HTMLElement>("[data-pp-arrow-wrap]");
      const arrowIcon = cta.querySelector<MorphEl>("[data-pp-arrow]");
      const nudge = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.22, ease: "power3.out" }) : null;

      const onEnter = () => {
        arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) nudge?.(3);
      };
      const onLeave = () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) nudge?.(0);
      };

      cta.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      cta.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      cta.addEventListener("focus", onEnter, { signal });
      cta.addEventListener("blur", onLeave, { signal });
    });

    cleanup = () => controller.abort();
  }

  document.addEventListener("astro:page-load", initPricingPlans);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanup?.();
    cleanup = null;
  });
</script>
