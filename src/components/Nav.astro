---
/**
 * Nav flotante: una barra translúcida con esquinas redondeadas, separada del borde,
 * que se queda arriba al hacer scroll. Logo a la izquierda y las rutas centradas.
 * Sin botón de CTA: la acción principal vive en el hero y en el cierre de cada página.
 *
 * Services abre un panel blanco con texto negro: cuatro servicios en dos columnas, cada uno con su icono,
 * su nombre y una línea corta. Los textos largos de cada servicio viven en su página, no aquí.
 *
 * Estilos con Tailwind v4, animaciones con GSAP, e iconos con MorphIcon + Lucide.
 */
import {
  ArrowRight,
  ChevronDown,
  Globe,
  Menu,
  Mic,
  Users,
  Video,
  type IconNode,
} from "lucide";
import MorphIcon from "morphicons/astro";
import Logo from "../assets/images/brux-logo-sobre-negro.svg";
import { navLinks, services } from "../data/site";

const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || (href !== "/" && path.startsWith(href));
const links = [...navLinks, { href: "/about", label: "About" }];

const serviceIcons: Record<string, IconNode> = {
  "/services/booking": Mic,
  "/services/linkedin": Users,
  "/services/content": Video,
  "/services/web-design": Globe,
};

/* Una línea corta por servicio para el desplegable */
const shortText: Record<string, string> = {
  "/services/booking": "Pitches to event organizers",
  "/services/linkedin": "A profile organizers trust",
  "/services/content": "Reel, press kit and clips",
  "/services/web-design": "One link for every organizer",
};

const linkBase =
  "rounded-lg px-3.5 py-2 text-[0.9375rem] font-medium text-(--nav-fg) transition-[color,background-color] duration-200 ease-out hover:bg-(--nav-hover) hover:text-(--nav-fg-strong) focus-visible:bg-(--nav-hover) focus-visible:text-(--nav-fg-strong) aria-expanded:bg-(--nav-hover) aria-expanded:text-(--nav-fg-strong) motion-reduce:transition-none";
const dropdownSurface =
  "rounded-[14px] bg-paper shadow-[0_0_0_1px_rgb(10_10_10/0.06),0_24px_48px_-16px_rgb(0_0_0/0.55)]";
---

<!-- data-nav-theme: «light» (barra clara) sobre fondos oscuros, «dark» sobre fondos claros. Lo decide el script según lo que hay debajo -->
<header
  class="group/nav fixed inset-x-0 top-3 z-40 px-4 transition-[translate,opacity] duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] sm:top-4 sm:px-8 lg:px-12 motion-reduce:transition-opacity motion-reduce:duration-200 data-[nav-theme=light]:[--nav-bg:linear-gradient(180deg,rgb(255_255_255/0.9)_0%,rgb(255_255_255/0.74)_100%)] data-[nav-theme=light]:[--nav-fg-strong:var(--color-ink)] data-[nav-theme=light]:[--nav-fg:rgb(10_10_10/0.82)] data-[nav-theme=light]:[--nav-highlight:rgb(255_255_255/0.9)] data-[nav-theme=light]:[--nav-hover:rgb(10_10_10/0.07)] data-[nav-theme=light]:[--nav-ring:rgb(255_255_255/0.55)] data-[nav-theme=light]:[--nav-shadow:rgb(0_0_0/0.5)] data-[nav-theme=dark]:[--nav-bg:linear-gradient(rgb(14_14_14/0.62),rgb(14_14_14/0.62))] data-[nav-theme=dark]:[--nav-fg-strong:var(--color-paper)] data-[nav-theme=dark]:[--nav-fg:rgb(255_255_255/0.75)] data-[nav-theme=dark]:[--nav-highlight:rgb(255_255_255/0.06)] data-[nav-theme=dark]:[--nav-hover:rgb(255_255_255/0.08)] data-[nav-theme=dark]:[--nav-ring:rgb(255_255_255/0.08)] data-[nav-theme=dark]:[--nav-shadow:rgb(0_0_0/0.45)] [:root[data-nav-hidden]_&]:pointer-events-none [:root[data-nav-hidden]_&]:-translate-y-[calc(100%+1.5rem)] [:root[data-nav-hidden]_&]:opacity-0"
  data-nav
  data-nav-theme="light"
>
  <nav
    class="mx-auto grid h-14 max-w-3xl grid-cols-[1fr_auto] items-center rounded-[14px] bg-[image:var(--nav-bg)] pr-1.5 pl-5 shadow-[inset_0_0_0_1px_var(--nav-ring),inset_0_1px_0_var(--nav-highlight),0_18px_40px_-18px_var(--nav-shadow)] backdrop-blur-xl backdrop-saturate-180 transition-shadow duration-300 ease-out group-data-[nav-theme=light]/nav:backdrop-blur-2xl group-data-[nav-theme=light]/nav:backdrop-brightness-125 group-data-[nav-theme=light]/nav:backdrop-saturate-200 lg:grid-cols-[1fr_auto_1fr] motion-reduce:transition-none"
    aria-label="Main"
  >
    <a href="/" class="-m-2 justify-self-start rounded-lg p-2" aria-label="Brux, home">
      <Logo
        class="h-5 w-auto text-(--nav-fg-strong) transition-colors duration-300 ease-out sm:h-[1.375rem] motion-reduce:transition-none [&_path[fill='#FFFFFF']]:fill-current"
        aria-hidden="true"
      />
    </a>

    <!-- Escritorio: rutas centradas -->
    <ul class="hidden items-center gap-1 lg:flex">
      <li class="relative" data-dropdown>
        <button
          type="button"
          class:list={[linkBase, "flex items-center gap-1", isCurrent("/services") && "text-(--nav-fg-strong)!"]}
          aria-expanded="false"
          aria-controls="nav-services"
          data-dropdown-button
        >
          Services
          <MorphIcon icon={ChevronDown} size={16} strokeWidth={2} spring="snappy" reducedMotion="user" data-chevron />
        </button>

        <div
          id="nav-services"
          class:list={[dropdownSurface, "absolute top-[calc(100%+1.125rem)] left-1/2 hidden w-[34rem] -translate-x-1/2 p-2"]}
          data-dropdown-panel
        >
          <ul class="grid grid-cols-2 gap-1">
            {
              services.map((s) => (
                <li data-nav-dd-item>
                  <a
                    href={s.href}
                    class="group/item flex items-center gap-3.5 rounded-[10px] p-3 transition-colors duration-150 hover:bg-mist"
                    aria-current={isCurrent(s.href) ? "page" : undefined}
                    data-nav-service={s.href}
                  >
                    <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-mist text-ink transition-colors duration-150 group-hover/item:bg-stage group-hover/item:text-paper">
                      <MorphIcon
                        icon={serviceIcons[s.href] ?? ArrowRight}
                        size={20}
                        strokeWidth={1.75}
                        spring="snappy"
                        reducedMotion="user"
                        data-nav-service-icon
                      />
                    </span>
                    <span class="min-w-0">
                      <span class="block text-[0.9375rem] font-semibold text-ink">{s.name}</span>
                      <span class="mt-0.5 block truncate text-[0.8125rem] text-muted">{shortText[s.href] ?? s.text}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            href="/services"
            class="group/all mt-1 flex items-center justify-between rounded-[10px] bg-mist px-4 py-3 text-sm font-semibold text-ink transition-colors duration-150 hover:bg-[#e8e8e8]"
            data-nav-all
          >
            See all services
            <span class="inline-flex text-stage-text will-change-transform" data-nav-all-arrow-wrap>
              <MorphIcon
                icon={ArrowRight}
                size={16}
                strokeWidth={2}
                spring="snappy"
                reducedMotion="user"
                data-nav-all-arrow
              />
            </span>
          </a>
        </div>
      </li>
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={[linkBase, "block", isCurrent(l.href) && "text-(--nav-fg-strong)!"]}
              aria-current={isCurrent(l.href) ? "page" : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Móvil: botón del menú a la derecha. El icono se transforma en X al abrir -->
    <button
      type="button"
      class:list={[linkBase, "grid size-11 place-items-center justify-self-end rounded-[10px] p-0! lg:hidden"]}
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label="Open menu"
      data-menu-button
    >
      <MorphIcon icon={Menu} size={22} strokeWidth={2} spring="snappy" reducedMotion="user" data-menu-icon />
    </button>
  </nav>

  <!-- Móvil: panel blanco, igual que el desplegable de escritorio -->
  <div
    id="nav-mobile"
    class:list={[dropdownSurface, "fixed inset-x-4 top-[4.75rem] hidden max-h-[calc(100svh-5.75rem)] overflow-y-auto p-2 sm:inset-x-8 sm:top-20 lg:hidden"]}
    data-menu-panel
  >
    <p class="px-3 pt-2 pb-1 text-[0.8125rem] font-medium text-muted">Services</p>
    <ul>
      {
        services.map((s) => (
          <li data-nav-mobile-item>
            <a href={s.href} class="flex items-center gap-3.5 rounded-[10px] p-3 active:bg-mist">
              <span class="grid size-10 shrink-0 place-items-center rounded-lg bg-mist text-ink">
                <MorphIcon icon={serviceIcons[s.href] ?? ArrowRight} size={20} strokeWidth={1.75} spring="snappy" reducedMotion="user" />
              </span>
              <span class="text-base font-semibold text-ink">{s.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <ul class="mt-2 border-t border-ink/10 pt-2">
      {
        links.map((l) => (
          <li data-nav-mobile-item>
            <a href={l.href} class="flex items-center justify-between rounded-[10px] px-3 py-3.5 text-base font-semibold text-ink active:bg-mist">
              {l.label}
              <span class="text-muted">
                <MorphIcon icon={ArrowRight} size={16} strokeWidth={2} spring="snappy" reducedMotion="user" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  import { gsap } from "gsap";
  import {
    ArrowRight,
    ArrowUpRight,
    ChevronDown,
    ChevronUp,
    Clapperboard,
    Flame,
    Globe,
    LayoutTemplate,
    Menu,
    Mic,
    Sparkles,
    Users,
    Video,
    X,
    type IconNode,
  } from "lucide";

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  const SERVICE_REST: Record<string, IconNode> = {
    "/services/booking": Mic,
    "/services/linkedin": Users,
    "/services/content": Video,
    "/services/web-design": Globe,
  };
  const SERVICE_HOVER: Record<string, IconNode> = {
    "/services/booking": Flame,
    "/services/linkedin": Sparkles,
    "/services/content": Clapperboard,
    "/services/web-design": LayoutTemplate,
  };

  let controller: AbortController | null = null;

  function initNav() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    // Desplegable de Services (escritorio)
    const dropdown = document.querySelector<HTMLElement>("[data-dropdown]");
    const ddButton = dropdown?.querySelector<HTMLButtonElement>("[data-dropdown-button]");
    const ddPanel = dropdown?.querySelector<HTMLElement>("[data-dropdown-panel]");
    const chevron = dropdown?.querySelector<MorphEl>("[data-chevron]");
    const ddItems = ddPanel ? [...ddPanel.querySelectorAll<HTMLElement>("[data-nav-dd-item], [data-nav-all]")] : [];
    let ddTween: gsap.core.Timeline | gsap.core.Tween | null = null;

    const setDropdown = (open: boolean, immediate = false) => {
      if (!ddButton || !ddPanel) return;
      const wasOpen = ddButton.getAttribute("aria-expanded") === "true";
      if (wasOpen === open && !immediate) return;
      ddButton.setAttribute("aria-expanded", String(open));
      if (wasOpen !== open) chevron?.morphTo?.(open ? ChevronUp : ChevronDown);

      ddTween?.kill();
      if (immediate || reduce.matches) {
        gsap.set(ddPanel, { clearProps: "opacity,visibility,transform" });
        ddPanel.classList.toggle("hidden", !open);
        return;
      }

      if (open) {
        ddPanel.classList.remove("hidden");
        const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
        tl.fromTo(
          ddPanel,
          { autoAlpha: 0, y: -8, scale: 0.98 },
          { autoAlpha: 1, y: 0, scale: 1, duration: 0.24, clearProps: "transform,opacity,visibility" },
        );
        if (ddItems.length) {
          tl.fromTo(
            ddItems,
            { autoAlpha: 0, y: -4 },
            { autoAlpha: 1, y: 0, duration: 0.22, stagger: 0.025, clearProps: "transform,opacity,visibility" },
            0.03,
          );
        }
        ddTween = tl;
      } else {
        ddTween = gsap.to(ddPanel, {
          autoAlpha: 0,
          y: -6,
          scale: 0.985,
          duration: 0.14,
          ease: "power2.in",
          onComplete: () => {
            ddPanel.classList.add("hidden");
            gsap.set(ddPanel, { clearProps: "opacity,visibility,transform" });
          },
        });
      }
    };

    ddButton?.addEventListener("click", () => setDropdown(ddButton.getAttribute("aria-expanded") !== "true"), { signal });
    document.addEventListener(
      "click",
      (e) => {
        if (dropdown && !dropdown.contains(e.target as Node)) setDropdown(false);
      },
      { signal },
    );

    // Iconos interactivos dentro del desplegable de Services
    ddPanel?.querySelectorAll<HTMLAnchorElement>("[data-nav-service]").forEach((item) => {
      const href = item.dataset.navService ?? "";
      const icon = item.querySelector<MorphEl>("[data-nav-service-icon]");
      const onEnter = () => {
        if (SERVICE_HOVER[href]) icon?.morphTo?.(SERVICE_HOVER[href]);
      };
      const onLeave = () => {
        if (SERVICE_REST[href]) icon?.morphTo?.(SERVICE_REST[href]);
      };
      item.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      item.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      item.addEventListener("focus", onEnter, { signal });
      item.addEventListener("blur", onLeave, { signal });
    });

    const allLink = ddPanel?.querySelector<HTMLAnchorElement>("[data-nav-all]");
    if (allLink) {
      const arrowWrap = allLink.querySelector<HTMLElement>("[data-nav-all-arrow-wrap]");
      const arrowIcon = allLink.querySelector<MorphEl>("[data-nav-all-arrow]");
      const nudgeX = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.22, ease: "power3.out" }) : null;
      const onEnter = () => {
        arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) nudgeX?.(3);
      };
      const onLeave = () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) nudgeX?.(0);
      };
      allLink.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      allLink.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      allLink.addEventListener("focus", onEnter, { signal });
      allLink.addEventListener("blur", onLeave, { signal });
    }

    // Menú móvil: el icono de menú se transforma en X y el panel entra con GSAP
    const menuButton = document.querySelector<HTMLButtonElement>("[data-menu-button]");
    const menuPanel = document.querySelector<HTMLElement>("[data-menu-panel]");
    const menuIcon = menuButton?.querySelector<MorphEl>("[data-menu-icon]");
    const menuItems = menuPanel ? [...menuPanel.querySelectorAll<HTMLElement>("[data-nav-mobile-item]")] : [];
    let menuTween: gsap.core.Timeline | gsap.core.Tween | null = null;

    const setMenu = (open: boolean, immediate = false) => {
      if (!menuButton || !menuPanel) return;
      const wasOpen = menuButton.getAttribute("aria-expanded") === "true";
      if (wasOpen === open && !immediate) return;
      menuButton.setAttribute("aria-expanded", String(open));
      menuButton.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      if (wasOpen !== open) menuIcon?.morphTo?.(open ? X : Menu);
      document.documentElement.classList.toggle("overflow-hidden", open);

      menuTween?.kill();
      if (immediate || reduce.matches) {
        gsap.set(menuPanel, { clearProps: "opacity,visibility,transform" });
        menuPanel.classList.toggle("hidden", !open);
        return;
      }

      if (open) {
        menuPanel.classList.remove("hidden");
        const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
        tl.fromTo(
          menuPanel,
          { autoAlpha: 0, y: -10, scale: 0.98 },
          { autoAlpha: 1, y: 0, scale: 1, duration: 0.26, clearProps: "transform,opacity,visibility" },
        );
        if (menuItems.length) {
          tl.fromTo(
            menuItems,
            { autoAlpha: 0, x: -8 },
            { autoAlpha: 1, x: 0, duration: 0.24, stagger: 0.025, clearProps: "transform,opacity,visibility" },
            0.03,
          );
        }
        menuTween = tl;
      } else {
        menuTween = gsap.to(menuPanel, {
          autoAlpha: 0,
          y: -8,
          scale: 0.985,
          duration: 0.15,
          ease: "power2.in",
          onComplete: () => {
            menuPanel.classList.add("hidden");
            gsap.set(menuPanel, { clearProps: "opacity,visibility,transform" });
          },
        });
      }
    };

    menuButton?.addEventListener("click", () => setMenu(menuButton.getAttribute("aria-expanded") !== "true"), { signal });

    // Cerrar el panel móvil al hacer clic en un enlace (p. ej. ancla /#about)
    menuPanel?.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => setMenu(false, true), { signal });
    });

    document.addEventListener(
      "keydown",
      (e) => {
        if (e.key !== "Escape") return;
        if (ddButton?.getAttribute("aria-expanded") === "true") {
          setDropdown(false);
          ddButton.focus();
        }
        if (menuButton?.getAttribute("aria-expanded") === "true") {
          setMenu(false);
          menuButton.focus();
        }
      },
      { signal },
    );

    // Al cambiar de página con ClientRouter, todo se cierra
    document.addEventListener(
      "astro:before-swap",
      () => {
        setMenu(false, true);
        setDropdown(false, true);
      },
      { signal, once: true },
    );
  }

  /*
    Tono de la barra según la SECCIÓN que tiene debajo, no según cada elemento: así cambia una sola vez al pasar
    de una sección a otra, aunque dentro haya tarjetas, fotos o vídeos de otros colores.
  */
  function luminance(color: string) {
    const m = color.match(/rgba?\(([^)]+)\)/) ?? color.match(/color\(srgb ([^)]+)\)/);
    if (!m) return null;
    const scale = color.startsWith("color(") ? 255 : 1;
    const parts = m[1].split(/[ ,/]+/).filter(Boolean).map(Number);
    const [r, g, b] = parts.map((v, i) => (i < 3 ? v * scale : v));
    const a = parts[3] ?? 1;
    if (a < 0.5) return null;
    const lin = (c: number) => ((c /= 255) <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4);
    return 0.2126 * lin(r) + 0.7152 * lin(g) + 0.0722 * lin(b);
  }

  function initNavTheme(signal: AbortSignal) {
    const header = document.querySelector<HTMLElement>("[data-nav]");
    const bar = header?.querySelector<HTMLElement>("nav");
    if (!header || !bar) return;

    const blocks = () => {
      const main = document.querySelector("main");
      const list: HTMLElement[] = [];
      for (const el of document.body.children) {
        if (!(el instanceof HTMLElement) || el.contains(header) || el.tagName === "SCRIPT") continue;
        if (el === main) list.push(...([...main.children].filter((c) => c instanceof HTMLElement) as HTMLElement[]));
        else list.push(el);
      }
      return list;
    };

    const themes = new WeakMap<HTMLElement, "light" | "dark">();
    const themeOf = (block: HTMLElement): "light" | "dark" => {
      const cached = themes.get(block);
      if (cached) return cached;
      let theme: "light" | "dark" = "light";
      const forced = block.dataset.navTheme ?? block.querySelector<HTMLElement>(":scope > [data-nav-theme]")?.dataset.navTheme;
      if (forced === "light" || forced === "dark") theme = forced;
      else {
        let el: Element | null = block;
        for (let depth = 0; el && depth < 4; depth++, el = el.firstElementChild) {
          const l = luminance(getComputedStyle(el).backgroundColor);
          if (l !== null) {
            theme = l > 0.4 ? "dark" : "light";
            break;
          }
        }
      }
      themes.set(block, theme);
      return theme;
    };

    let queued = false;
    const update = () => {
      queued = false;
      const r = bar.getBoundingClientRect();
      const y = r.top + r.height / 2;
      const block = blocks().find((el) => {
        const b = el.getBoundingClientRect();
        return b.height > 0 && b.top <= y && b.bottom > y;
      });
      if (!block) return;
      const theme = themeOf(block);
      if (header.dataset.navTheme !== theme) header.dataset.navTheme = theme;
    };
    const queue = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    addEventListener("scroll", queue, { passive: true, signal });
    addEventListener("resize", queue, { signal });
    update();
  }

  document.addEventListener("astro:page-load", () => {
    initNav();
    if (controller) initNavTheme(controller.signal);
  });
</script>
