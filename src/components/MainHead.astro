---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import { bookingUrl } from "../data/site";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogType?: "website" | "article";
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogType = "website",
  image = "/og-image.png",
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://www.brux.site");
const gaId = (import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "").trim();
const canonicalUrl = canonical
  ? new URL(canonical, siteUrl).href
  : new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(image, siteUrl).href;

const organizationSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://www.brux.site/#organization",
      "name": "Brux",
      "url": "https://www.brux.site/",
      "logo": new URL("/og-image.png", siteUrl).href,
      "description": "Speaker booking agency and LinkedIn management for keynote speakers. 0% commission on speaking fees.",
      "sameAs": [
        "https://www.linkedin.com/in/everth-ferrer/",
        "https://www.linkedin.com/in/jhon-perozo/",
      ],
      "founder": [
        {
          "@type": "Person",
          "name": "Everth Ferrer",
          "jobTitle": "CEO & Co-Founder",
          "sameAs": "https://www.linkedin.com/in/everth-ferrer/",
        },
        {
          "@type": "Person",
          "name": "Jhon Perozo",
          "jobTitle": "Co-Founder & Head of Web",
          "sameAs": "https://www.linkedin.com/in/jhon-perozo/",
        },
      ],
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "Strategy Call",
        "url": bookingUrl
      }
    },
    {
      "@type": "WebSite",
      "@id": "https://www.brux.site/#website",
      "url": "https://www.brux.site/",
      "name": "Brux",
      "description": "Speaker booking agency and LinkedIn management for keynote speakers.",
      "publisher": {
        "@id": "https://www.brux.site/#organization"
      }
    }
  ]
};
---
<head>
	<meta charset="utf-8" />
	<link rel="icon" href="/favicon.ico" />
	<meta name="viewport" content="width=device-width" />
	<meta name="generator" content={Astro.generator} />
	<Font cssVariable="--font-brux" preload />
	<title>{title}</title>
	{description && <meta name="description" content={description} />}
	<link rel="canonical" href={canonicalUrl} />
	{noindex && <meta name="robots" content="noindex, nofollow" />}
	<meta property="og:site_name" content="Brux" />
	<meta property="og:type" content={ogType} />
	<meta property="og:title" content={title} />
	{description && <meta property="og:description" content={description} />}
	<meta property="og:url" content={canonicalUrl} />
	<meta property="og:image" content={ogImageUrl} />
	<meta property="og:image:width" content="1200" />
	<meta property="og:image:height" content="630" />
	<meta property="og:image:alt" content="Brux: Speaker Booking Agency for Keynote Speakers, 0% Commission" />
	<meta name="twitter:card" content="summary_large_image" />
	<meta name="twitter:title" content={title} />
	{description && <meta name="twitter:description" content={description} />}
	<meta name="twitter:image" content={ogImageUrl} />
	<meta name="twitter:image:alt" content="Brux: Speaker Booking Agency for Keynote Speakers, 0% Commission" />
	<script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
	{gaId && (
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){window.dataLayer.push(arguments);}
			gtag("consent", "default", {
				ad_storage: "denied",
				ad_user_data: "denied",
				ad_personalization: "denied",
				analytics_storage: "denied",
				wait_for_update: 500
			});
		</script>
	)}
	<ClientRouter />
	<slot />
</head>
