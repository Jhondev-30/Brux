---
import { Film, Clapperboard, FileBadge, Sparkles, Play } from "@lucide/astro";
import Button from "../ui/Button.astro";
import CtaButton from "../ui/CtaButton.astro";
import { bookingUrl } from "../../data/site";

const words = (text: string) => text.trim().split(/\s+/);
const maskClass =
  "inline-block overflow-clip align-top pt-[0.06em] pb-[0.14em] px-[0.04em] -mt-[0.06em] -mb-[0.14em] -mx-[0.04em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";
---

<section
  class="content-hero relative isolate overflow-hidden bg-ink pt-[max(8.5rem,calc(4.5rem+6svh))] pb-20 text-paper sm:pb-24 lg:pb-28"
  aria-labelledby="content-hero-title"
  data-content-hero
>
  <!-- Full-hero ambient crimson glow & GSAP cinema-wave particle canvas -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-20"
    style="background:
      radial-gradient(ellipse 58% 64% at 74% 50%, rgba(229, 12, 19, 0.16) 0%, rgba(229, 12, 19, 0.05) 42%, transparent 74%),
      radial-gradient(ellipse 40% 45% at 22% 72%, rgba(229, 12, 19, 0.06) 0%, transparent 70%);"
  ></div>

  <canvas
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
    data-ch-canvas
  ></canvas>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-on-ink" data-ch-crumb>
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a
            href="/"
            class="transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
          >
            Home
          </a>
        </li>
        <li aria-hidden="true" class="text-paper/35">/</li>
        <li>
          <a
            href="/services/"
            class="transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
          >
            Services
          </a>
        </li>
        <li aria-hidden="true" class="text-paper/35">/</li>
        <li aria-current="page" class="font-semibold text-paper">Speaker Content</li>
      </ol>
    </nav>

    <div class="mt-6 grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Copy column -->
      <div class="relative z-10 lg:col-span-6">
        <h1
          id="content-hero-title"
          class="text-[clamp(2.25rem,1.5rem+3.1vw,4rem)] leading-[1.03] font-extrabold tracking-[-0.025em] text-balance text-paper"
          data-ch-title
        >
          {words("Demo reels, press kits, and talk clips that prove you own the room").map((w, j, a) => (
            <>
              <span class={maskClass}><span class={wordClass} data-ch-word>{w}</span></span>
              {j < a.length - 1 && " "}
            </>
          ))}
        </h1>

        <p
          class="mt-6 max-w-[38rem] text-[clamp(1.0625rem,1rem+0.3vw,1.25rem)] leading-relaxed text-pretty text-muted-on-ink"
          data-ch-lead
        >
          Organizers want to hear how you sound on stage before they reply to a pitch. Brux cuts your talks into a three-minute speaker reel, designs a sharp press kit, and edits talk clips for LinkedIn.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6" data-ch-ctas>
          <CtaButton href={bookingUrl}>Book a strategy call</CtaButton>
          <Button href="/pricing/" variant="link" class="justify-center sm:justify-start">
            See plans &amp; pricing
          </Button>
        </div>
      </div>

      <!-- 3D Stage Reel & Press Kit Production Studio (seamless bg-ink spatial scene) -->
      <div class="relative lg:col-span-6" aria-hidden="true" data-ch-visual>
        <div
          class="ch-perspective relative mx-auto flex aspect-[4/3] w-full max-w-[36rem] items-center justify-center sm:aspect-[11/9]"
          data-ch-stage
        >
          <!-- Soft crimson stage glow -->
          <div
            class="pointer-events-none absolute left-1/2 top-1/2 h-56 w-56 -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl sm:h-64 sm:w-64"
            style="background: radial-gradient(circle, rgba(229, 12, 19, 0.34) 0%, rgba(229, 12, 19, 0.08) 54%, transparent 78%);"
            data-ch-aura
          ></div>

          <div class="ch-3d-rig relative h-full w-full" data-ch-rig>
            <!-- Angled 3D multi-track timeline & cinema viewport frames -->
            <div class="ch-frames pointer-events-none absolute inset-0 flex items-center justify-center">
              <!-- Back timeline tracks layer -->
              <div
                class="ch-layer-back flex h-[60%] w-[74%] flex-col justify-end gap-2 rounded-[20px] border border-paper/12 bg-paper/[0.015] p-4"
                data-ch-layer="back"
              >
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-12 rounded-full bg-paper/20"></span>
                  <span class="h-1.5 w-20 rounded-full bg-stage/45"></span>
                  <span class="h-1.5 flex-1 rounded-full bg-paper/12"></span>
                </div>
                <div class="flex items-center gap-2">
                  <span class="h-1.5 w-16 rounded-full bg-stage-glow/40"></span>
                  <span class="h-1.5 flex-1 rounded-full bg-paper/16"></span>
                  <span class="h-1.5 w-10 rounded-full bg-paper/10"></span>
                </div>
              </div>

              <!-- Mid cinema frame & audio spectrum markers -->
              <div
                class="ch-layer-mid absolute flex h-[48%] w-[56%] items-end justify-between rounded-[18px] border border-stage-glow/30 bg-stage/[0.025] p-3.5"
                data-ch-layer="mid"
              >
                <div class="flex items-end gap-1" data-ch-bars>
                  <span class="h-2 w-1 rounded-full bg-stage-glow/65"></span>
                  <span class="h-4 w-1 rounded-full bg-stage-glow/85"></span>
                  <span class="h-3 w-1 rounded-full bg-paper/45"></span>
                  <span class="h-5 w-1 rounded-full bg-stage-glow"></span>
                  <span class="h-2.5 w-1 rounded-full bg-paper/40"></span>
                </div>
                <span class="text-[11px] font-bold tracking-[0.08em] text-paper/75 uppercase">
                  03:00 Cut
                </span>
              </div>
            </div>

            <!-- SVG curved editorial flow lines -->
            <svg
              class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"
              viewBox="0 0 560 440"
              fill="none"
            >
              <defs>
                <linearGradient id="ch-beam-red" x1="280" y1="220" x2="454" y2="328" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FF4D47" stop-opacity="0.92" />
                  <stop offset="100%" stop-color="#E50C13" stop-opacity="0.18" />
                </linearGradient>
                <linearGradient id="ch-beam-soft" x1="280" y1="220" x2="108" y2="112" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.42" />
                  <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.06" />
                </linearGradient>
              </defs>

              <path
                d="M280 220 Q 192 148 108 112"
                stroke="url(#ch-beam-soft)"
                stroke-width="1.25"
                stroke-dasharray="4 6"
                data-ch-beam
              />
              <path
                d="M280 220 Q 368 142 452 108"
                stroke="url(#ch-beam-red)"
                stroke-width="1.5"
                data-ch-beam
              />
              <path
                d="M280 220 Q 186 288 104 326"
                stroke="url(#ch-beam-soft)"
                stroke-width="1.25"
                stroke-dasharray="4 6"
                data-ch-beam
              />
              <path
                d="M280 220 Q 374 294 456 328"
                stroke="url(#ch-beam-red)"
                stroke-width="1.75"
                data-ch-beam
              />

              <circle r="3" fill="#FFFFFF" fill-opacity="0.82" data-ch-packet="0" />
              <circle r="3.4" fill="#FF4D47" data-ch-packet="1" />
              <circle r="3" fill="#FFFFFF" fill-opacity="0.78" data-ch-packet="2" />
              <circle r="4" fill="#FF4D47" data-ch-packet="3" />
            </svg>

            <!-- Central open luminous stage-cut emblem (no dark disc) -->
            <div
              class="ch-core absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-2.5"
              data-ch-core
            >
              <div class="relative flex h-14 w-14 items-center justify-center rounded-2xl bg-stage/25 text-paper ring-1 ring-stage-glow/65 shadow-[0_0_40px_rgba(229,12,19,0.7)] backdrop-blur-xs sm:h-16 sm:w-16">
                <div class="pointer-events-none absolute inset-[-10px] rounded-[22px] border border-stage-glow/45" data-ch-pulse></div>
                <Play class="ml-0.5 h-6 w-6 fill-paper/20 text-paper" stroke-width={2} />
              </div>
              <span class="rounded-full bg-ink/65 px-2.5 py-0.5 text-[10px] font-bold tracking-[0.14em] text-paper/90 uppercase backdrop-blur-xs">
                Stage Proof
              </span>
            </div>

            <!-- Node 1: Raw Stage Footage -->
            <div
              class="ch-node ch-node-tl absolute left-[2%] top-[13%] flex items-center gap-2.5 rounded-full border border-paper/14 bg-ink/84 px-3.5 py-2 backdrop-blur-md sm:left-[4%] sm:top-[15%]"
              data-ch-node="0"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-paper/10 text-paper/85">
                <Clapperboard class="h-3.5 w-3.5" />
              </span>
              <div class="leading-tight">
                <p class="text-[11px] font-semibold text-paper">Raw Keynote Footage</p>
                <p class="text-[10px] text-muted-on-ink">Hooks &amp; stage audio</p>
              </div>
            </div>

            <!-- Node 2: 3-Minute Demo Reel -->
            <div
              class="ch-node ch-node-tr absolute right-[2%] top-[11%] flex items-center gap-2.5 rounded-full border border-stage-glow/32 bg-ink/84 px-3.5 py-2 shadow-[0_12px_28px_-14px_rgba(229,12,19,0.45)] backdrop-blur-md sm:right-[4%] sm:top-[13%]"
              data-ch-node="1"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stage/22 text-stage-glow">
                <Film class="h-3.5 w-3.5" />
              </span>
              <div class="leading-tight">
                <p class="text-[11px] font-semibold text-paper">3-Min Demo Reel</p>
                <p class="text-[10px] text-stage-glow">Built for buyers</p>
              </div>
            </div>

            <!-- Node 3: LinkedIn Vertical Clips -->
            <div
              class="ch-node ch-node-bl absolute bottom-[14%] left-[2%] flex items-center gap-2.5 rounded-full border border-paper/14 bg-ink/84 px-3.5 py-2 backdrop-blur-md sm:bottom-[15%] sm:left-[3%]"
              data-ch-node="2"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-paper/10 text-paper/85">
                <Sparkles class="h-3.5 w-3.5" />
              </span>
              <div class="leading-tight">
                <p class="text-[11px] font-semibold text-paper">Captioned Talk Clips</p>
                <p class="text-[10px] text-muted-on-ink">Ready for LinkedIn</p>
              </div>
            </div>

            <!-- Node 4: One-Sheet Press Kit -->
            <div
              class="ch-node ch-node-br absolute bottom-[11%] right-[1%] flex items-center gap-2.5 rounded-full border border-stage-glow/55 bg-stage/18 px-4 py-2.5 shadow-[0_16px_38px_-12px_rgba(229,12,19,0.65)] backdrop-blur-md sm:bottom-[13%] sm:right-[3%]"
              data-ch-node="3"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stage text-paper">
                <FileBadge class="h-3.5 w-3.5" stroke-width={2.25} />
              </span>
              <div class="leading-tight">
                <p class="text-xs font-bold text-paper">One-Sheet Press Kit</p>
                <p class="text-[10px] font-semibold text-stage-glow">Forwarded to committees</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .ch-perspective {
    perspective: 1100px;
  }

  .ch-3d-rig {
    transform-style: preserve-3d;
  }

  .ch-frames {
    transform-style: preserve-3d;
    transform: rotateX(18deg) rotateY(-14deg) rotateZ(-3deg);
  }

  .ch-layer-back {
    transform: translateZ(-28px);
  }

  .ch-layer-mid {
    transform: translateZ(14px);
    box-shadow: inset 0 0 36px rgba(229, 12, 19, 0.12);
  }

  .ch-core {
    transform: translateZ(36px);
  }

  .ch-node-tl {
    transform: translateZ(20px);
  }

  .ch-node-tr {
    transform: translateZ(44px);
  }

  .ch-node-bl {
    transform: translateZ(16px);
  }

  .ch-node-br {
    transform: translateZ(56px);
  }
</style>

<script>
  import { gsap } from "gsap";

  interface StageDust {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    alpha: number;
    crimson: boolean;
    phase: number;
  }

  let cleanupContentHero: (() => void) | null = null;

  function initContentHero() {
    cleanupContentHero?.();
    cleanupContentHero = null;

    const root = document.querySelector<HTMLElement>("[data-content-hero]");
    if (!root) return;

    const canvas = root.querySelector<HTMLCanvasElement>("[data-ch-canvas]");
    const rig = root.querySelector<HTMLElement>("[data-ch-rig]");
    const stage = root.querySelector<HTMLElement>("[data-ch-stage]");
    const aura = root.querySelector<HTMLElement>("[data-ch-aura]");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let rafTick: (() => void) | null = null;
    let ro: ResizeObserver | null = null;
    let io: IntersectionObserver | null = null;
    let mm: gsap.MatchMedia | null = null;
    let removePointer: (() => void) | null = null;

    // 1. GSAP-driven cinema stage particle universe
    if (canvas) {
      const ctx = canvas.getContext("2d");
      if (ctx) {
        let w = 0;
        let h = 0;
        let dpr = 1;
        let inView = true;
        const pointer = { x: -9999, y: -9999 };
        const dust: StageDust[] = [];

        const buildDust = () => {
          dust.length = 0;
          const count = Math.min(72, Math.max(32, Math.round((w * h) / 16000)));
          for (let i = 0; i < count; i++) {
            dust.push({
              x: Math.random(),
              y: Math.random(),
              vx: (Math.random() - 0.5) * 0.00038,
              vy: -0.00018 - Math.random() * 0.00028,
              size: 1.0 + Math.random() * 1.9,
              alpha: 0.16 + Math.random() * 0.48,
              crimson: i % 3 !== 0,
              phase: Math.random() * Math.PI * 2,
            });
          }
        };

        const resize = () => {
          const rect = root.getBoundingClientRect();
          w = rect.width;
          h = rect.height;
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.max(1, Math.floor(w * dpr));
          canvas.height = Math.max(1, Math.floor(h * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          buildDust();
        };

        resize();
        ro = new ResizeObserver(resize);
        ro.observe(root);

        const draw = (tSec: number) => {
          ctx.clearRect(0, 0, w, h);

          for (const d of dust) {
            if (!reduce) {
              d.x += d.vx;
              d.y += d.vy;
              if (d.x < 0) d.x = 1;
              if (d.x > 1) d.x = 0;
              if (d.y < 0) d.y = 1;
            }

            let px = d.x * w;
            let py = d.y * h;

            const dx = px - pointer.x;
            const dy = py - pointer.y;
            const dist = Math.hypot(dx, dy);
            if (dist < 130 && dist > 0.1) {
              const push = ((130 - dist) / 130) * 14;
              px += (dx / dist) * push;
              py += (dy / dist) * push;
            }

            const pulse = reduce ? 1 : 0.72 + 0.28 * Math.sin(tSec * 1.6 + d.phase);
            const alpha = d.alpha * pulse;

            ctx.beginPath();
            ctx.arc(px, py, d.size, 0, Math.PI * 2);
            ctx.fillStyle = d.crimson
              ? `rgba(255, 77, 71, ${alpha.toFixed(3)})`
              : `rgba(255, 255, 255, ${(alpha * 0.52).toFixed(3)})`;
            ctx.fill();
          }
        };

        draw(0);

        if (!reduce) {
          const tick = () => {
            if (!inView) return;
            draw(performance.now() * 0.001);
          };
          rafTick = tick;
          gsap.ticker.add(tick);

          io = new IntersectionObserver(
            ([entry]) => {
              inView = Boolean(entry?.isIntersecting);
            },
            { threshold: 0.05 },
          );
          io.observe(root);

          const onMove = (e: PointerEvent) => {
            const rect = root.getBoundingClientRect();
            pointer.x = e.clientX - rect.left;
            pointer.y = e.clientY - rect.top;
          };
          const onLeave = () => {
            pointer.x = -9999;
            pointer.y = -9999;
          };
          root.addEventListener("pointermove", onMove, { passive: true });
          root.addEventListener("pointerleave", onLeave, { passive: true });
          removePointer = () => {
            root.removeEventListener("pointermove", onMove);
            root.removeEventListener("pointerleave", onLeave);
          };
        }
      }
    }

    // 2. Bang Motion entrance, waveform pulse, packets & gentle 3D gyro parallax
    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const crumb = root.querySelector("[data-ch-crumb]");
        const wordEls = root.querySelectorAll("[data-ch-word]");
        const lead = root.querySelector("[data-ch-lead]");
        const ctas = root.querySelector("[data-ch-ctas]");
        const layers = root.querySelectorAll("[data-ch-layer]");
        const core = root.querySelector("[data-ch-core]");
        const nodes = root.querySelectorAll("[data-ch-node]");
        const beams = root.querySelectorAll("[data-ch-beam]");
        const pulse = root.querySelector("[data-ch-pulse]");
        const bars = root.querySelectorAll("[data-ch-bars] > span");

        const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
        tl.from(crumb, { y: 12, opacity: 0, duration: 0.5, clearProps: "transform,opacity" })
          .fromTo(
            wordEls,
            { yPercent: 112, rotate: 5 },
            { yPercent: 0, rotate: 0, duration: 0.95, stagger: 0.045, clearProps: "transform" },
            0.05,
          )
          .from(lead, { y: 18, opacity: 0, duration: 0.7, clearProps: "transform,opacity" }, 0.25)
          .from(ctas, { y: 16, opacity: 0, duration: 0.65, clearProps: "transform,opacity" }, 0.34)
          .from(
            layers,
            { scale: 0.86, opacity: 0, duration: 0.95, stagger: 0.1, ease: "power3.out" },
            0.14,
          )
          .from(core, { scale: 0.82, opacity: 0, duration: 0.85 }, 0.2)
          .from(beams, { opacity: 0, duration: 0.8, stagger: 0.07 }, 0.28)
          .from(nodes, { y: 16, scale: 0.92, opacity: 0, duration: 0.75, stagger: 0.08 }, 0.32);

        if (pulse) {
          gsap.fromTo(
            pulse,
            { scale: 0.94, opacity: 0.62 },
            {
              scale: 1.52,
              opacity: 0,
              duration: 2.6,
              repeat: -1,
              ease: "power2.out",
            },
          );
        }

        if (aura) {
          gsap.to(aura, {
            scale: 1.12,
            opacity: 0.9,
            duration: 3.4,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
          });
        }

        bars.forEach((bar, idx) => {
          gsap.to(bar, {
            scaleY: idx % 2 === 0 ? 1.55 : 0.6,
            transformOrigin: "bottom center",
            duration: 0.75 + idx * 0.16,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
          });
        });

        nodes.forEach((node, idx) => {
          gsap.to(node, {
            y: idx % 2 === 0 ? -6 : 6,
            duration: 2.9 + idx * 0.45,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
          });
        });

        const quadCurves: Array<[number, number, number, number, number, number]> = [
          [280, 220, 192, 148, 108, 112],
          [280, 220, 368, 142, 452, 108],
          [280, 220, 186, 288, 104, 326],
          [280, 220, 374, 294, 456, 328],
        ];
        quadCurves.forEach((pts, idx) => {
          const el = root.querySelector<SVGCircleElement>(`[data-ch-packet="${idx}"]`);
          if (!el) return;
          const [x0, y0, cx, cy, x1, y1] = pts;
          const proxy = { t: 0 };
          gsap.set(el, { attr: { cx: x0, cy: y0 }, opacity: 0 });
          gsap
            .timeline({ repeat: -1, delay: idx * 0.55, repeatDelay: 0.45 })
            .to(el, { opacity: 1, duration: 0.15, ease: "none" })
            .to(
              proxy,
              {
                t: 1,
                duration: 1.75,
                ease: "power2.inOut",
                onUpdate: () => {
                  const t = proxy.t;
                  const inv = 1 - t;
                  const px = inv * inv * x0 + 2 * inv * t * cx + t * t * x1;
                  const py = inv * inv * y0 + 2 * inv * t * cy + t * t * y1;
                  el.setAttribute("cx", px.toFixed(1));
                  el.setAttribute("cy", py.toFixed(1));
                },
              },
              0,
            )
            .to(el, { opacity: 0, duration: 0.22, ease: "none" }, "-=0.22");
        });

        if (rig && stage) {
          const rxTo = gsap.quickTo(rig, "rotationX", { duration: 0.9, ease: "power3.out" });
          const ryTo = gsap.quickTo(rig, "rotationY", { duration: 0.9, ease: "power3.out" });
          const xTo = gsap.quickTo(rig, "x", { duration: 0.9, ease: "power3.out" });
          const yTo = gsap.quickTo(rig, "y", { duration: 0.9, ease: "power3.out" });

          const onHeroPointer = (e: PointerEvent) => {
            if (e.pointerType !== "mouse") return;
            const rect = root.getBoundingClientRect();
            const nx = (e.clientX - rect.left) / Math.max(1, rect.width) - 0.5;
            const ny = (e.clientY - rect.top) / Math.max(1, rect.height) - 0.5;
            ryTo(nx * 10);
            rxTo(-ny * 8);
            xTo(nx * 10);
            yTo(ny * 8);
          };
          const onHeroLeave = () => {
            rxTo(0);
            ryTo(0);
            xTo(0);
            yTo(0);
          };

          root.addEventListener("pointermove", onHeroPointer, { passive: true });
          root.addEventListener("pointerleave", onHeroLeave, { passive: true });
          return () => {
            root.removeEventListener("pointermove", onHeroPointer);
            root.removeEventListener("pointerleave", onHeroLeave);
          };
        }
      }, root);

      return () => ctx.revert();
    });

    cleanupContentHero = () => {
      if (rafTick) gsap.ticker.remove(rafTick);
      ro?.disconnect();
      io?.disconnect();
      removePointer?.();
      mm?.revert();
    };
  }

  initContentHero();
  document.addEventListener("astro:page-load", initContentHero);
  document.addEventListener("astro:before-swap", () => {
    cleanupContentHero?.();
    cleanupContentHero = null;
  });
</script>
