---
import Button from "../ui/Button.astro";
import CtaButton from "../ui/CtaButton.astro";
import { bookingUrl } from "../../data/site";

const words = (s: string) => s.split(" ");
const maskClass =
  "inline-block overflow-clip align-top pt-[0.06em] pb-[0.14em] px-[0.04em] -mt-[0.06em] -mb-[0.14em] -mx-[0.04em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";

/* 8 capas Z para extrusión 3D real únicamente de la X de BRUX */
const xDepthLayers = [
  { z: -36, wFill: "#200305", rFill: "#330407", opacity: 0.85 },
  { z: -31, wFill: "#330608", rFill: "#4d0509", opacity: 0.88 },
  { z: -26, wFill: "#4a090d", rFill: "#6b070c", opacity: 0.91 },
  { z: -21, wFill: "#660d13", rFill: "#8c090f", opacity: 0.94 },
  { z: -16, wFill: "#85131a", rFill: "#ad0a12", opacity: 0.96 },
  { z: -11, wFill: "#a61a22", rFill: "#c20a18", opacity: 0.98 },
  { z: -6, wFill: "#c4242c", rFill: "#d90b15", opacity: 0.99 },
  { z: -2, wFill: "#dcdcdc", rFill: "#e50c13", opacity: 1 },
];

/* 6 peldaños anchos en perspectiva inclinada, sin sombras oscuras que corten el bloque */
const steps = [
  { width: "36%", y: 0, glow: 0.36, opacity: 0.85 },
  { width: "47%", y: 18, glow: 0.24, opacity: 0.65 },
  { width: "58%", y: 38, glow: 0.16, opacity: 0.45 },
  { width: "70%", y: 60, glow: 0.1, opacity: 0.28 },
  { width: "82%", y: 84, glow: 0.05, opacity: 0.15 },
  { width: "94%", y: 110, glow: 0.02, opacity: 0.06 },
];
---

<section
  class="relative isolate overflow-hidden bg-ink pt-[max(8.5rem,calc(4.5rem+6svh))] pb-20 text-paper sm:pb-28"
  aria-labelledby="services-hero-title"
  data-portal-hero
>
  <!-- Luz roja suave integrada directamente en el mismo fondo bg-ink del hero -->
  <div
    class="pointer-events-none absolute inset-0 -z-20 bg-[radial-gradient(ellipse_62%_78%_at_73%_46%,rgba(229,12,19,0.16)_0%,rgba(255,77,71,0.06)_34%,rgba(10,10,10,0)_80%)]"
    aria-hidden="true"
  >
  </div>

  <!-- Partículas rojas estilo MeetTheTeam (GSAP ticker + quickTo pointer ripple) -->
  <canvas
    class="pointer-events-none absolute inset-0 -z-10 size-full [mask-image:radial-gradient(ellipse_85%_88%_at_58%_50%,black_42%,transparent_100%)]"
    aria-hidden="true"
    data-portal-universe
  ></canvas>

  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-on-ink" data-hub-crumb>
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a href="/" class="transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage">
            Home
          </a>
        </li>
        <li aria-hidden="true" class="text-paper/35">/</li>
        <li aria-current="page" class="font-semibold text-paper">Services</li>
      </ol>
    </nav>

    <div class="mt-6 grid items-center gap-10 lg:grid-cols-12 lg:gap-8">
      <!-- Columna izquierda: copy y CTAs -->
      <div class="relative z-10 lg:col-span-6">
        <h1
          id="services-hero-title"
          class="text-[clamp(2.25rem,1.5rem+3.1vw,4.15rem)] leading-[1.03] font-extrabold tracking-[-0.025em] text-balance text-paper"
          data-hub-title
        >
          {words("Four services built to put keynote speakers on paid stages").map((w, j, a) => (
            <>
              <span class={maskClass}><span class={wordClass} data-hub-word>{w}</span></span>
              {j < a.length - 1 && " "}
            </>
          ))}
        </h1>
        <p
          class="mt-6 max-w-[38rem] text-[clamp(1.0625rem,1rem+0.3vw,1.25rem)] leading-relaxed text-pretty text-paper/88"
          data-hub-lead
        >
          Brux connects direct organizer outreach with LinkedIn positioning, demo reels, press kits, and dedicated speaker websites — all with <strong class="font-semibold text-paper">0% commission</strong> on your speaking fees.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6" data-hub-ctas>
          <CtaButton href={bookingUrl}>Book a strategy call</CtaButton>
          <Button href="/pricing/" variant="link" class="justify-center sm:justify-start">View plans &amp; pricing</Button>
        </div>
      </div>

      <!-- Columna derecha: mismo bg-ink sin cortes ni sombras en la base; luz roja amplia detrás de la X 3D + escalera sutil -->
      <div class="relative lg:col-span-6" data-portal-stage>
        <div
          class="relative mx-auto flex aspect-[4/3] w-full max-w-[38rem] flex-col items-center justify-center [perspective:1100px]"
          aria-hidden="true"
        >
          <!-- Luz roja suave estrictamente DETRÁS de la X -->
          <div
            class="pointer-events-none absolute -top-[4%] left-1/2 -z-10 h-[86%] w-[90%] rounded-full bg-[radial-gradient(circle,rgba(255,95,88,0.22)_0%,rgba(229,12,19,0.12)_38%,rgba(194,10,24,0.04)_64%,rgba(10,10,10,0)_82%)] blur-3xl"
            style="transform: translate3d(-50%, 0, -90px);"
            data-portal-aura
          >
          </div>

          <!-- X de BRUX en 3D flotando en la cima de la escalera (delante de la luz) -->
          <div
            class="relative z-20 -mt-10 flex items-center justify-center [transform-style:preserve-3d]"
            style="transform: translate3d(0, 0, 24px);"
            data-portal-logo-wrap
          >
            <div
              class="relative w-[10.5rem] sm:w-[13rem] [transform-style:preserve-3d] will-change-transform"
              data-portal-logo-3d
            >
              {xDepthLayers.map((layer) => (
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 740 686"
                  class="pointer-events-none absolute inset-0 h-auto w-full"
                  style={`transform: translate3d(0, 0, ${layer.z}px); opacity: ${layer.opacity};`}
                  aria-hidden="true"
                >
                  <path
                    fill={layer.wFill}
                    fill-rule="evenodd"
                    transform="translate(0 686)"
                    d="M740 -686 L620 -686 L384.8 -425.8 L498.2 -300.3ZM0 0 L310 0 L357 -75 L238.6 -264Z"
                  />
                  <path
                    fill={layer.rFill}
                    fill-rule="evenodd"
                    transform="translate(0 686)"
                    d="M0 -686 L120 -686 L740 0 L430 0Z"
                  />
                </svg>
              ))}

              <!-- Cara frontal nítida de la X sin brillo que la tape -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 740 686"
                class="relative h-auto w-full"
                style="transform: translate3d(0, 0, 2px);"
                aria-hidden="true"
              >
                <path
                  fill="#FFFFFF"
                  fill-rule="evenodd"
                  transform="translate(0 686)"
                  d="M740 -686 L620 -686 L384.8 -425.8 L498.2 -300.3ZM0 0 L310 0 L357 -75 L238.6 -264Z"
                />
                <path
                  fill="#E50C13"
                  fill-rule="evenodd"
                  transform="translate(0 686)"
                  d="M0 -686 L120 -686 L740 0 L430 0Z"
                />
              </svg>
            </div>
          </div>

          <!-- Escalera sutil e inclinada integrada en el mismo bg-ink sin sombra en la base -->
          <div
            class="pointer-events-none relative -mt-2 h-[34%] w-[92%] [perspective:700px]"
            data-portal-stairs
          >
            <div class="relative mx-auto h-full w-full origin-top [transform:rotateX(56deg)] [transform-style:preserve-3d]">
              {steps.map((step) => (
                <div
                  class="absolute left-1/2 h-3.5 -translate-x-1/2 rounded-[2px]"
                  style={`top:${step.y}px; width:${step.width}; opacity:${step.opacity}; background:linear-gradient(to bottom, rgba(255,255,255,${step.glow * 0.16}) 0%, rgba(255,77,71,${step.glow * 0.1}) 35%, rgba(10,10,10,0) 100%); box-shadow: 0 -1px 0 rgba(255,115,110,${step.glow});`}
                  data-portal-step
                />
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from "gsap";

  interface Particle {
    ox: number;
    oy: number;
    x: number;
    y: number;
    vx: number;
    vy: number;
    len: number;
    rad: number;
    angle: number;
    baseAngle: number;
    spin: number;
    phase: number;
    driftSpeed: number;
    driftAmp: number;
    alpha: number;
    isBrightRed: boolean;
    isDot: boolean;
  }

  let mm: gsap.MatchMedia | null = null;
  let cleanupPointer: (() => void) | null = null;
  let cleanupUniverse: (() => void) | null = null;

  function initUniverse(root: HTMLElement) {
    const canvas = root.querySelector<HTMLCanvasElement>("[data-portal-universe]");
    const ctx = canvas?.getContext("2d");
    if (!canvas || !ctx) return () => {};

    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");
    const controller = new AbortController();
    const { signal } = controller;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let particles: Particle[] = [];
    let isVisible = false;
    let tickerActive = false;
    let time = 0;

    const pointer = { x: 0, y: 0, strength: 0 };
    const setPX = gsap.quickTo(pointer, "x", { duration: 0.35, ease: "power3.out" });
    const setPY = gsap.quickTo(pointer, "y", { duration: 0.35, ease: "power3.out" });
    const setPS = gsap.quickTo(pointer, "strength", { duration: 0.45, ease: "power2.out" });

    const seedParticles = (w: number, h: number) => {
      const areaCount = Math.round((w * h) / 7800);
      const count = gsap.utils.clamp(55, 150, areaCount);
      /* Centro sesgado hacia la derecha donde brilla la X en 3D */
      const cx = w * 0.62;
      const cy = h * 0.48;
      const list: Particle[] = [];

      for (let i = 0; i < count; i++) {
        const theta = gsap.utils.random(0, Math.PI * 2);
        const ringBias = Math.random() < 0.65 ? gsap.utils.random(0.18, 0.5) : gsap.utils.random(0.05, 0.58);
        const ox = cx + Math.cos(theta) * w * ringBias + gsap.utils.random(-w * 0.14, w * 0.1);
        const oy = cy + Math.sin(theta) * h * ringBias + gsap.utils.random(-h * 0.1, h * 0.1);
        const px = gsap.utils.clamp(14, w - 14, ox);
        const py = gsap.utils.clamp(14, h - 14, oy);
        const isBrightRed = i % 3 === 0;
        const isDot = i % 3 === 0;
        const baseAngle = theta + Math.PI * 0.5;

        list.push({
          ox: px,
          oy: py,
          x: px,
          y: py,
          vx: 0,
          vy: 0,
          len: gsap.utils.random(5, 11),
          rad: isDot ? gsap.utils.random(1.3, 2.4) : gsap.utils.random(1, 1.5),
          angle: baseAngle,
          baseAngle,
          spin: gsap.utils.random(-0.25, 0.25),
          phase: gsap.utils.random(0, Math.PI * 2),
          driftSpeed: gsap.utils.random(0.35, 0.75),
          driftAmp: gsap.utils.random(6, 16),
          alpha: isBrightRed ? gsap.utils.random(0.28, 0.54) : gsap.utils.random(0.16, 0.34),
          isBrightRed,
          isDot,
        });
      }
      particles = list;
    };

    const drawParticles = (dt: number) => {
      if (!width || !height) return;
      time += dt;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      ctx.clearRect(0, 0, width, height);

      const radius = Math.min(200, Math.max(130, width * 0.16));
      const radiusSq = radius * radius;
      const activeForce = pointer.strength;

      for (let i = 0; i < particles.length; i++) {
        const p = particles[i];
        const floatX = p.ox + Math.cos(time * p.driftSpeed + p.phase) * p.driftAmp;
        const floatY = p.oy + Math.sin(time * p.driftSpeed * 0.85 + p.phase) * (p.driftAmp * 0.8);

        let boost = 0;

        if (activeForce > 0.01) {
          const dx = p.x - pointer.x;
          const dy = p.y - pointer.y;
          const distSq = dx * dx + dy * dy;

          if (distSq < radiusSq && distSq > 0.001) {
            const dist = Math.sqrt(distSq);
            const falloff = 1 - dist / radius;
            const push = falloff * falloff * 1.45 * activeForce;
            const nx = dx / dist;
            const ny = dy / dist;

            p.vx += nx * push - ny * push * 0.42;
            p.vy += ny * push + nx * push * 0.42;
            boost = falloff * activeForce;

            const targetAngle = Math.atan2(ny, nx);
            const delta = Math.atan2(Math.sin(targetAngle - p.angle), Math.cos(targetAngle - p.angle));
            p.angle += delta * 0.12;
          }
        }

        p.vx += (floatX - p.x) * 0.045;
        p.vy += (floatY - p.y) * 0.045;
        p.vx *= 0.88;
        p.vy *= 0.88;
        p.x += p.vx;
        p.y += p.vy;

        if (boost < 0.05) {
          const restAngle = p.baseAngle + Math.sin(time * 0.4 + p.phase) * 0.35 + time * p.spin * 0.25;
          const restDelta = Math.atan2(Math.sin(restAngle - p.angle), Math.cos(restAngle - p.angle));
          p.angle += restDelta * 0.04;
        }

        const alpha = gsap.utils.clamp(0.1, 0.88, p.alpha + boost * 0.42);
        const scale = 1 + boost * 0.35;
        /* Partículas rojas de Brux sobre el fondo oscuro */
        ctx.fillStyle = p.isBrightRed ? `rgba(255, 77, 71, ${alpha})` : `rgba(229, 12, 19, ${alpha})`;

        if (p.isDot) {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.rad * scale, 0, Math.PI * 2);
          ctx.fill();
        } else {
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.angle);
          const w = p.len * scale;
          const h = p.rad * 1.8 * scale;
          ctx.beginPath();
          if (ctx.roundRect) {
            ctx.roundRect(-w * 0.5, -h * 0.5, w, h, h * 0.5);
          } else {
            ctx.rect(-w * 0.5, -h * 0.5, w, h);
          }
          ctx.fill();
          ctx.restore();
        }
      }
    };

    const tick = (_time: number, deltaTime: number) => {
      if (!isVisible || document.hidden || reduce.matches) return;
      const dt = Math.min(deltaTime, 50) / 1000;
      drawParticles(dt);
    };

    const syncTicker = () => {
      const shouldRun = isVisible && !reduce.matches;
      if (shouldRun && !tickerActive) {
        gsap.ticker.add(tick);
        tickerActive = true;
      } else if (!shouldRun && tickerActive) {
        gsap.ticker.remove(tick);
        tickerActive = false;
      }
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      width = Math.max(1, Math.round(rect.width));
      height = Math.max(1, Math.round(rect.height));
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      seedParticles(width, height);
      drawParticles(0);
    };

    let resizeRaf = 0;
    const ro = new ResizeObserver(() => {
      cancelAnimationFrame(resizeRaf);
      resizeRaf = requestAnimationFrame(resize);
    });
    ro.observe(canvas);

    const io = new IntersectionObserver(
      (entries) => {
        isVisible = Boolean(entries[0]?.isIntersecting);
        syncTicker();
      },
      { rootMargin: "160px 0px" },
    );
    io.observe(canvas);

    root.addEventListener(
      "pointermove",
      (e) => {
        if (reduce.matches || !finePointer.matches) return;
        const rect = canvas.getBoundingClientRect();
        setPX(e.clientX - rect.left);
        setPY(e.clientY - rect.top);
        if (pointer.strength < 0.99) setPS(1);
      },
      { passive: true, signal },
    );

    root.addEventListener(
      "pointerleave",
      () => {
        setPS(0);
      },
      { passive: true, signal },
    );

    const onVisibility = () => syncTicker();
    document.addEventListener("visibilitychange", onVisibility, { signal });
    reduce.addEventListener("change", syncTicker, { signal });

    resize();

    return () => {
      controller.abort();
      ro.disconnect();
      io.disconnect();
      cancelAnimationFrame(resizeRaf);
      if (tickerActive) {
        gsap.ticker.remove(tick);
        tickerActive = false;
      }
    };
  }

  function initPortalHero() {
    mm?.revert();
    mm = null;
    cleanupPointer?.();
    cleanupPointer = null;
    cleanupUniverse?.();
    cleanupUniverse = null;

    const root = document.querySelector<HTMLElement>("[data-portal-hero]");
    if (!root) return;

    cleanupUniverse = initUniverse(root);

    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const crumb = root.querySelector<HTMLElement>("[data-hub-crumb]");
        const words = root.querySelectorAll<HTMLElement>("[data-hub-word]");
        const lead = root.querySelector<HTMLElement>("[data-hub-lead]");
        const ctas = root.querySelector<HTMLElement>("[data-hub-ctas]");

        const aura = root.querySelector<HTMLElement>("[data-portal-aura]");
        const logo3d = root.querySelector<HTMLElement>("[data-portal-logo-3d]");
        const logoWrap = root.querySelector<HTMLElement>("[data-portal-logo-wrap]");
        const steps = root.querySelectorAll<HTMLElement>("[data-portal-step]");

        /* 1. Entrada editorial + ascenso de la X y peldaños */
        const intro = gsap.timeline({ defaults: { ease: "expo.out" } });
        if (crumb) intro.from(crumb, { y: 8, autoAlpha: 0, duration: 0.6, clearProps: "transform,opacity,visibility" }, 0);
        if (words.length) {
          intro.fromTo(
            words,
            { yPercent: 112, rotate: 5 },
            { yPercent: 0, rotate: 0, duration: 0.95, stagger: 0.045, clearProps: "transform" },
            0.05,
          );
        }
        if (lead) intro.from(lead, { y: 14, autoAlpha: 0, duration: 0.75, clearProps: "transform,opacity,visibility" }, 0.25);
        if (ctas) intro.from(ctas, { y: 12, autoAlpha: 0, duration: 0.7, clearProps: "transform,opacity,visibility" }, 0.32);

        if (steps.length) {
          intro.fromTo(
            steps,
            { y: 18, autoAlpha: 0 },
            { y: 0, autoAlpha: (_i, el) => Number((el as HTMLElement).style.opacity || 0.5), duration: 0.85, stagger: { each: 0.05, from: "end" } },
            0.12,
          );
        }
        if (aura) intro.fromTo(aura, { scale: 0.75, autoAlpha: 0 }, { scale: 1, autoAlpha: 1, duration: 1.0 }, 0.14);
        if (logo3d) {
          intro.fromTo(
            logo3d,
            { y: 24, z: -70, scale: 0.88, rotateY: -12, autoAlpha: 0 },
            { y: 0, z: 10, scale: 1, rotateY: -6, autoAlpha: 1, duration: 1.15 },
            0.18,
          );
        }

        /* 2. Bucle continuo sutil en la X 3D y luz trasera */
        if (logo3d) {
          gsap.to(logo3d, {
            y: -8,
            rotateY: 8,
            rotateX: 4,
            duration: 3.8,
            ease: "sine.inOut",
            repeat: -1,
            yoyo: true,
            delay: 1.2,
          });
        }

        if (aura) {
          gsap.to(aura, {
            scale: 1.1,
            opacity: 0.85,
            duration: 3.4,
            ease: "sine.inOut",
            repeat: -1,
            yoyo: true,
          });
        }

        /* 3. Seguimiento sutil y suave de la X al ratón en todo el hero */
        if (logoWrap) {
          const moveX = gsap.quickTo(logoWrap, "x", { duration: 0.85, ease: "power3.out" });
          const moveY = gsap.quickTo(logoWrap, "y", { duration: 0.85, ease: "power3.out" });
          const tiltY = gsap.quickTo(logoWrap, "rotateY", { duration: 0.85, ease: "power3.out" });
          const tiltX = gsap.quickTo(logoWrap, "rotateX", { duration: 0.85, ease: "power3.out" });
          const ac = new AbortController();

          root.addEventListener(
            "pointermove",
            (e) => {
              if (e.pointerType !== "mouse") return;
              const r = root.getBoundingClientRect();
              const nx = (e.clientX - r.left) / r.width - 0.5;
              const ny = (e.clientY - r.top) / r.height - 0.5;
              moveX(nx * 14);
              moveY(ny * 10);
              tiltY(nx * 7);
              tiltX(-ny * 5);
            },
            { passive: true, signal: ac.signal },
          );
          root.addEventListener(
            "pointerleave",
            () => {
              moveX(0);
              moveY(0);
              tiltY(0);
              tiltX(0);
            },
            { passive: true, signal: ac.signal },
          );
          cleanupPointer = () => ac.abort();
        }
      }, root);

      return () => {
        ctx.revert();
        cleanupPointer?.();
        cleanupPointer = null;
      };
    });
  }

  document.addEventListener("astro:page-load", initPortalHero);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanupPointer?.();
    cleanupPointer = null;
    cleanupUniverse?.();
    cleanupUniverse = null;
  });
</script>
