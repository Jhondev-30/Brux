---
import { LayoutTemplate, Palette, Clapperboard, FileText, Rocket } from "@lucide/astro";
import Button from "../ui/Button.astro";
import CtaButton from "../ui/CtaButton.astro";
import { bookingUrl } from "../../data/site";

const words = (text: string) => text.trim().split(/\s+/);
const maskClass =
  "inline-block overflow-clip align-top pt-[0.06em] pb-[0.14em] px-[0.04em] -mt-[0.06em] -mb-[0.14em] -mx-[0.04em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";
---

<section
  class="web-hero relative isolate overflow-hidden bg-ink pt-[max(8.5rem,calc(4.5rem+6svh))] pb-20 text-paper sm:pb-24 lg:pb-28"
  aria-labelledby="web-hero-title"
  data-web-hero
>
  <!-- Full-hero ambient crimson glow & GSAP precision blueprint particle canvas -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-20"
    style="background:
      radial-gradient(ellipse 58% 64% at 74% 50%, rgba(229, 12, 19, 0.16) 0%, rgba(229, 12, 19, 0.05) 42%, transparent 74%),
      radial-gradient(ellipse 40% 45% at 22% 72%, rgba(229, 12, 19, 0.06) 0%, transparent 70%);"
  ></div>

  <canvas
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 h-full w-full"
    data-wh-canvas
  ></canvas>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <nav aria-label="Breadcrumb" class="text-sm text-muted-on-ink" data-wh-crumb>
      <ol class="flex flex-wrap items-center gap-2">
        <li>
          <a
            href="/"
            class="transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
          >
            Home
          </a>
        </li>
        <li aria-hidden="true" class="text-paper/35">/</li>
        <li>
          <a
            href="/services/"
            class="transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
          >
            Services
          </a>
        </li>
        <li aria-hidden="true" class="text-paper/35">/</li>
        <li aria-current="page" class="font-semibold text-paper">Speaker Websites</li>
      </ol>
    </nav>

    <div class="mt-6 grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Copy column -->
      <div class="relative z-10 lg:col-span-6">
        <h1
          id="web-hero-title"
          class="text-[clamp(2.25rem,1.5rem+3.1vw,4rem)] leading-[1.03] font-extrabold tracking-[-0.025em] text-balance text-paper"
          data-wh-title
        >
          {words("One link that answers an organizer's questions and books the stage").map((w, j, a) => (
            <>
              <span class={maskClass}><span class={wordClass} data-wh-word>{w}</span></span>
              {j < a.length - 1 && " "}
            </>
          ))}
        </h1>

        <p
          class="mt-6 max-w-[38rem] text-[clamp(1.0625rem,1rem+0.3vw,1.25rem)] leading-relaxed text-pretty text-muted-on-ink"
          data-wh-lead
        >
          Brux scopes and builds custom speaker websites starting from <strong class="font-semibold text-paper">$1,100 one-time</strong> — always including full brand direction (palette, typography, logo, and visual assets) alongside your bio, keynote topics, demo reel, and inquiry form.
        </p>

        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6" data-wh-ctas>
          <CtaButton href={bookingUrl}>Request a website plan</CtaButton>
          <Button href="#client-site" variant="link" class="justify-center sm:justify-start">
            See live client example
          </Button>
        </div>
      </div>

      <!-- 3D Speaker Site & Brand Architecture Layers (seamless bg-ink spatial scene) -->
      <div class="relative lg:col-span-6" aria-hidden="true" data-wh-visual>
        <div
          class="wh-perspective relative mx-auto flex aspect-[4/3] w-full max-w-[36rem] items-center justify-center sm:aspect-[11/9]"
          data-wh-stage
        >
          <!-- Soft crimson stage glow behind the blueprint planes -->
          <div
            class="pointer-events-none absolute left-1/2 top-1/2 h-56 w-56 -translate-x-1/2 -translate-y-1/2 rounded-full blur-3xl sm:h-64 sm:w-64"
            style="background: radial-gradient(circle, rgba(229, 12, 19, 0.32) 0%, rgba(229, 12, 19, 0.08) 54%, transparent 78%);"
            data-wh-aura
          ></div>

          <div class="wh-3d-rig relative h-full w-full" data-wh-rig>
            <!-- Stacked tilted 3D design-system blueprint layers -->
            <div class="wh-stack pointer-events-none absolute inset-0 flex items-center justify-center">
              <!-- Layer 1 (Back wireframe structure) -->
              <div
                class="wh-layer-back flex h-[62%] w-[72%] flex-col justify-between rounded-[20px] border border-paper/12 bg-paper/[0.015] p-4"
                data-wh-layer="back"
              >
                <div class="flex items-center justify-between border-b border-paper/10 pb-2.5">
                  <div class="flex items-center gap-1.5">
                    <span class="h-1.5 w-1.5 rounded-full bg-stage-glow/80"></span>
                    <span class="h-1.5 w-1.5 rounded-full bg-paper/25"></span>
                    <span class="h-1.5 w-1.5 rounded-full bg-paper/25"></span>
                  </div>
                  <span class="h-1.5 w-14 rounded-full bg-paper/12"></span>
                </div>
                <div class="grid flex-1 grid-cols-12 gap-2.5 pt-3">
                  <div class="col-span-7 flex flex-col justify-between rounded-lg border border-paper/8 p-2.5">
                    <div class="space-y-1.5">
                      <span class="block h-2 w-3/4 rounded-full bg-paper/16"></span>
                      <span class="block h-2 w-1/2 rounded-full bg-paper/10"></span>
                    </div>
                    <span class="block h-4 w-16 rounded bg-stage/30"></span>
                  </div>
                  <div class="col-span-5 rounded-lg border border-stage-glow/20 bg-stage/[0.04]"></div>
                </div>
              </div>

              <!-- Layer 2 (Mid Brand Identity token layer: palette + typography) -->
              <div
                class="wh-layer-mid absolute flex h-[48%] w-[56%] items-end justify-between rounded-[18px] border border-stage-glow/30 bg-stage/[0.025] p-3.5"
                data-wh-layer="mid"
              >
                <div class="flex items-center gap-1.5">
                  <span class="h-3.5 w-3.5 rounded-full border border-paper/30 bg-ink"></span>
                  <span class="h-3.5 w-3.5 rounded-full bg-stage"></span>
                  <span class="h-3.5 w-3.5 rounded-full bg-paper/90"></span>
                </div>
                <span class="text-xs font-extrabold tracking-tight text-paper/70">Aa · Brand</span>
              </div>
            </div>

            <!-- SVG curved architectural signal routes -->
            <svg
              class="pointer-events-none absolute inset-0 h-full w-full overflow-visible"
              viewBox="0 0 560 440"
              fill="none"
            >
              <defs>
                <linearGradient id="wh-line-red" x1="280" y1="220" x2="454" y2="328" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FF4D47" stop-opacity="0.9" />
                  <stop offset="100%" stop-color="#E50C13" stop-opacity="0.18" />
                </linearGradient>
                <linearGradient id="wh-line-soft" x1="280" y1="220" x2="108" y2="112" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.42" />
                  <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0.06" />
                </linearGradient>
              </defs>

              <path
                d="M280 220 Q 192 148 108 112"
                stroke="url(#wh-line-soft)"
                stroke-width="1.25"
                stroke-dasharray="4 6"
                data-wh-beam
              />
              <path
                d="M280 220 Q 368 142 452 108"
                stroke="url(#wh-line-red)"
                stroke-width="1.5"
                data-wh-beam
              />
              <path
                d="M280 220 Q 186 288 104 326"
                stroke="url(#wh-line-soft)"
                stroke-width="1.25"
                stroke-dasharray="4 6"
                data-wh-beam
              />
              <path
                d="M280 220 Q 374 294 456 328"
                stroke="url(#wh-line-red)"
                stroke-width="1.75"
                data-wh-beam
              />

              <circle r="3" fill="#FFFFFF" fill-opacity="0.82" data-wh-packet="0" />
              <circle r="3.4" fill="#FF4D47" data-wh-packet="1" />
              <circle r="3" fill="#FFFFFF" fill-opacity="0.78" data-wh-packet="2" />
              <circle r="4" fill="#FF4D47" data-wh-packet="3" />
            </svg>

            <!-- Central open luminous focal beacon (no solid dark disc) -->
            <div
              class="wh-core absolute left-1/2 top-1/2 flex -translate-x-1/2 -translate-y-1/2 flex-col items-center gap-2.5"
              data-wh-core
            >
              <div class="relative flex h-14 w-14 items-center justify-center rounded-2xl bg-stage/25 text-paper ring-1 ring-stage-glow/65 shadow-[0_0_40px_rgba(229,12,19,0.7)] backdrop-blur-xs sm:h-16 sm:w-16">
                <div class="pointer-events-none absolute inset-[-10px] rounded-[22px] border border-stage-glow/45" data-wh-pulse></div>
                <LayoutTemplate class="h-6 w-6 text-paper" stroke-width={2} />
              </div>
              <span class="rounded-full bg-ink/65 px-2.5 py-0.5 text-[10px] font-bold tracking-[0.14em] text-paper/90 uppercase backdrop-blur-xs">
                Speaker Hub
              </span>
            </div>

            <!-- Node 1: Brand Direction -->
            <div
              class="wh-node wh-node-tl absolute left-[2%] top-[13%] flex items-center gap-2.5 rounded-full border border-paper/14 bg-ink/84 px-3.5 py-2 backdrop-blur-md sm:left-[4%] sm:top-[15%]"
              data-wh-node="0"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-paper/10 text-paper/85">
                <Palette class="h-3.5 w-3.5" />
              </span>
              <div class="leading-tight">
                <p class="text-[11px] font-semibold text-paper">Brand Direction</p>
                <p class="text-[10px] text-muted-on-ink">Palette, type &amp; logo</p>
              </div>
            </div>

            <!-- Node 2: Demo Reel & Press Kit -->
            <div
              class="wh-node wh-node-tr absolute right-[2%] top-[11%] flex items-center gap-2.5 rounded-full border border-stage-glow/32 bg-ink/84 px-3.5 py-2 shadow-[0_12px_28px_-14px_rgba(229,12,19,0.45)] backdrop-blur-md sm:right-[4%] sm:top-[13%]"
              data-wh-node="1"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stage/22 text-stage-glow">
                <Clapperboard class="h-3.5 w-3.5" />
              </span>
              <div class="leading-tight">
                <p class="text-[11px] font-semibold text-paper">Stage Reel &amp; One-Sheet</p>
                <p class="text-[10px] text-stage-glow">Organizer-ready proof</p>
              </div>
            </div>

            <!-- Node 3: Keynotes & Bio -->
            <div
              class="wh-node wh-node-bl absolute bottom-[14%] left-[2%] flex items-center gap-2.5 rounded-full border border-paper/14 bg-ink/84 px-3.5 py-2 backdrop-blur-md sm:bottom-[15%] sm:left-[3%]"
              data-wh-node="2"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-paper/10 text-paper/85">
                <FileText class="h-3.5 w-3.5" />
              </span>
              <div class="leading-tight">
                <p class="text-[11px] font-semibold text-paper">Talks &amp; Bio Architecture</p>
                <p class="text-[10px] text-muted-on-ink">Scoped by complexity</p>
              </div>
            </div>

            <!-- Node 4: Launch & Booking Link -->
            <div
              class="wh-node wh-node-br absolute bottom-[11%] right-[1%] flex items-center gap-2.5 rounded-full border border-stage-glow/55 bg-stage/18 px-4 py-2.5 shadow-[0_16px_38px_-12px_rgba(229,12,19,0.65)] backdrop-blur-md sm:bottom-[13%] sm:right-[3%]"
              data-wh-node="3"
            >
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-stage text-paper">
                <Rocket class="h-3.5 w-3.5" stroke-width={2.25} />
              </span>
              <div class="leading-tight">
                <p class="text-xs font-bold text-paper">Live Booking Link</p>
                <p class="text-[10px] font-semibold text-stage-glow">Built to close the stage</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .wh-perspective {
    perspective: 1100px;
  }

  .wh-3d-rig {
    transform-style: preserve-3d;
  }

  .wh-stack {
    transform-style: preserve-3d;
    transform: rotateX(18deg) rotateY(-14deg) rotateZ(2deg);
  }

  .wh-layer-back {
    transform: translateZ(-28px);
  }

  .wh-layer-mid {
    transform: translateZ(12px);
    box-shadow: inset 0 0 36px rgba(229, 12, 19, 0.12);
  }

  .wh-core {
    transform: translateZ(36px);
  }

  .wh-node-tl {
    transform: translateZ(20px);
  }

  .wh-node-tr {
    transform: translateZ(44px);
  }

  .wh-node-bl {
    transform: translateZ(16px);
  }

  .wh-node-br {
    transform: translateZ(56px);
  }
</style>

<script>
  import { gsap } from "gsap";

  interface GridMarker {
    x: number;
    y: number;
    vx: number;
    vy: number;
    size: number;
    alpha: number;
    crimson: boolean;
    cross: boolean;
    phase: number;
  }

  let cleanupWebHero: (() => void) | null = null;

  function initWebHero() {
    cleanupWebHero?.();
    cleanupWebHero = null;

    const root = document.querySelector<HTMLElement>("[data-web-hero]");
    if (!root) return;

    const canvas = root.querySelector<HTMLCanvasElement>("[data-wh-canvas]");
    const rig = root.querySelector<HTMLElement>("[data-wh-rig]");
    const stage = root.querySelector<HTMLElement>("[data-wh-stage]");
    const aura = root.querySelector<HTMLElement>("[data-wh-aura]");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;

    let rafTick: (() => void) | null = null;
    let ro: ResizeObserver | null = null;
    let io: IntersectionObserver | null = null;
    let mm: gsap.MatchMedia | null = null;
    let removePointer: (() => void) | null = null;

    // 1. GSAP-driven architectural grid & registration mark particle field
    if (canvas) {
      const ctx = canvas.getContext("2d");
      if (ctx) {
        let w = 0;
        let h = 0;
        let dpr = 1;
        let inView = true;
        const pointer = { x: -9999, y: -9999 };
        const markers: GridMarker[] = [];

        const buildMarkers = () => {
          markers.length = 0;
          const count = Math.min(68, Math.max(30, Math.round((w * h) / 16500)));
          for (let i = 0; i < count; i++) {
            markers.push({
              x: Math.random(),
              y: Math.random(),
              vx: (Math.random() - 0.5) * 0.00032,
              vy: (Math.random() - 0.5) * 0.00032,
              size: 1.2 + Math.random() * 1.8,
              alpha: 0.16 + Math.random() * 0.45,
              crimson: i % 3 !== 0,
              cross: i % 7 === 0,
              phase: Math.random() * Math.PI * 2,
            });
          }
        };

        const resize = () => {
          const rect = root.getBoundingClientRect();
          w = rect.width;
          h = rect.height;
          dpr = Math.min(window.devicePixelRatio || 1, 2);
          canvas.width = Math.max(1, Math.floor(w * dpr));
          canvas.height = Math.max(1, Math.floor(h * dpr));
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          buildMarkers();
        };

        resize();
        ro = new ResizeObserver(resize);
        ro.observe(root);

        const draw = (tSec: number) => {
          ctx.clearRect(0, 0, w, h);

          for (const m of markers) {
            if (!reduce) {
              m.x += m.vx;
              m.y += m.vy;
              if (m.x < 0) m.x = 1;
              if (m.x > 1) m.x = 0;
              if (m.y < 0) m.y = 1;
              if (m.y > 1) m.y = 0;
            }

            let px = m.x * w;
            let py = m.y * h;

            const dx = px - pointer.x;
            const dy = py - pointer.y;
            const dist = Math.hypot(dx, dy);
            if (dist < 130 && dist > 0.1) {
              const push = ((130 - dist) / 130) * 14;
              px += (dx / dist) * push;
              py += (dy / dist) * push;
            }

            const twinkle = reduce ? 1 : 0.72 + 0.28 * Math.sin(tSec * 1.5 + m.phase);
            const alpha = m.alpha * twinkle;

            if (m.cross) {
              const arm = m.size * 2.2;
              ctx.beginPath();
              ctx.moveTo(px - arm, py);
              ctx.lineTo(px + arm, py);
              ctx.moveTo(px, py - arm);
              ctx.lineTo(px, py + arm);
              ctx.strokeStyle = m.crimson
                ? `rgba(255, 77, 71, ${(alpha * 0.9).toFixed(3)})`
                : `rgba(255, 255, 255, ${(alpha * 0.45).toFixed(3)})`;
              ctx.lineWidth = 1;
              ctx.stroke();
            } else {
              ctx.beginPath();
              ctx.arc(px, py, m.size, 0, Math.PI * 2);
              ctx.fillStyle = m.crimson
                ? `rgba(255, 77, 71, ${alpha.toFixed(3)})`
                : `rgba(255, 255, 255, ${(alpha * 0.5).toFixed(3)})`;
              ctx.fill();
            }
          }
        };

        draw(0);

        if (!reduce) {
          const tick = () => {
            if (!inView) return;
            draw(performance.now() * 0.001);
          };
          rafTick = tick;
          gsap.ticker.add(tick);

          io = new IntersectionObserver(
            ([entry]) => {
              inView = Boolean(entry?.isIntersecting);
            },
            { threshold: 0.05 },
          );
          io.observe(root);

          const onMove = (e: PointerEvent) => {
            const rect = root.getBoundingClientRect();
            pointer.x = e.clientX - rect.left;
            pointer.y = e.clientY - rect.top;
          };
          const onLeave = () => {
            pointer.x = -9999;
            pointer.y = -9999;
          };
          root.addEventListener("pointermove", onMove, { passive: true });
          root.addEventListener("pointerleave", onLeave, { passive: true });
          removePointer = () => {
            root.removeEventListener("pointermove", onMove);
            root.removeEventListener("pointerleave", onLeave);
          };
        }
      }
    }

    // 2. Bang Motion entrance, continuous subtle 3D motion, packets & gentle pointer parallax
    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const crumb = root.querySelector("[data-wh-crumb]");
        const wordEls = root.querySelectorAll("[data-wh-word]");
        const lead = root.querySelector("[data-wh-lead]");
        const ctas = root.querySelector("[data-wh-ctas]");
        const layers = root.querySelectorAll("[data-wh-layer]");
        const core = root.querySelector("[data-wh-core]");
        const nodes = root.querySelectorAll("[data-wh-node]");
        const beams = root.querySelectorAll("[data-wh-beam]");
        const pulse = root.querySelector("[data-wh-pulse]");

        const tl = gsap.timeline({ defaults: { ease: "expo.out" } });
        tl.from(crumb, { y: 12, opacity: 0, duration: 0.5, clearProps: "transform,opacity" })
          .fromTo(
            wordEls,
            { yPercent: 112, rotate: 5 },
            { yPercent: 0, rotate: 0, duration: 0.95, stagger: 0.045, clearProps: "transform" },
            0.05,
          )
          .from(lead, { y: 18, opacity: 0, duration: 0.7, clearProps: "transform,opacity" }, 0.25)
          .from(ctas, { y: 16, opacity: 0, duration: 0.65, clearProps: "transform,opacity" }, 0.34)
          .from(
            layers,
            { scale: 0.86, opacity: 0, duration: 0.95, stagger: 0.1, ease: "power3.out" },
            0.14,
          )
          .from(core, { scale: 0.82, opacity: 0, duration: 0.85 }, 0.2)
          .from(beams, { opacity: 0, duration: 0.8, stagger: 0.07 }, 0.28)
          .from(nodes, { y: 16, scale: 0.92, opacity: 0, duration: 0.75, stagger: 0.08 }, 0.32);

        if (pulse) {
          gsap.fromTo(
            pulse,
            { scale: 0.94, opacity: 0.62 },
            {
              scale: 1.52,
              opacity: 0,
              duration: 2.6,
              repeat: -1,
              ease: "power2.out",
            },
          );
        }

        if (aura) {
          gsap.to(aura, {
            scale: 1.12,
            opacity: 0.9,
            duration: 3.4,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
          });
        }

        nodes.forEach((node, idx) => {
          gsap.to(node, {
            y: idx % 2 === 0 ? -6 : 6,
            duration: 2.9 + idx * 0.45,
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
          });
        });

        const quadCurves: Array<[number, number, number, number, number, number]> = [
          [280, 220, 192, 148, 108, 112],
          [280, 220, 368, 142, 452, 108],
          [280, 220, 186, 288, 104, 326],
          [280, 220, 374, 294, 456, 328],
        ];
        quadCurves.forEach((pts, idx) => {
          const el = root.querySelector<SVGCircleElement>(`[data-wh-packet="${idx}"]`);
          if (!el) return;
          const [x0, y0, cx, cy, x1, y1] = pts;
          const proxy = { t: 0 };
          gsap.set(el, { attr: { cx: x0, cy: y0 }, opacity: 0 });
          gsap
            .timeline({ repeat: -1, delay: idx * 0.55, repeatDelay: 0.45 })
            .to(el, { opacity: 1, duration: 0.15, ease: "none" })
            .to(
              proxy,
              {
                t: 1,
                duration: 1.75,
                ease: "power2.inOut",
                onUpdate: () => {
                  const t = proxy.t;
                  const inv = 1 - t;
                  const px = inv * inv * x0 + 2 * inv * t * cx + t * t * x1;
                  const py = inv * inv * y0 + 2 * inv * t * cy + t * t * y1;
                  el.setAttribute("cx", px.toFixed(1));
                  el.setAttribute("cy", py.toFixed(1));
                },
              },
              0,
            )
            .to(el, { opacity: 0, duration: 0.22, ease: "none" }, "-=0.22");
        });

        if (rig && stage) {
          const rxTo = gsap.quickTo(rig, "rotationX", { duration: 0.9, ease: "power3.out" });
          const ryTo = gsap.quickTo(rig, "rotationY", { duration: 0.9, ease: "power3.out" });
          const xTo = gsap.quickTo(rig, "x", { duration: 0.9, ease: "power3.out" });
          const yTo = gsap.quickTo(rig, "y", { duration: 0.9, ease: "power3.out" });

          const onHeroPointer = (e: PointerEvent) => {
            if (e.pointerType !== "mouse") return;
            const rect = root.getBoundingClientRect();
            const nx = (e.clientX - rect.left) / Math.max(1, rect.width) - 0.5;
            const ny = (e.clientY - rect.top) / Math.max(1, rect.height) - 0.5;
            ryTo(nx * 10);
            rxTo(-ny * 8);
            xTo(nx * 10);
            yTo(ny * 8);
          };
          const onHeroLeave = () => {
            rxTo(0);
            ryTo(0);
            xTo(0);
            yTo(0);
          };

          root.addEventListener("pointermove", onHeroPointer, { passive: true });
          root.addEventListener("pointerleave", onHeroLeave, { passive: true });
          return () => {
            root.removeEventListener("pointermove", onHeroPointer);
            root.removeEventListener("pointerleave", onHeroLeave);
          };
        }
      }, root);

      return () => ctx.revert();
    });

    cleanupWebHero = () => {
      if (rafTick) gsap.ticker.remove(rafTick);
      ro?.disconnect();
      io?.disconnect();
      removePointer?.();
      mm?.revert();
    };
  }

  initWebHero();
  document.addEventListener("astro:page-load", initWebHero);
  document.addEventListener("astro:before-swap", () => {
    cleanupWebHero?.();
    cleanupWebHero = null;
  });
</script>
