---
import Logo from "../assets/images/brux-logo-sobre-negro.svg";
import { services, navLinks, bookingUrl } from "../data/site";

const year = new Date().getFullYear();
const hasAnalytics = Boolean((import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? "").trim());
---

<footer id="footer" class="bg-ink pt-20 pb-10 text-paper">
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <div class="grid gap-12 border-b border-paper/10 pb-14 md:grid-cols-[minmax(0,2fr)_minmax(0,1fr)_minmax(0,1fr)]">
      <div>
        <a href="/" class="-m-2 inline-block rounded-[3px] p-2" aria-label="Brux, home">
          <Logo class="h-7 w-auto" aria-hidden="true" />
        </a>
        <p class="mt-5 max-w-[22rem] leading-relaxed text-muted-on-ink">
          Speaker booking and LinkedIn for keynote speakers. No commission on your fees.
        </p>
      </div>

      <nav aria-label="Services">
        <p class="text-sm font-semibold text-muted-on-ink">Services</p>
        <ul class="mt-4 space-y-1">
          {services.map((s) => (
            <li><a href={s.href} class="inline-block py-1.5 text-paper/90 transition-colors hover:text-paper">{s.name}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Brux">
        <p class="text-sm font-semibold text-muted-on-ink">Brux</p>
        <ul class="mt-4 space-y-1">
          {navLinks.map((l) => (
            <li><a href={l.href} class="inline-block py-1.5 text-paper/90 transition-colors hover:text-paper">{l.label}</a></li>
          ))}
          <li><a href="/about" class="inline-block py-1.5 text-paper/90 transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage">About</a></li>
          <li><a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="inline-block py-1.5 text-paper/90 transition-colors hover:text-paper">Contact</a></li>
        </ul>
      </nav>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 pt-8 text-sm text-muted-on-ink">
      <p>© {year} Brux</p>
      {hasAnalytics && (
        <button
          type="button"
          data-cookie-open
          class="inline-flex min-h-11 cursor-pointer items-center rounded-[3px] text-sm text-muted-on-ink transition-colors hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage"
        >
          Cookie settings
        </button>
      )}
    </div>
  </div>
</footer>
