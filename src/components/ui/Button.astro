---
/**
 * Botones de Brux.
 * primary: rojo escenario, la acción principal («Book a call»).
 * secondary: contorno blanco, sobre fondo negro.
 * secondary-light: contorno negro, sobre fondo claro.
 * link: enlace de texto con subrayado que se dibuja al pasar el ratón. Para la acción secundaria del hero,
 *       así no compite con el botón rojo.
 *
 * arrow: añade una flecha que avanza al pasar el ratón (por defecto solo en link; en primary se activa con arrow).
 */
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "secondary-light" | "link";
  arrow?: boolean;
  class?: string;
}
const { href, variant = "primary", arrow, class: className } = Astro.props;
const showArrow = arrow ?? variant === "link";

const box =
  "group/btn inline-flex min-h-12 items-center justify-center gap-2.5 rounded-[3px] px-6 text-base font-semibold transition-[background-color,box-shadow,transform] duration-150 ease-out hover:-translate-y-px active:translate-y-px active:scale-[0.98]";
const variants = {
  primary: `${box} bg-stage text-paper hover:bg-stage-text`,
  secondary: `${box} text-paper ring-1 ring-paper/40 ring-inset hover:bg-paper/10 hover:ring-paper/70`,
  "secondary-light": `${box} text-ink ring-1 ring-ink/30 ring-inset hover:bg-ink/5 hover:ring-ink/60`,
  link: "group/btn inline-flex min-h-12 items-center gap-2 text-base font-semibold text-paper",
};
const external = /^https?:\/\//.test(href);
---

<a href={href} target={external ? "_blank" : undefined} rel={external ? "noopener" : undefined} class:list={[variants[variant], className]}>
  {
    variant === "link" ? (
      <span class="bg-[linear-gradient(currentColor,currentColor)] bg-[length:0%_1px] bg-left-bottom bg-no-repeat pb-0.5 transition-[background-size] duration-300 ease-out group-hover/btn:bg-[length:100%_1px] group-focus-visible/btn:bg-[length:100%_1px]">
        <slot />
      </span>
    ) : (
      <slot />
    )
  }
  {
    showArrow && (
      <svg
        viewBox="0 0 16 16"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="shrink-0 transition-transform duration-200 ease-out group-hover/btn:translate-x-1"
      >
        <path d="M2.5 8h10M8.5 4l4 4-4 4" />
      </svg>
    )
  }
</a>
