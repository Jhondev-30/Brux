---
import { Check as LucideCheck } from "@lucide/astro";
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";

export interface OfferItem {
  title: string;
  detail?: string;
}

interface Props {
  headingId: string;
  title: string;
  description: string;
  items: OfferItem[];
  price?: string;
  priceSuffix?: string;
  primaryHref: string;
  primaryLabel: string;
  secondaryHref: string;
  secondaryLabel: string;
}

const {
  headingId,
  title,
  description,
  items,
  price = "From $1,100",
  priceSuffix = "flat fee",
  primaryHref,
  primaryLabel,
  secondaryHref,
  secondaryLabel,
} = Astro.props;

const isExternalPrimary = /^https?:\/\//.test(primaryHref);
const isExternalSecondary = /^https?:\/\//.test(secondaryHref);
---

<div
  class="relative isolate overflow-hidden rounded-[26px] border border-[#2d2d33] bg-[linear-gradient(148deg,#18181b_0%,#0d0d10_54%,#080809_100%)] text-paper shadow-[0_32px_72px_-24px_rgba(0,0,0,0.48),inset_0_1px_0_rgba(255,255,255,0.08)]"
  data-website-offer-card
>
  <!-- Subtle ambient stage glow anchored to the pricing column -->
  <span
    aria-hidden="true"
    class="pointer-events-none absolute -top-24 -right-24 h-80 w-96 rounded-full bg-[radial-gradient(ellipse,rgba(229,12,19,0.22)_0%,rgba(229,12,19,0.06)_44%,transparent_70%)]"
  ></span>

  <div class="relative grid lg:grid-cols-12">
    <!-- Left column: offer positioning & included deliverables -->
    <div class="p-7 sm:p-10 lg:col-span-7 lg:p-12">
      <h2
        id={headingId}
        class="text-[clamp(1.75rem,1.35rem+1.5vw,2.5rem)] leading-[1.08] font-extrabold tracking-[-0.025em] text-balance text-paper"
      >
        {title}
      </h2>

      <p class="mt-4 max-w-[38rem] text-base leading-relaxed text-[#c4c4cc]">
        {description}
      </p>

      <ul class="mt-8 grid gap-x-6 gap-y-4 border-t border-paper/10 pt-7 sm:grid-cols-2">
        {items.map((item) => (
          <li class="flex items-start gap-3" data-wp-plan-item>
            <span
              class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-stage/20 text-[#ff5a6e]"
              aria-hidden="true"
            >
              <LucideCheck class="size-3" stroke-width={3} />
            </span>
            <div>
              <p class="text-[0.9375rem] font-bold leading-snug text-paper">{item.title}</p>
              {item.detail && (
                <p class="mt-1 text-xs leading-relaxed text-[#a1a1aa]">{item.detail}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>

    <!-- Right column: base price, scope facts & CTAs (separated by hairline, no nested card) -->
    <div
      class="flex flex-col justify-between border-t border-paper/10 bg-paper/[0.02] p-7 sm:p-10 lg:col-span-5 lg:border-t-0 lg:border-l lg:p-12"
      data-wp-plan-card
    >
      <div>
        <p class="text-xs font-bold tracking-[0.02em] text-[#a1a1aa]">Starting investment</p>
        <div class="mt-2.5 flex flex-wrap items-baseline gap-x-2.5 gap-y-1">
          <p class="text-[clamp(2.5rem,2.1rem+1.5vw,3.35rem)] font-extrabold leading-none tracking-[-0.04em] text-paper tabular-nums">
            {price}
          </p>
          <span class="text-base font-semibold text-[#a1a1aa]">{priceSuffix}</span>
        </div>
        <p class="mt-2.5 text-sm leading-relaxed text-[#c4c4cc]">
          Quoted after a short call based on page count and features.
        </p>

        <dl class="mt-7 divide-y divide-paper/10 border-y border-paper/10 text-sm">
          <div class="flex items-center justify-between gap-4 py-3">
            <dt class="text-[#a1a1aa]">Billing</dt>
            <dd class="font-bold text-paper">Single payment</dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-3">
            <dt class="text-[#a1a1aa]">Typical launch</dt>
            <dd class="font-bold text-paper">~14 days (focused site)</dd>
          </div>
          <div class="flex items-center justify-between gap-4 py-3">
            <dt class="text-[#a1a1aa]">Brand direction</dt>
            <dd class="font-bold text-paper">Always included</dd>
          </div>
        </dl>
      </div>

      <div class="mt-8 flex flex-col gap-3">
        <a
          href={primaryHref}
          target={isExternalPrimary ? "_blank" : undefined}
          rel={isExternalPrimary ? "noopener" : undefined}
          class="group/wcta flex min-h-12 w-full items-center justify-center gap-2 rounded-[10px] bg-stage px-5 text-[0.9375rem] font-bold text-paper shadow-[0_14px_30px_-10px_rgba(229,12,19,0.55)] transition-all duration-200 ease-out hover:-translate-y-0.5 hover:bg-stage-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
        >
          <span>{primaryLabel}</span>
          <span class="inline-flex shrink-0 transition-transform duration-200 group-hover/wcta:translate-x-0.5" aria-hidden="true">
            <MorphIcon icon={ArrowRight} size={16} strokeWidth={2.2} spring="snappy" reducedMotion="user" />
          </span>
        </a>

        <a
          href={secondaryHref}
          target={isExternalSecondary ? "_blank" : undefined}
          rel={isExternalSecondary ? "noopener" : undefined}
          class="group/wsec flex min-h-12 w-full items-center justify-center gap-2 rounded-[10px] border border-paper/18 bg-paper/[0.06] px-5 text-[0.9375rem] font-bold text-paper shadow-[inset_0_1px_0_rgba(255,255,255,0.1)] transition-all duration-200 ease-out hover:border-paper hover:bg-paper hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stage-glow"
        >
          <span>{secondaryLabel}</span>
          <span class="inline-flex shrink-0 transition-transform duration-200 group-hover/wsec:translate-x-0.5" aria-hidden="true">
            <MorphIcon icon={ArrowRight} size={16} strokeWidth={2.2} spring="snappy" reducedMotion="user" />
          </span>
        </a>
      </div>
    </div>
  </div>
</div>
