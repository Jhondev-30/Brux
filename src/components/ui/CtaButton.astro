---
/**
 * El botón de la acción principal de Brux («Book a strategy call»). Uno por pantalla como máximo.
 *
 * Más alto que un botón normal (56 px), con la flecha a la derecha del texto.
 * Estilos con Tailwind v4, icono con MorphIcon + Lucide, y respuesta táctil con GSAP.
 *
 * tone="stage": rojo, sobre fondo negro (por defecto).
 * tone="ink": negro, sobre fondo rojo (FinalCta).
 */
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";

interface Props {
  href: string;
  tone?: "stage" | "ink";
  class?: string;
}
const { href, tone = "stage", class: className } = Astro.props;
const external = /^https?:\/\//.test(href);

const base =
  "inline-flex min-h-14 items-center justify-center gap-3 rounded-[3px] pr-6 pl-7 text-[1.0625rem] leading-none font-semibold whitespace-nowrap text-paper no-underline transition-[background-color,box-shadow] duration-200 ease-out will-change-transform focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-paper";

const tones = {
  stage: "bg-stage hover:bg-[#f2141b] hover:shadow-[0_8px_24px_-10px_rgb(229_12_19/0.35)]",
  ink: "bg-ink hover:bg-ink-raised hover:shadow-[0_8px_24px_-10px_rgb(10_10_10/0.3)]",
};
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener" : undefined}
  class:list={[base, tones[tone], className]}
  data-cta-button
>
  <span><slot /></span>
  <span class="inline-flex shrink-0 will-change-transform" data-cta-button-arrow-wrap>
    <MorphIcon
      icon={ArrowRight}
      size={18}
      strokeWidth={2}
      spring="snappy"
      reducedMotion="user"
      data-cta-button-arrow
    />
  </span>
</a>

<script>
  import { gsap } from "gsap";
  import { ArrowRight, ArrowUpRight, type IconNode } from "lucide";

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  let cleanup: (() => void) | null = null;

  function initCtaButtons() {
    cleanup?.();
    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    document.querySelectorAll<HTMLElement>("[data-cta-button]").forEach((btn) => {
      const arrowWrap = btn.querySelector<HTMLElement>("[data-cta-button-arrow-wrap]");
      const arrowIcon = btn.querySelector<MorphEl>("[data-cta-button-arrow]");
      const isExternal = btn.getAttribute("target") === "_blank";

      const liftY = gsap.quickTo(btn, "y", { duration: 0.24, ease: "power3.out" });
      const nudgeX = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.24, ease: "power3.out" }) : null;

      const onEnter = () => {
        if (isExternal) arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) {
          liftY(-1.5);
          nudgeX?.(3.5);
        }
      };

      const onLeave = () => {
        if (isExternal) arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) {
          liftY(0);
          nudgeX?.(0);
          gsap.to(btn, { scale: 1, duration: 0.35, ease: "back.out(2.5)" });
        }
      };

      btn.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      btn.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      btn.addEventListener("focus", onEnter, { signal });
      btn.addEventListener("blur", onLeave, { signal });
      btn.addEventListener(
        "pointerdown",
        () => {
          if (!reduce.matches) gsap.to(btn, { scale: 0.985, duration: 0.08, ease: "power2.out" });
        },
        { signal },
      );
      btn.addEventListener(
        "pointerup",
        () => {
          if (!reduce.matches) gsap.to(btn, { scale: 1, duration: 0.35, ease: "back.out(2.5)" });
        },
        { signal },
      );
    });

    cleanup = () => controller.abort();
  }

  document.addEventListener("astro:page-load", initCtaButtons);
  document.addEventListener("astro:before-swap", () => {
    cleanup?.();
    cleanup = null;
  });
</script>
