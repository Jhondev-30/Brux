---
/**
 * El botón de la acción principal de Brux («Book a strategy call»). Uno por pantalla como máximo.
 *
 * Más alto que un botón normal (56 px), con la flecha a la derecha del texto.
 * Al pasar el ratón: sube 1 px, se enciende un halo rojo suave debajo (luz de escenario) y la flecha avanza.
 * Al hacer clic se hunde. Con movimiento reducido solo cambia el color.
 *
 * tone="stage": rojo, sobre fondo negro (por defecto).
 * tone="ink": negro, sobre fondo rojo (FinalCta).
 */
interface Props {
  href: string;
  tone?: "stage" | "ink";
  class?: string;
}
const { href, tone = "stage", class: className } = Astro.props;
---

<a href={href} class:list={["cta", `cta--${tone}`, className]}>
  <span><slot /></span>
  <svg class="cta__icon" viewBox="0 0 16 16" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M2.5 8h10M8.5 4l4 4-4 4" />
  </svg>
</a>

<style>
  .cta {
    --cta-bg: var(--color-stage);
    --cta-bg-hover: #f2141b;
    --cta-fg: var(--color-paper);
    --cta-glow: rgb(229 12 19 / 0.35);

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding-inline: 1.75rem 1.5rem;
    border-radius: 3px;
    background: var(--cta-bg);
    color: var(--cta-fg);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 0 0 0 transparent;
    transition:
      transform 200ms ease-out,
      box-shadow 260ms ease-out,
      background-color 200ms ease-out;
  }
  .cta--ink {
    --cta-bg: var(--color-ink);
    --cta-bg-hover: var(--color-ink-raised);
    --cta-glow: rgb(10 10 10 / 0.3);
  }

  .cta__icon {
    flex-shrink: 0;
    transition: transform 200ms ease-out;
  }

  @media (hover: hover) {
    .cta:hover {
      background: var(--cta-bg-hover);
      transform: translateY(-1px);
      box-shadow: 0 8px 24px -10px var(--cta-glow);
    }
    .cta:hover .cta__icon {
      transform: translateX(3px);
    }
  }
  .cta:active {
    transform: translateY(0) scale(0.985);
    transition-duration: 80ms;
  }
  .cta:focus-visible {
    outline: 2px solid var(--color-paper);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .cta__icon {
      transition: background-color 150ms ease;
    }
    .cta:hover,
    .cta:active,
    .cta:hover .cta__icon {
      transform: none;
    }
  }
</style>
