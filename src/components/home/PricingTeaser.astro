---
import { Image } from "astro:assets";
import { Check as LucideCheck } from "@lucide/astro";
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";
import report from "../../assets/plans/monthly-report.webp";
import { pricingTiers } from "../../data/pricing";
import Button from "../ui/Button.astro";

/*
  Planes en la portada: sin precios a propósito (los precios y el control interactivo están en /pricing).
  Diseño replicado de BRUX_founder_interactive: Founder más ancha y en rojo, resto en grafito oscuro.
*/
const everyPlan = [
  "Press kit and demo reel",
  "CRM access",
  "Follow up after every event",
  "LinkedIn profile optimization",
  "Network growth on LinkedIn",
  "Monthly report",
];

const teaserCopy: Record<
  (typeof pricingTiers)[number]["id"],
  { summary: string; state: string; adds: string; cta: string; footerNote: string }
> = {
  founder: {
    summary: "Everything in Foundation at a special Founder rate until we book your first paid speaking event.",
    state: "3-month minimum · moves to Foundation after 1st paid stage",
    adds: "Founder pricing until your first paid event is booked",
    cta: "See Founder rate & plan",
    footerNote: "Foundation services, Founder rate",
  },
  growth: {
    summary: "More pitches, plus content and edited clips that keep your name visible.",
    state: "No minimum commitment",
    adds: "Video editing of your talks included",
    cta: "Explore Growth plan",
    footerNote: "No minimum commitment",
  },
  complete: {
    summary: "Full outreach in your name and the most stages we can go after.",
    state: "No minimum commitment",
    adds: "Outreach & strategic comments in your name",
    cta: "Explore Complete plan",
    footerNote: "No minimum commitment",
  },
};

const words = (s: string) => s.split(" ");
const maskClass =
  "inline-block overflow-clip align-top pt-[0.08em] pb-[0.16em] px-[0.05em] -mt-[0.08em] -mb-[0.16em] -mx-[0.05em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";
---

<!-- La sección clara del formato Backstage -->
<section id="plans" class="overflow-hidden bg-paper py-24 text-ink sm:py-32" aria-labelledby="plans-title" data-plans>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-x-8">
      <div class="lg:col-span-5">
        <h2
          id="plans-title"
          class="text-[clamp(1.875rem,1.45rem+1.8vw,3rem)] font-extrabold leading-[1.08] tracking-[-0.02em] text-balance"
          data-plans-title
        >
          {words("Three plans for keynote speakers").map((w, j, a) => (
            <>
              <span class={maskClass}><span class={wordClass} data-plans-title-word>{w}</span></span>
              {j < a.length - 1 && " "}
            </>
          ))}
        </h2>
        <p
          class="mt-5 max-w-[32rem] text-[clamp(1.0625rem,1rem+0.3vw,1.1875rem)] leading-normal text-pretty text-ink/80"
          data-plans-lead
        >
          Each plan pairs speaker booking with LinkedIn. No commission on your fees.
        </p>

        <h3 class="mt-9 text-sm font-bold text-muted" data-plans-label>In every plan</h3>
        <ul class="mt-4 grid gap-x-6 gap-y-3 sm:grid-cols-2" data-plans-every>
          {
            everyPlan.map((item) => (
              <li class="flex items-start gap-2.5 text-base leading-normal text-ink/85" data-plans-every-item>
                <LucideCheck class="mt-1 size-4 shrink-0 text-stage" stroke-width={2.25} aria-hidden="true" />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <div class="mt-10" data-plans-cta>
          <Button href="/pricing" arrow>Compare plans</Button>
        </div>
      </div>

      <div
        class="aspect-video overflow-hidden rounded-[20px] bg-ink ring-1 ring-ink/10 lg:col-span-7"
        data-visual
        data-plans-visual
      >
        <Image
          src={report}
          alt="A Brux monthly report: keynotes booked, LinkedIn followers and post impressions, with a follower growth chart"
          widths={[640, 960, 1440]}
          sizes="(min-width: 1280px) 690px, (min-width: 1024px) 56vw, 92vw"
          class="size-full object-cover will-change-transform"
          loading="lazy"
          data-plans-img
        />
      </div>
    </div>

    <!-- Las tres tarjetas (sin precios en portada): Founder más ancha y en rojo; resto en grafito oscuro -->
    <ul
      class="mt-14 grid gap-5 md:grid-cols-2 lg:mt-20 lg:grid-cols-[1.35fr_1fr_1fr] lg:items-stretch"
      data-plans-grid
    >
      {
        pricingTiers.map((t) => {
          const copy = teaserCopy[t.id];
          return (
            <li
              class:list={[
                "relative isolate flex",
                "before:pointer-events-none before:absolute before:inset-0 before:-z-10 before:rounded-[23px] before:transition-colors before:duration-300 before:ease-out before:content-['']",
                t.featured
                  ? "before:translate-y-2 before:bg-stage-text/30 has-[[data-plan]:hover]:before:bg-stage-text/40 has-[[data-plan]:focus-within]:before:bg-stage-text/40"
                  : "before:bg-ink/12 has-[[data-plan]:hover]:before:bg-ink/20 has-[[data-plan]:focus-within]:before:bg-ink/20",
              ]}
              data-plans-item
            >
              <article
                class:list={[
                  "group/plan relative flex flex-1 flex-col overflow-hidden rounded-[23px] border p-6 text-paper transition-shadow duration-300 ease-out will-change-transform sm:p-7",
                  t.featured
                    ? "border-paper/25 bg-[linear-gradient(155deg,#E50C13_0%,#C20A18_48%,#7E0611_100%)] shadow-[0_28px_68px_-18px_rgba(194,10,24,0.52),inset_0_1px_0_rgba(255,255,255,0.22)]"
                    : "border-[#333338] bg-[linear-gradient(155deg,#161618,#080809_52%)] shadow-[0_24px_64px_-20px_rgba(0,0,0,0.45),inset_0_1px_0_rgba(255,255,255,0.05)]",
                ]}
                data-plan
                data-plan-id={t.id}
                data-plan-featured={t.featured ? "true" : undefined}
              >
                <!-- Ambient glow -->
                <span
                  aria-hidden="true"
                  class:list={[
                    "pointer-events-none absolute -left-20 rounded-full",
                    t.featured
                      ? "top-6 h-64 w-80 bg-[radial-gradient(ellipse,rgba(255,255,255,0.22)_0%,transparent_68%)]"
                      : "top-10 h-56 w-72 bg-[radial-gradient(ellipse,rgba(220,23,56,0.14)_0%,transparent_68%)]",
                  ]}
                />

                <!-- 1. Nombre y badge -->
                <div class="relative flex flex-wrap items-center justify-between gap-2.5" data-plan-top>
                  <h3
                    class:list={[
                      "font-extrabold leading-[1.1] tracking-[-0.04em] text-paper",
                      t.featured ? "text-[1.75rem]" : "text-[1.45rem]",
                    ]}
                    data-plan-name
                  >
                    {t.name}
                  </h3>
                  <span
                    class:list={[
                      "inline-flex shrink-0 items-center gap-1.5 rounded-full px-3 py-1 text-[0.75rem] font-bold tracking-[0.01em] whitespace-nowrap",
                      t.featured
                        ? "bg-paper text-stage-text shadow-xs"
                        : "bg-[#2b2b2f] text-[#e6e6e6]",
                    ]}
                    data-plan-badge
                  >
                    {t.featured && <span class="size-1.5 rounded-full bg-stage" aria-hidden="true" />}
                    {t.badge}
                  </span>
                </div>

                <!-- 2. Descripción y condición (sin precios, altura uniforme en desktop para alinear las 3 tarjetas) -->
                <div class="relative mt-5 flex flex-col justify-between lg:min-h-[6.25rem]">
                  <p
                    class:list={[
                      "text-[0.9375rem] leading-[1.55]",
                      t.featured ? "text-paper/95" : "text-[#e5e5e8]",
                    ]}
                    data-plan-for
                  >
                    {copy.summary}
                  </p>
                  <div
                    class:list={[
                      "mt-3.5 flex items-center gap-2 text-xs font-medium",
                      t.featured ? "text-paper/90" : "text-[#bfc0c5]",
                    ]}
                  >
                    <span
                      class:list={[
                        "size-1.5 shrink-0 rounded-full",
                        t.featured
                          ? "bg-paper shadow-[0_0_0_3px_rgba(255,255,255,0.28)]"
                          : "bg-[#c21b37] shadow-[0_0_0_3px_rgba(194,27,55,0.22)]",
                      ]}
                      aria-hidden="true"
                    />
                    <span>{copy.state}</span>
                  </div>
                </div>

                <!-- 3. Capacidad mensual -->
                <div
                  class:list={[
                    "relative mt-6 grid gap-2.5 border-t pt-5",
                    t.featured ? "border-paper/25" : "border-[#323236]",
                  ]}
                  data-plan-facts
                >
                  <span
                    class:list={[
                      "pointer-events-none absolute inset-x-0 -top-px h-px origin-left [transform:scaleX(0)]",
                      t.featured ? "bg-paper" : "bg-stage-glow",
                    ]}
                    aria-hidden="true"
                    data-plan-line
                  />

                  <div class="flex items-baseline gap-3" data-plan-fact>
                    <span
                      class="min-w-[4.25rem] origin-left text-[1.875rem] font-extrabold leading-none tracking-[-0.03em] text-paper tabular-nums will-change-transform"
                      data-plan-num
                    >
                      {t.pitches}
                    </span>
                    <span class:list={["text-sm leading-snug", t.featured ? "text-paper/90" : "text-[#b3b3b9]"]}>
                      organizer pitches / mo
                    </span>
                  </div>

                  <div class="flex items-baseline gap-3" data-plan-fact>
                    <span
                      class="min-w-[4.25rem] origin-left text-[1.875rem] font-extrabold leading-none tracking-[-0.03em] text-paper tabular-nums will-change-transform"
                      data-plan-num
                    >
                      {t.posts}
                    </span>
                    <span class:list={["text-sm leading-snug", t.featured ? "text-paper/90" : "text-[#b3b3b9]"]}>
                      LinkedIn posts / mo
                    </span>
                  </div>
                </div>

                <!-- 4. Qué incluye cada plan (alineado a la misma altura en las 3 tarjetas) -->
                <div
                  class:list={[
                    "relative mt-6 border-t pt-5",
                    t.featured ? "border-paper/20" : "border-[#2a2a2f]",
                  ]}
                >
                  <p
                    class:list={[
                      "text-xs font-bold tracking-[0.01em]",
                      t.featured ? "text-paper" : "text-paper/90",
                    ]}
                  >
                    {t.highlightsHeading}
                  </p>
                  <ul class="mt-3.5 space-y-2.5 text-[0.875rem] leading-snug">
                    {t.highlights.map((item) => (
                      <li
                        class:list={[
                          "flex items-start gap-2.5",
                          t.featured
                            ? "text-paper/95"
                            : item.featured
                              ? "font-semibold text-paper"
                              : "text-[#d4d4d8]",
                        ]}
                      >
                        <span
                          class:list={[
                            "mt-0.5 grid size-4 shrink-0 place-items-center rounded-full",
                            t.featured
                              ? "bg-paper/18 text-paper"
                              : item.featured
                                ? "bg-[#ed2443]/20 text-[#ff5a6e]"
                                : "bg-paper/8 text-[#a1a1aa]",
                          ]}
                          aria-hidden="true"
                        >
                          <LucideCheck class="size-2.5" stroke-width={3} />
                        </span>
                        <span>{item.label}</span>
                      </li>
                    ))}
                  </ul>
                </div>

                <!-- 5. CTA + pie sutil -->
                <div class="relative mt-auto flex flex-col gap-3 pt-7" data-plan-more>
                  <a
                    href={`/pricing#${t.id}`}
                    class:list={[
                      "group/cta flex min-h-12 w-full items-center justify-center gap-2 rounded-[10px] px-4 text-[0.9375rem] font-bold transition-all duration-200 ease-out focus-visible:outline-2 focus-visible:outline-offset-2",
                      t.featured
                        ? "bg-paper text-ink shadow-[0_10px_24px_-10px_rgba(0,0,0,0.45)] hover:bg-mist focus-visible:outline-paper"
                        : "border border-paper/20 bg-paper/[0.08] text-paper shadow-[inset_0_1px_0_rgba(255,255,255,0.12)] hover:border-paper hover:bg-paper hover:text-ink focus-visible:outline-stage-glow",
                    ]}
                    data-plan-cta
                  >
                    <span>{copy.cta}</span>
                    <span class="inline-flex shrink-0 will-change-transform" data-plan-arrow-wrap>
                      <MorphIcon
                        icon={ArrowRight}
                        size={16}
                        strokeWidth={2.2}
                        spring="snappy"
                        reducedMotion="user"
                        data-plan-arrow
                      />
                    </span>
                  </a>
                  {copy.footerNote && (
                    <p
                      class:list={[
                        "text-center text-xs font-medium",
                        t.featured ? "text-paper/80" : "text-[#8f9098]",
                      ]}
                    >
                      {copy.footerNote}
                    </p>
                  )}
                </div>
              </article>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { ArrowRight, ArrowUpRight, type IconNode } from "lucide";
  import { deferSectionInit } from "../../lib/defer-section";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  const EASE_ENTER = "expo.out";

  let mm: gsap.MatchMedia | null = null;
  let cleanupInteractions: (() => void) | null = null;
  let cancelDefer: (() => void) | null = null;

  function initPlans() {
    const root = document.querySelector<HTMLElement>("[data-plans]");
    if (!root) return;

    const grid = root.querySelector<HTMLElement>("[data-plans-grid]");
    const cards = grid ? [...grid.querySelectorAll<HTMLElement>("[data-plan]")] : [];

    // ---------- 1. Animaciones de entrada con ScrollTrigger ----------
    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const titleWords = root.querySelectorAll<HTMLElement>("[data-plans-title-word]");
        const lead = root.querySelector<HTMLElement>("[data-plans-lead]");
        const label = root.querySelector<HTMLElement>("[data-plans-label]");
        const everyItems = root.querySelectorAll<HTMLElement>("[data-plans-every-item]");
        const cta = root.querySelector<HTMLElement>("[data-plans-cta]");
        const visual = root.querySelector<HTMLElement>("[data-plans-visual]");
        const img = root.querySelector<HTMLElement>("[data-plans-img]");

        const tl = gsap.timeline({
          scrollTrigger: { trigger: root, start: "top 78%", once: true },
          defaults: { ease: EASE_ENTER },
        });

        if (titleWords.length) {
          tl.fromTo(
            titleWords,
            { yPercent: 115, rotate: 6 },
            {
              yPercent: 0,
              rotate: 0,
              duration: 1.05,
              stagger: 0.055,
            },
          );
        }

        if (lead) tl.from(lead, { y: 16, autoAlpha: 0, duration: 0.8 }, 0.22);
        if (label) tl.from(label, { y: 12, autoAlpha: 0, duration: 0.65 }, 0.34);
        if (everyItems.length) {
          tl.from(
            everyItems,
            { x: -14, autoAlpha: 0, duration: 0.7, stagger: 0.04 },
            0.4,
          );
        }
        if (cta) tl.from(cta, { y: 14, autoAlpha: 0, duration: 0.7 }, 0.58);

        if (visual) {
          tl.fromTo(
            visual,
            { clipPath: "inset(0% 100% 0% 0%)" },
            {
              clipPath: "inset(0% 0% 0% 0%)",
              duration: 1.1,
              ease: "power4.inOut",
              clearProps: "clipPath",
            },
            0.18,
          );
        }
        if (img) {
          tl.from(img, { scale: 1.12, duration: 1.4, ease: EASE_ENTER, clearProps: "scale" }, 0.18);
        }

        if (grid && cards.length) {
          const items = root.querySelectorAll<HTMLElement>("[data-plans-item]");
          const cardsTl = gsap.timeline({
            scrollTrigger: { trigger: grid, start: "top 82%", once: true },
            defaults: { ease: EASE_ENTER },
          });

          cardsTl.from(items, {
            y: 44,
            autoAlpha: 0,
            duration: 0.85,
            stagger: 0.06,
            clearProps: "transform,opacity,visibility",
          });

          cards.forEach((card, i) => {
            const at = 0.15 + i * 0.06;
            const nums = card.querySelectorAll("[data-plan-num]");
            const more = card.querySelector("[data-plan-more]");

            if (nums.length) {
              cardsTl.from(
                nums,
                { yPercent: 30, autoAlpha: 0, duration: 0.7, stagger: 0.05 },
                at + 0.12,
              );
            }
            if (more) cardsTl.from(more, { y: 8, autoAlpha: 0, duration: 0.6 }, at + 0.22);
          });
        }

        if (visual && img) {
          const zoomImg = gsap.quickTo(img, "scale", { duration: 0.6, ease: "power3.out" });
          visual.addEventListener("pointerenter", () => zoomImg(1.025));
          visual.addEventListener("pointerleave", () => zoomImg(1));
        }
      }, root);

      return () => ctx.revert();
    });

    if (!grid) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    // ---------- 2. Hover por tarjeta y CTA ----------
    for (const card of cards) {
      const line = card.querySelector<HTMLElement>("[data-plan-line]");
      const nums = card.querySelectorAll<HTMLElement>("[data-plan-num]");
      const name = card.querySelector<HTMLElement>("[data-plan-name]");

      const liftY = gsap.quickTo(card, "y", { duration: 0.36, ease: "power3.out" });

      const onActivate = () => {
        if (reduce.matches) return;

        liftY(-5);
        if (line) {
          gsap.set(line, { transformOrigin: "0% 50%" });
          gsap.to(line, { scaleX: 1, duration: 0.45, ease: "expo.out", overwrite: "auto" });
        }
        if (name) gsap.to(name, { x: 2, duration: 0.35, ease: "expo.out", overwrite: "auto" });
        if (nums.length) {
          gsap.to(nums, {
            x: 3,
            scale: 1.04,
            duration: 0.4,
            stagger: 0.035,
            ease: "expo.out",
            overwrite: "auto",
          });
        }
      };

      const onDeactivate = () => {
        if (reduce.matches) return;

        liftY(0);
        if (line) {
          gsap.set(line, { transformOrigin: "100% 50%" });
          gsap.to(line, { scaleX: 0, duration: 0.24, ease: "power2.inOut", overwrite: "auto" });
        }
        if (name) gsap.to(name, { x: 0, duration: 0.22, ease: "power2.out", overwrite: "auto" });
        if (nums.length) {
          gsap.to(nums, { x: 0, scale: 1, duration: 0.24, ease: "power2.out", overwrite: "auto" });
        }
      };

      card.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onActivate(), { signal });
      card.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onDeactivate(), { signal });
      card.addEventListener("focusin", onActivate, { signal });
      card.addEventListener(
        "focusout",
        (e) => {
          if (!card.contains(e.relatedTarget as Node | null)) onDeactivate();
        },
        { signal },
      );
    }

    root.querySelectorAll<HTMLAnchorElement>("[data-plan-cta]").forEach((cta) => {
      const arrowWrap = cta.querySelector<HTMLElement>("[data-plan-arrow-wrap]");
      const arrowIcon = cta.querySelector<MorphEl>("[data-plan-arrow]");
      const nudge = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.22, ease: "power3.out" }) : null;

      const onEnter = () => {
        arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) nudge?.(3);
      };
      const onLeave = () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) nudge?.(0);
      };

      cta.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      cta.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      cta.addEventListener("focus", onEnter, { signal });
      cta.addEventListener("blur", onLeave, { signal });
    });

    cleanupInteractions = () => {
      controller.abort();
    };
  }

  document.addEventListener("astro:page-load", () => {
    cancelDefer?.();
    cancelDefer = deferSectionInit("[data-plans]", initPlans);
  });
  document.addEventListener("astro:before-swap", () => {
    cancelDefer?.();
    cancelDefer = null;
    mm?.revert();
    mm = null;
    cleanupInteractions?.();
    cleanupInteractions = null;
  });
</script>
