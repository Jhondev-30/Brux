---
import { Plus } from "lucide";
import MorphIcon from "morphicons/astro";

// Respuestas sacadas del PDF de planes del 1 de noviembre de 2026.
// Las mismas preguntas van en JSON-LD (FAQPage): Google ya no las muestra como resultado
// enriquecido, pero ChatGPT, Perplexity y otros buscadores con IA sí las leen.
const faqs = [
  {
    q: "Do you take a commission on my speaking fees?",
    a: "No. Your fee is yours. We take no commission on the paid events we book for you; you only pay your monthly plan.",
  },
  {
    q: "Is there a minimum commitment?",
    a: "Foundation, Growth and Complete have no minimum commitment. The Founder plan is paid month to month with a 3 month minimum.",
  },
  {
    q: "How many event organizers do you pitch each month?",
    a: "60 on the Founder and Foundation plans, 110 on Growth and 160 or more on Complete.",
  },
  {
    q: "Which events will you pitch me to?",
    a: "Only events in your niche. Every pitch goes to organizers of events that fit your topics, never to generic listings.",
  },
  {
    q: "Can I see who you contact on my behalf?",
    a: "Yes. Every plan includes access to our CRM, where you see every organizer we contact, plus follow up after every event, your calendar and a monthly report.",
  },
  {
    q: "Why do you work on my LinkedIn as well as booking?",
    a: "Before organizers book you, they check your LinkedIn, and what they find shapes their decision. We pitch you to the right events and make sure your profile backs up every pitch.",
  },
  {
    q: "How does the Founder rate work?",
    a: "The Founder plan costs $500 a month and includes everything in Foundation. It keeps that rate until we book your first paid stage, then moves to Foundation at $1,200 a month.",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const words = (s: string) => s.split(" ");
const maskClass =
  "inline-block overflow-clip align-top pt-[0.08em] pb-[0.16em] px-[0.05em] -mt-[0.08em] -mb-[0.16em] -mx-[0.05em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";
---

<section id="faq" class="bg-ink py-28 sm:py-36" aria-labelledby="faq-title" data-faq>
  <div class="mx-auto grid max-w-7xl gap-12 px-4 sm:px-8 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-20 lg:px-12">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2
        id="faq-title"
        class="text-[clamp(1.875rem,1.45rem+1.8vw,3rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-balance text-paper"
        data-faq-title
      >
        {words("Questions speakers ask us").map((w, j, a) => (
          <>
            <span class={maskClass}><span class={wordClass} data-faq-title-word>{w}</span></span>
            {j < a.length - 1 && " "}
          </>
        ))}
      </h2>
      <p class="mt-6 max-w-[30rem] leading-relaxed text-muted-on-ink" data-faq-lead>
        Something else on your mind? Ask us on the call.
      </p>
    </div>

    <div class="relative">
      <span class="absolute inset-x-0 top-0 h-px origin-left bg-paper/10" aria-hidden="true" data-faq-line></span>
      {faqs.map((f) => (
        <details class="group relative" data-faq-item>
          <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 py-6 text-lg font-semibold text-paper transition-colors hover:text-stage-glow focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-stage [&::-webkit-details-marker]:hidden">
            <span class="absolute inset-x-0 bottom-0 h-px origin-left bg-paper/10" aria-hidden="true" data-faq-line></span>
            <h3 class="text-pretty">{f.q}</h3>
            <span
              aria-hidden="true"
              class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-full text-paper/70 ring-1 ring-paper/15 transition-[background-color,color,box-shadow] duration-200 group-open:bg-stage group-open:text-paper group-open:ring-stage group-hover:ring-paper/40"
            >
              <MorphIcon
                icon={Plus}
                size={16}
                strokeWidth={2}
                spring="snappy"
                reducedMotion="user"
                data-faq-icon
              />
            </span>
          </summary>
          <div class="overflow-hidden" data-faq-answer>
            <p class="max-w-[40rem] pb-7 leading-relaxed text-muted-on-ink">{f.a}</p>
          </div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { Minus, Plus, type IconNode } from "lucide";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  /*
    Variación respecto a las otras secciones:
    - Título por líneas que entran con un leve sesgo (skew) que se endereza.
    - Las líneas divisorias se dibujan de izquierda a derecha y cada pregunta entra desde la izquierda, en cascada.
    - Abrir y cerrar: el icono Plus se transforma en Minus con MorphIcon, la respuesta se despliega con altura animada
      (sin salto) y su texto sube un poco; cerrar es ~30% más rápido que abrir (criterio Bang Motion).
    Con «reducir movimiento», todo quieto y las preguntas se abren al instante.
  */
  let mm: gsap.MatchMedia | null = null;
  let cleanupToggle: (() => void) | null = null;

  function initFaq() {
    const root = document.querySelector<HTMLElement>("[data-faq]");
    if (!root) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    root.querySelectorAll<HTMLDetailsElement>("[data-faq-item]").forEach((item) => {
      const summary = item.querySelector("summary")!;
      const answer = item.querySelector<HTMLElement>("[data-faq-answer]")!;
      const text = answer.firstElementChild as HTMLElement;
      const icon = item.querySelector<MorphEl>("[data-faq-icon]");

      summary.addEventListener(
        "click",
        (e) => {
          if (reduce.matches) {
            requestAnimationFrame(() => icon?.morphTo?.(item.open ? Minus : Plus));
            return;
          }
          e.preventDefault();
          gsap.killTweensOf([answer, text]);
          if (!item.open) {
            item.open = true;
            icon?.morphTo?.(Minus);
            gsap.fromTo(
              answer,
              { height: 0 },
              { height: "auto", duration: 0.52, ease: "expo.out", clearProps: "height" },
            );
            gsap.fromTo(
              text,
              { y: 12, autoAlpha: 0 },
              { y: 0, autoAlpha: 1, duration: 0.48, delay: 0.06, ease: "power2.out" },
            );
          } else {
            icon?.morphTo?.(Plus);
            gsap.to(text, { autoAlpha: 0, y: 6, duration: 0.18, ease: "power2.in" });
            gsap.to(answer, {
              height: 0,
              duration: 0.34,
              ease: "power3.inOut",
              onComplete: () => {
                item.open = false;
                gsap.set([answer, text], { clearProps: "all" });
              },
            });
          }
        },
        { signal },
      );
    });
    cleanupToggle = () => controller.abort();

    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const titleWords = root.querySelectorAll<HTMLElement>("[data-faq-title-word]");
        const tl = gsap.timeline({ scrollTrigger: { trigger: root, start: "top 75%", once: true } });
        if (titleWords.length) {
          tl.fromTo(
            titleWords,
            { yPercent: 115, rotate: 6 },
            { yPercent: 0, rotate: 0, duration: 1.05, ease: "expo.out", stagger: 0.06 },
          );
        }
        tl.from(root.querySelector("[data-faq-lead]"), { y: 16, autoAlpha: 0, duration: 0.8, ease: "expo.out" }, 0.3)
          .from(root.querySelectorAll("[data-faq-line]"), { scaleX: 0, duration: 1.1, ease: "power3.inOut", stagger: 0.06 }, 0.15)
          .from(
            root.querySelectorAll("[data-faq-item] summary"),
            { x: -28, autoAlpha: 0, duration: 0.8, ease: "expo.out", stagger: 0.06 },
            0.3,
          );
      }, root);
      return () => ctx.revert();
    });
  }

  document.addEventListener("astro:page-load", initFaq);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanupToggle?.();
    cleanupToggle = null;
  });
</script>
