---
import { ArrowRight } from "lucide";
import MorphIcon from "morphicons/astro";
import { bookingUrl } from "../../data/site";

const words = (s: string) => s.split(" ");
const maskClass =
  "inline-block overflow-clip align-top pt-[0.06em] pb-[0.14em] px-[0.05em] -mt-[0.06em] -mb-[0.14em] -mx-[0.05em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";
---

<!--
  Cierre de la portada, centrado, sobre rojo plano.
-->
<section id="book" class="bg-stage py-28 sm:py-40" aria-labelledby="book-title" data-cta>
  <div class="mx-auto flex max-w-7xl flex-col items-center px-4 text-center sm:px-8 lg:px-12">
    <h2
      id="book-title"
      class="max-w-[44rem] text-[clamp(2.5rem,1.7rem+3.4vw,4.75rem)] leading-[1.02] font-extrabold tracking-[-0.02em] text-balance text-paper"
      data-cta-title
    >
      {words("Ready for your next stage?").map((w, j, a) => (
        <>
          <span class={maskClass}><span class={wordClass} data-cta-word>{w}</span></span>
          {j < a.length - 1 && " "}
        </>
      ))}
    </h2>
    <p
      class="mt-7 max-w-[34rem] text-[clamp(1.125rem,1.05rem+0.3vw,1.25rem)] leading-normal text-paper"
      data-cta-lead
    >
      Tell us your topic and your recent talks, and we'll recommend the plan that fits.
    </p>
    <!-- Sobre rojo, el botón principal pasa a negro para que se vea -->
    <a
      href={bookingUrl}
      target="_blank"
      rel="noopener"
      class="mt-10 inline-flex min-h-14 items-center justify-center gap-2.5 rounded-[3px] bg-ink px-8 text-base font-semibold text-paper transition-colors duration-200 will-change-transform hover:bg-ink-raised focus-visible:outline-2 focus-visible:outline-offset-3 focus-visible:outline-paper"
      data-cta-btn
    >
      <span>Book a call</span>
      <span class="inline-flex shrink-0 will-change-transform" data-cta-arrow-wrap>
        <MorphIcon
          icon={ArrowRight}
          size={18}
          strokeWidth={2}
          spring="snappy"
          reducedMotion="user"
          data-cta-icon
        />
      </span>
    </a>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { ArrowRight, ArrowUpRight, type IconNode } from "lucide";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  /*
    Variación respecto a las otras secciones:
    - Título letra a letra, desde el centro hacia fuera, con un pequeño giro 3D que se endereza.
    - Texto y botón suben detrás; el botón «respira» una vez para pedir el clic.
    - Ratón: el botón sigue un poco al cursor (efecto imán, máx. 6 px), transforma la flecha con MorphIcon y se hunde al pulsar.
  */
  let mm: gsap.MatchMedia | null = null;
  let cleanupBtn: (() => void) | null = null;

  function initCta() {
    const root = document.querySelector<HTMLElement>("[data-cta]");
    if (!root) return;

    const btn = root.querySelector<HTMLElement>("[data-cta-btn]")!;
    const arrowWrap = btn.querySelector<HTMLElement>("[data-cta-arrow-wrap]");
    const arrowIcon = btn.querySelector<MorphEl>("[data-cta-icon]");
    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    const bx = gsap.quickTo(btn, "x", { duration: 0.5, ease: "power3.out" });
    const by = gsap.quickTo(btn, "y", { duration: 0.5, ease: "power3.out" });
    const nudgeX = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.24, ease: "power3.out" }) : null;

    btn.addEventListener(
      "pointerenter",
      (e) => {
        if (e.pointerType === "mouse") {
          arrowIcon?.morphTo?.(ArrowUpRight);
          if (!reduce.matches) nudgeX?.(3);
        }
      },
      { signal },
    );
    btn.addEventListener(
      "pointermove",
      (e) => {
        if (reduce.matches || e.pointerType !== "mouse") return;
        const r = btn.getBoundingClientRect();
        bx(((e.clientX - r.left) / r.width - 0.5) * 12);
        by(((e.clientY - r.top) / r.height - 0.5) * 12);
      },
      { signal },
    );
    btn.addEventListener(
      "pointerleave",
      () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) {
          bx(0);
          by(0);
          nudgeX?.(0);
          gsap.to(btn, { scale: 1, duration: 0.4, ease: "back.out(3)" });
        }
      },
      { signal },
    );
    btn.addEventListener(
      "focus",
      () => {
        arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) nudgeX?.(3);
      },
      { signal },
    );
    btn.addEventListener(
      "blur",
      () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) nudgeX?.(0);
      },
      { signal },
    );
    btn.addEventListener(
      "pointerdown",
      () => {
        if (!reduce.matches) gsap.to(btn, { scale: 0.95, duration: 0.12, ease: "power2.out" });
      },
      { signal },
    );
    btn.addEventListener(
      "pointerup",
      () => {
        if (!reduce.matches) gsap.to(btn, { scale: 1, duration: 0.5, ease: "back.out(3)" });
      },
      { signal },
    );
    cleanupBtn = () => controller.abort();

    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const titleWords = root.querySelectorAll<HTMLElement>("[data-cta-word]");
        const lead = root.querySelector<HTMLElement>("[data-cta-lead]")!;

        const tl = gsap.timeline({
          scrollTrigger: { trigger: root, start: "top 70%", once: true },
          defaults: { ease: "expo.out" },
        });
        if (titleWords.length) {
          tl.fromTo(
            titleWords,
            { yPercent: 115, rotate: 6 },
            {
              yPercent: 0,
              rotate: 0,
              duration: 1.05,
              stagger: 0.065,
            },
            0.05,
          );
        }
        tl.from(lead, { y: 24, autoAlpha: 0, duration: 0.9 }, 0.35)
          .from(btn, { y: 24, scale: 0.88, autoAlpha: 0, duration: 0.9, ease: "back.out(1.8)" }, 0.52)
          .to(btn, { scale: 1.04, duration: 0.35, ease: "power2.out", yoyo: true, repeat: 1 }, ">0.18");
      }, root);
      return () => ctx.revert();
    });
  }

  document.addEventListener("astro:page-load", initCta);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanupBtn?.();
    cleanupBtn = null;
  });
</script>
