---
/**
 * «Our work»: trabajo real para clientes, la prueba de lo que prometen las secciones de arriba.
 * Caso 1: speaker reel de Philip Jayhawk Chan (MP4 H.264 720p en public/videos/work/, se carga al darle a play).
 * Caso 2: web de Angie Pichardo, graceafterthegrave.com (captura de la portada, nov 2026).
 * Estilos con Tailwind v4, iconos con MorphIcon + Lucide, y animaciones con GSAP.
 */
import { Image } from "astro:assets";
import { ArrowRight, Globe, Play } from "lucide";
import MorphIcon from "morphicons/astro";
import grace from "../../assets/work/grace-after-the-grave.webp";

const site = "https://www.brux.site";
const words = (s: string) => s.split(" ");
const maskClass =
  "inline-block overflow-clip align-top pt-[0.08em] pb-[0.16em] px-[0.05em] -mt-[0.08em] -mb-[0.16em] -mx-[0.05em]";
const wordClass = "inline-block origin-[0%_100%] will-change-transform";

// VideoObject: ayuda a que el reel aparezca en búsquedas de vídeo
const reelSchema = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: "Philip Jayhawk Chan, keynote speaker reel",
  description:
    "Speaker reel for Philip Jayhawk Chan, CEO and President of Lightspeed Investing and keynote speaker, produced by Brux.",
  thumbnailUrl: `${site}/videos/work/philip-chan-reel-poster.webp`,
  contentUrl: `${site}/videos/work/philip-chan-reel.mp4`,
  uploadDate: "2026-11-10",
  duration: "PT3M0S",
};
---

<section id="work" class="overflow-hidden bg-ink-raised py-28 sm:py-36" aria-labelledby="work-title" data-work>
  <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
    <div class="mx-auto max-w-[40rem] text-center">
      <h2
        id="work-title"
        class="text-[clamp(1.875rem,1.45rem+1.8vw,3rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-balance text-paper"
        data-work-title
      >
        {words("Work we've done for speakers").map((w, j, a) => (
          <>
            <span class={maskClass}><span class={wordClass} data-work-title-word>{w}</span></span>
            {j < a.length - 1 && " "}
          </>
        ))}
      </h2>
      <p class="mt-5 text-[clamp(1.0625rem,1rem+0.25vw,1.1875rem)] leading-relaxed text-muted-on-ink" data-work-lead>
        The reel and the website are what organizers open first. These are two we made for clients.
      </p>
    </div>

    <div class="mt-16 grid gap-10 sm:mt-20 lg:gap-14">
      <!-- Caso 1: speaker reel -->
      <article
        class="grid gap-8 rounded-[1.75rem] bg-ink p-3 shadow-[0_30px_60px_-40px_rgb(0_0_0/0.7)] ring-1 ring-paper/10 will-change-transform sm:p-4 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] lg:items-center lg:gap-12 lg:pr-12"
        data-work-card
        data-work-kind="reel"
      >
        <div class="overflow-hidden rounded-[1.25rem] bg-ink" data-work-media>
          <video
            class="aspect-video w-full object-cover will-change-transform"
            controls
            playsinline
            preload="none"
            poster="/videos/work/philip-chan-reel-poster.webp"
            aria-label="Philip Jayhawk Chan's speaker reel"
            data-work-inner
          >
            <source src="/videos/work/philip-chan-reel.mp4" type="video/mp4" />
          </video>
        </div>
        <div class="px-4 pb-6 sm:px-6 lg:px-0 lg:pb-0">
          <p class="inline-flex items-center gap-2 rounded-full bg-stage/15 px-3.5 py-1.5 text-sm font-semibold text-stage-glow" data-work-tag>
            <MorphIcon icon={Play} size={14} strokeWidth={2.2} spring="snappy" reducedMotion="user" data-work-tag-icon />
            Speaker reel
          </p>
          <h3 class="mt-5 text-[clamp(1.625rem,1.3rem+1.2vw,2.375rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-paper" data-work-heading>
            Philip Jayhawk Chan
          </h3>
          <p class="mt-2 text-[1.0625rem] text-muted-on-ink" data-work-text>CEO &amp; President, Lightspeed Investing. Keynote speaker.</p>
          <p class="mt-6 leading-relaxed text-paper/90" data-work-text>
            Organizers want to see how a speaker sounds on stage before they book. We cut Philip's talks,
            interviews and his story into one three-minute reel, and it goes out with every pitch.
          </p>
        </div>
      </article>

      <!-- Caso 2: web de speaker -->
      <article
        class="grid gap-8 rounded-[1.75rem] bg-ink p-3 shadow-[0_30px_60px_-40px_rgb(0_0_0/0.7)] ring-1 ring-paper/10 will-change-transform sm:p-4 lg:grid-cols-[minmax(0,4fr)_minmax(0,7fr)] lg:items-center lg:gap-12 lg:pl-12"
        data-work-card
        data-work-kind="web"
      >
        <div class="lg:order-last">
          <a
            href="https://graceafterthegrave.com/"
            target="_blank"
            rel="noopener"
            class="block overflow-hidden rounded-[1.25rem] bg-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-stage"
            data-work-media
          >
            <Image
              src={grace}
              alt="Home page of graceafterthegrave.com: Angie Pichardo, Christian speaker and life coach"
              widths={[640, 960, 1440]}
              sizes="(min-width: 1024px) 60vw, 100vw"
              class="w-full will-change-transform"
              data-work-inner
            />
          </a>
        </div>
        <div class="px-4 pb-6 sm:px-6 lg:px-0 lg:pb-0">
          <p class="inline-flex items-center gap-2 rounded-full bg-stage/15 px-3.5 py-1.5 text-sm font-semibold text-stage-glow" data-work-tag>
            <MorphIcon icon={Globe} size={14} strokeWidth={2} spring="snappy" reducedMotion="user" data-work-tag-icon />
            Speaker website
          </p>
          <h3 class="mt-5 text-[clamp(1.625rem,1.3rem+1.2vw,2.375rem)] leading-[1.08] font-extrabold tracking-[-0.02em] text-paper" data-work-heading>
            Angie Pichardo
          </h3>
          <p class="mt-2 text-[1.0625rem] text-muted-on-ink" data-work-text>Christian speaker and life coach. English and Spanish.</p>
          <p class="mt-6 leading-relaxed text-paper/90" data-work-text>
            One link that answers an organizer's questions: her story, her keynote topics, her A.L.I.G.N.
            framework and a discovery call. We also ran her social media and edited her videos while we
            pitched her to events.
          </p>
          <!-- El rojo queda solo para la acción: así se lee como el botón de la tarjeta -->
          <a
            href="https://graceafterthegrave.com/"
            target="_blank"
            rel="noopener"
            class="mt-8 inline-flex min-h-12 items-center gap-2.5 rounded-[3px] bg-stage px-6 font-semibold text-paper transition-colors duration-200 will-change-transform hover:bg-stage-glow focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-paper"
            data-work-btn
          >
            <span>Visit graceafterthegrave.com</span>
            <span class="inline-flex shrink-0 will-change-transform" data-work-btn-arrow-wrap>
              <MorphIcon
                icon={ArrowRight}
                size={16}
                strokeWidth={2}
                spring="snappy"
                reducedMotion="user"
                data-work-btn-icon
              />
            </span>
          </a>
        </div>
      </article>
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(reelSchema)} />
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { SplitText } from "gsap/SplitText";
  import { ArrowRight, ArrowUpRight, Clapperboard, Globe, LayoutTemplate, Play, type IconNode } from "lucide";

  gsap.registerPlugin(ScrollTrigger, SplitText);

  type MorphEl = HTMLElement & { morphTo?: (icon: IconNode | string) => void };

  /*
    Variación respecto a Testimonios (allí todo sube recto):
    - Título: palabras que se enderezan desde una leve inclinación, en abanico desde el centro.
    - Tarjetas: entran inclinadas (izquierda / derecha, alternando) y se asientan; la tarjeta se oscurece
      desde el gris de la sección, como cuando bajan las luces de la sala.
    - El vídeo o la captura se descubre de lado, hacia el texto, con zoom de retroceso.
    - Texto en cascada: etiqueta, nombre y párrafos; el botón entra al final con rebote.
    - Ratón: la tarjeta sube 4 px, la imagen se acerca un 3 %, los iconos se transforman con MorphIcon y el botón se hunde al pulsar.
  */
  const EASE = "expo.out";
  let mm: gsap.MatchMedia | null = null;
  let cleanupInteractions: (() => void) | null = null;

  function initWork() {
    const root = document.querySelector<HTMLElement>("[data-work]");
    if (!root) return;

    const controller = new AbortController();
    const { signal } = controller;
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");

    root.querySelectorAll<HTMLElement>("[data-work-card]").forEach((card) => {
      const kind = card.dataset.workKind;
      const tagIcon = card.querySelector<MorphEl>("[data-work-tag-icon]");
      const media = card.querySelector<HTMLElement>("[data-work-media]")!;
      const inner = card.querySelector<HTMLElement>("[data-work-inner]")!;
      const lift = gsap.quickTo(card, "y", { duration: 0.5, ease: "power3.out" });
      const zoom = gsap.quickTo(inner, "scale", { duration: 0.8, ease: "power3.out" });

      card.addEventListener(
        "pointerenter",
        (e) => {
          if (e.pointerType !== "mouse") return;
          tagIcon?.morphTo?.(kind === "reel" ? Clapperboard : LayoutTemplate);
          if (!reduce.matches) lift(-4);
        },
        { signal },
      );
      card.addEventListener(
        "pointerleave",
        (e) => {
          if (e.pointerType !== "mouse") return;
          tagIcon?.morphTo?.(kind === "reel" ? Play : Globe);
          if (!reduce.matches) lift(0);
        },
        { signal },
      );
      media.addEventListener(
        "pointerenter",
        () => {
          if (!reduce.matches) zoom(1.03);
        },
        { signal },
      );
      media.addEventListener(
        "pointerleave",
        () => {
          if (!reduce.matches) zoom(1);
        },
        { signal },
      );
    });

    root.querySelectorAll<HTMLElement>("[data-work-btn]").forEach((btn) => {
      const arrowWrap = btn.querySelector<HTMLElement>("[data-work-btn-arrow-wrap]");
      const arrowIcon = btn.querySelector<MorphEl>("[data-work-btn-icon]");
      const nudgeX = arrowWrap ? gsap.quickTo(arrowWrap, "x", { duration: 0.24, ease: "power3.out" }) : null;

      const onEnter = () => {
        arrowIcon?.morphTo?.(ArrowUpRight);
        if (!reduce.matches) nudgeX?.(3);
      };
      const onLeave = () => {
        arrowIcon?.morphTo?.(ArrowRight);
        if (!reduce.matches) {
          nudgeX?.(0);
          gsap.to(btn, { scale: 1, duration: 0.5, ease: "back.out(3)" });
        }
      };

      btn.addEventListener("pointerenter", (e) => e.pointerType === "mouse" && onEnter(), { signal });
      btn.addEventListener("pointerleave", (e) => e.pointerType === "mouse" && onLeave(), { signal });
      btn.addEventListener("focus", onEnter, { signal });
      btn.addEventListener("blur", onLeave, { signal });
      btn.addEventListener(
        "pointerdown",
        () => {
          if (!reduce.matches) gsap.to(btn, { scale: 0.95, duration: 0.12, ease: "power2.out" });
        },
        { signal },
      );
      btn.addEventListener(
        "pointerup",
        () => {
          if (!reduce.matches) gsap.to(btn, { scale: 1, duration: 0.5, ease: "back.out(3)" });
        },
        { signal },
      );
    });

    cleanupInteractions = () => controller.abort();

    mm = gsap.matchMedia();
    mm.add("(prefers-reduced-motion: no-preference)", () => {
      const ctx = gsap.context(() => {
        const title = root.querySelector<HTMLElement>("[data-work-title]")!;
        const titleWords = root.querySelectorAll<HTMLElement>("[data-work-title-word]");
        const lead = root.querySelector<HTMLElement>("[data-work-lead]");
        const headTl = gsap.timeline({
          scrollTrigger: { trigger: title, start: "top 85%", once: true },
          defaults: { ease: EASE },
        });
        if (titleWords.length) {
          headTl.fromTo(
            titleWords,
            { yPercent: 115, rotate: 6 },
            {
              yPercent: 0,
              rotate: 0,
              duration: 1.05,
              stagger: 0.06,
            },
          );
        }
        if (lead) headTl.from(lead, { y: 18, autoAlpha: 0, duration: 0.9 }, 0.32);

        root.querySelectorAll<HTMLElement>("[data-work-card]").forEach((card, i) => {
          const dir = i % 2 === 0 ? -1 : 1;
          const media = card.querySelector<HTMLElement>("[data-work-media]")!;
          const inner = card.querySelector<HTMLElement>("[data-work-inner]")!;
          const tl = gsap.timeline({
            scrollTrigger: { trigger: card, start: "top 80%", once: true },
            defaults: { ease: EASE },
          });
          tl.from(card, {
            y: 90,
            rotation: 2.5 * dir,
            scale: 0.94,
            backgroundColor: "#161616",
            duration: 1.3,
            transformOrigin: dir < 0 ? "0% 100%" : "100% 100%",
            clearProps: "backgroundColor,rotation,scale",
          })
            .fromTo(
              media,
              { clipPath: dir < 0 ? "inset(0% 100% 0% 0%)" : "inset(0% 0% 0% 100%)" },
              { clipPath: "inset(0% 0% 0% 0%)", duration: 1.2, ease: "power4.inOut", clearProps: "clipPath" },
              0.25,
            )
            .from(inner, { scale: 1.2, duration: 1.6 }, 0.25)
            .from(card.querySelector("[data-work-tag]"), { scale: 0.6, autoAlpha: 0, duration: 0.7, ease: "back.out(2.2)" }, 0.6)
            .from(card.querySelector("[data-work-heading]"), { x: 30 * -dir, autoAlpha: 0, duration: 0.9 }, 0.7)
            .from(card.querySelectorAll("[data-work-text]"), { y: 18, autoAlpha: 0, duration: 0.8, stagger: 0.1 }, 0.85);
          const btn = card.querySelector<HTMLElement>("[data-work-btn]");
          if (btn) tl.from(btn, { y: 16, scale: 0.9, autoAlpha: 0, duration: 0.7, ease: "back.out(2)" }, 1.1);
        });
      }, root);
      return () => ctx.revert();
    });
  }

  document.addEventListener("astro:page-load", initWork);
  document.addEventListener("astro:before-swap", () => {
    mm?.revert();
    mm = null;
    cleanupInteractions?.();
    cleanupInteractions = null;
  });
</script>
