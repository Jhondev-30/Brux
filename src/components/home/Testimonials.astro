---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";

// Testimonios de src/content/testimonials/. Si todavía no hay ninguno, la sección no se muestra.
const testimonials = (await getCollection("testimonials", ({ data }) => data.published)).sort(
  (a, b) => a.data.order - b.data.order,
);
const total = testimonials.length;
---

{total > 0 && (
  <section
    id="testimonials"
    class="bg-ink py-24 sm:py-32"
    aria-labelledby="testimonials-title"
    aria-roledescription="carousel"
    data-carousel
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-8 lg:px-12">
      <div class="flex items-end justify-between gap-6">
        <h2
          id="testimonials-title"
          class="max-w-[34rem] text-[clamp(1.875rem,1.45rem+1.8vw,3rem)] font-extrabold leading-[1.08] tracking-[-0.02em] text-balance text-paper"
        >
          What speakers say about working with us
        </h2>

        <div class="flex shrink-0 gap-2" data-carousel-controls hidden>
          <button
            type="button"
            class="grid size-12 place-items-center rounded-full text-paper ring-1 ring-paper/30 ring-inset transition-[background-color,box-shadow,opacity] duration-150 hover:bg-paper/10 hover:ring-paper/70 disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent"
            aria-controls="testimonials-track"
            aria-label="Previous testimonial"
            data-carousel-prev
          >
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
              <path d="M12.5 4.5 7 10l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button
            type="button"
            class="grid size-12 place-items-center rounded-full text-paper ring-1 ring-paper/30 ring-inset transition-[background-color,box-shadow,opacity] duration-150 hover:bg-paper/10 hover:ring-paper/70 disabled:cursor-default disabled:opacity-30 disabled:hover:bg-transparent"
            aria-controls="testimonials-track"
            aria-label="Next testimonial"
            data-carousel-next
          >
            <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
              <path d="M7.5 4.5 13 10l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Todos los testimonios están en el HTML: Google los lee aunque no estén a la vista -->
      <ul
        id="testimonials-track"
        class="testimonials-track mt-12 flex snap-x snap-mandatory gap-6 overflow-x-auto pb-2"
        data-carousel-track
      >
        {testimonials.map((t, i) => (
          <li
            class="w-[88%] shrink-0 snap-start sm:w-[70%] lg:w-[calc(50%-0.75rem)]"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${total}`}
            data-carousel-slide
          >
            <figure class="flex h-full flex-col rounded-md bg-ink-raised p-7 sm:p-10">
              {t.data.result && (
                <p class="mb-6 self-start rounded-full px-3 py-1 text-sm font-semibold text-stage-glow ring-1 ring-stage-glow/40 ring-inset">
                  {t.data.result}
                </p>
              )}
              <blockquote class="flex-1 text-[clamp(1.125rem,1.05rem+0.4vw,1.375rem)] leading-normal text-pretty text-paper">
                <p>“{t.data.quote}”</p>
              </blockquote>
              <figcaption class="mt-8 flex items-center gap-4">
                {t.data.photo && (
                  <Image src={t.data.photo} alt="" width={56} height={56} class="size-14 rounded-full object-cover" />
                )}
                <span>
                  {t.data.link ? (
                    <a href={t.data.link} class="font-semibold text-paper underline-offset-4 hover:underline" rel="noopener" target="_blank">
                      {t.data.name}
                    </a>
                  ) : (
                    <span class="font-semibold text-paper">{t.data.name}</span>
                  )}
                  <span class="mt-0.5 block text-sm text-muted-on-ink">{t.data.role}</span>
                </span>
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>

      <p class="sr-only" aria-live="polite" data-carousel-status></p>
    </div>
  </section>
)}

<style>
  /* La pista se desliza con el dedo o con los botones; la barra de scroll no se ve */
  .testimonials-track {
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }
  .testimonials-track::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  let controller: AbortController | null = null;

  function initCarousel() {
    controller?.abort();
    controller = new AbortController();
    const { signal } = controller;

    const root = document.querySelector<HTMLElement>("[data-carousel]");
    if (!root) return;
    const track = root.querySelector<HTMLElement>("[data-carousel-track]")!;
    const slides = [...root.querySelectorAll<HTMLElement>("[data-carousel-slide]")];
    const prev = root.querySelector<HTMLButtonElement>("[data-carousel-prev]")!;
    const next = root.querySelector<HTMLButtonElement>("[data-carousel-next]")!;
    const controls = root.querySelector<HTMLElement>("[data-carousel-controls]")!;
    const status = root.querySelector<HTMLElement>("[data-carousel-status]")!;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Distancia entre el inicio de un testimonio y el siguiente
    const step = () => (slides.length > 1 ? slides[1].offsetLeft - slides[0].offsetLeft : track.clientWidth);
    const index = () => Math.round(track.scrollLeft / step());

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      controls.hidden = max <= 1; // si caben todos, no hacen falta flechas
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= max - 1;
    };

    const go = (dir: 1 | -1) => {
      const target = Math.max(0, Math.min(slides.length - 1, index() + dir));
      track.scrollTo({ left: slides[target].offsetLeft - slides[0].offsetLeft, behavior: reduceMotion.matches ? "auto" : "smooth" });
      status.textContent = `Testimonial ${target + 1} of ${slides.length}`;
    };

    prev.addEventListener("click", () => go(-1), { signal });
    next.addEventListener("click", () => go(1), { signal });
    track.addEventListener("scroll", () => requestAnimationFrame(update), { signal, passive: true });
    window.addEventListener("resize", update, { signal });
    update();
  }

  document.addEventListener("astro:page-load", initCarousel);
</script>
